+/* Porthole (Cycles on Metal), slot 160. Local rendering only: the remote path has no way to carry megabytes of source yet. */
 static NTSTATUS
+_MTLDevice_newLibraryWithSource(void *obj) {
+  struct unixcall_mtldevice_newlibrarysource *params = obj;
+  params->ret_library = 0;
+  params->ret_error = 0;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  if (!params->source || !params->source_len) return STATUS_INVALID_PARAMETER;
+  @autoreleasepool {
+    id<MTLDevice> device = (id<MTLDevice>)params->device;
+    NSString *text = [[NSString alloc] initWithBytes:(const void *)(uintptr_t)params->source length:(NSUInteger)params->source_len encoding:NSUTF8StringEncoding];
+    if (!text) return STATUS_INVALID_PARAMETER;
+    MTLCompileOptions *options = [[MTLCompileOptions alloc] init];
+    options.mathMode = (params->flags & 1u) ? MTLMathModeFast : MTLMathModeSafe;
+    switch (params->language_version) {
+      case 0x0200: options.languageVersion = MTLLanguageVersion2_0; break;
+      case 0x0204: options.languageVersion = MTLLanguageVersion2_4; break;
+      case 0x0300: options.languageVersion = MTLLanguageVersion3_0; break;
+      case 0x0301: options.languageVersion = MTLLanguageVersion3_1; break;
+      default:     options.languageVersion = MTLLanguageVersion3_2; break;
+    }
+    NSError *err = nil;
+    id<MTLLibrary> library = [device newLibraryWithSource:text options:options error:&err];
+    params->ret_library = (obj_handle_t)library;      /* +1, released by the caller (NSObject_release) */
+    if (err) params->ret_error = (obj_handle_t)[err retain];
+    [options release];
+    [text release];
+  }
+  return STATUS_SUCCESS;
+}
