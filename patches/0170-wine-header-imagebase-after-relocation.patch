+/* Porthole 0170 diagnostics: where does the main exe's big .data (BSS plus a little file data) become non-zero as the game unpacks itself?
+ * Every few seconds log the runs of non-zero 4 KB pages (rva, length, first 8 bytes). Only started for the exe named in MADEIRA_FIX_IMAGEBASE. */
+static struct { const unsigned char *base; unsigned int rva, size; } ios_data_watch;
+
+static void *ios_data_watch_thread( void *arg )
+{
+    static const unsigned int delays[] = { 3, 5, 6, 6, 6, 6 };
+    unsigned int round;
+    for (round = 0; round < sizeof(delays) / sizeof(delays[0]); round++)
+    {
+        unsigned int off, runs = 0, run_start = 0, in_run = 0, nz_pages = 0;
+        sleep( delays[round] );
+        for (off = 0; off <= ios_data_watch.size; off += 0x1000)
+        {
+            int nz = 0;
+            if (off < ios_data_watch.size)
+            {
+                const unsigned long long *q = (const unsigned long long *)(ios_data_watch.base + ios_data_watch.rva + off);
+                unsigned int i;
+                for (i = 0; i < 512; i++) if (q[i]) { nz = 1; break; }
+            }
+            if (nz) nz_pages++;
+            if (nz && !in_run) { in_run = 1; run_start = off; }
+            else if (!nz && in_run)
+            {
+                in_run = 0;
+                if (runs < 60)
+                {
+                    const unsigned char *m = ios_data_watch.base + ios_data_watch.rva + run_start;
+                    fprintf( stderr, "[data-watch] round %u: .data+%#x (rva %#x) len %#x first8 %02x%02x%02x%02x%02x%02x%02x%02x\n", round, run_start,
+                             ios_data_watch.rva + run_start, off - run_start, m[0], m[1], m[2], m[3], m[4], m[5], m[6], m[7] );
+                }
+                runs++;
+            }
+        }
+        fprintf( stderr, "[data-watch] round %u: %u non-zero runs, %u non-zero pages of %u\n", round, runs, nz_pages, ios_data_watch.size / 0x1000 );
+    }
+    return NULL;
+}
