diff --git a/src/friends.c b/src/friends.c
new file mode 100644
index 0000000..9c147ba
--- /dev/null
+++ b/src/friends.c
@@ -0,0 +1,481 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 125hz
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md
+ * Friends through Valve's client: list, invite, and join through the client's
+ * own accepted-invite path (NotifyLobbyJoinRequested /
+ * NotifyRichPresenceJoinRequested), which posts the running game's own join
+ * callbacks. Slots and ABI: docs/CLIENT_LAYOUTS.md, "Friends research".
+ */
+#include "friends.h"
+#include <stdio.h>
+#include <string.h>
+
+#define SH_FRIENDS_FEED_MS 3000
+#define SH_FRIEND_FLAG_IMMEDIATE 4
+
+#ifdef _WIN64
+static const wchar_t feed_path[] = L"C:\\madeira-friends.bin";
+static const wchar_t feed_temp[] = L"C:\\madeira-friends.tmp";
+static const wchar_t command_path[] = L"C:\\madeira-friends-cmd.bin";
+static const wchar_t command_taken[] = L"C:\\madeira-friends-cmd.taken";
+/* FriendGameInfo_t, 24 bytes (GetFriendGamePlayed reads exactly 0x18). */
+struct game_info {
+    uint64_t game;
+    uint32_t ip;
+    uint16_t port, query_port;
+    uint64_t lobby;
+};
+_Static_assert(sizeof(struct game_info) == 24, "FriendGameInfo_t");
+
+typedef void *(__thiscall *get_friends_fn)(void *, int32_t, int32_t);
+typedef int32_t (__thiscall *count_fn)(void *, int32_t);
+typedef int32_t (__thiscall *own_state_fn)(void *);
+typedef void *(__thiscall *by_index_fn)(void *, uint64_t *, int32_t, int32_t);
+typedef int32_t (__thiscall *state_fn)(void *, uint64_t);
+typedef const char *(__thiscall *name_fn)(void *, uint64_t);
+typedef bool (__thiscall *game_fn)(void *, uint64_t, struct game_info *);
+typedef const char *(__thiscall *presence_fn)(void *, uint32_t, uint64_t, const char *);
+typedef bool (__thiscall *invite_fn)(void *, uint32_t, uint64_t, const char *);
+typedef bool (__thiscall *join_lobby_fn)(void *, uint32_t, uint64_t, uint64_t);
+typedef bool (__thiscall *join_presence_fn)(void *, uint32_t, uint64_t, const char *);
+typedef void *(__thiscall *get_shared_fn)(void *, int32_t, int32_t);
+typedef uint32_t (__thiscall *allocate_fn)(void *);
+typedef bool (__thiscall *send_fn)(void *, uint32_t, const void *, uint32_t);
+
+#define SLOT(f, n) ((*(void ***)(f)->friends)[n])
+#define SHARED(f, n) ((*(void ***)(f)->shared)[n])
+
+/* The status the app chose (MADEIRA_DOCK_PERSONA_STATE 1 Online, 3 Away,
+ * 7 Invisible), or -1. */
+static int32_t chosen_status(void)
+{
+    wchar_t value[4] = {0};
+    DWORD n = GetEnvironmentVariableW(L"MADEIRA_DOCK_PERSONA_STATE", value, 4);
+    return sh_friend_status_choice(value, n);
+}
+
+static bool disabled(void)
+{
+    wchar_t value[4] = {0};
+    if (GetEnvironmentVariableW(L"MADEIRA_DOCK_FRIENDS", value, 4) == 1 && value[0] == L'0') return true;
+    /* Opt-in: without the app's choice of a status (Offline, the app's default,
+     * or no variable at all) friends stay off entirely: no sign-in to Friends,
+     * no subscription, no list, no commands, nothing sent to Steam. */
+    return chosen_status() < 0;
+}
+
+void sh_friends_init(struct sh_friends *f, HMODULE module, void *engine, int32_t user, int32_t pipe,
+                     uint64_t self, uint32_t appid, const struct dock_client_layout *layout, const struct sh_observer *o)
+{
+    memset(f, 0, sizeof *f);
+    f->o = o;
+    f->appid = appid;
+    f->self = self;
+    f->last_count = f->last_total = f->last_valid = f->last_named = f->last_playing = f->last_online = -1;
+    f->logged_count = f->logged_named = f->logged_playing = f->logged_online = f->logged_requested = -1;
+    f->started_ms = o->now_ms();
+    DeleteFileW(feed_path);
+    DeleteFileW(command_path);
+    DeleteFileW(command_taken);
+    uintptr_t base = (uintptr_t)module;
+    if (disabled() || !layout || !dock_method_is(base, engine, 13, layout->engine_friends)) {
+        o->event("friends-available", 0);
+        return;
+    }
+    void *friends = ((get_friends_fn)(*(void ***)engine)[13])(engine, user, pipe);
+    const struct { unsigned slot; uintptr_t rva; } methods[] = {
+        {7, layout->friend_count}, {10, layout->friend_by_index}, {13, layout->friend_state},
+        {14, layout->friend_name}, {23, layout->friend_game}, {93, layout->friend_presence},
+        {215, layout->friend_invite}, {194, layout->friend_join_lobby}, {195, layout->friend_join_presence},
+        {4, layout->persona_state}, {5, layout->set_persona_state}, {32, layout->request_user_info}};
+    for (unsigned i = 0; i < sizeof methods / sizeof methods[0]; ++i)
+        if (!dock_method_is(base, friends, methods[i].slot, methods[i].rva)) {
+            o->event("friends-available", 0);
+            return;
+        }
+    f->friends = friends;
+    f->layout = layout;
+    o->event("friends-available", 1);
+    /* Desktop Steam's Friends window, not the client, signs in to Friends:
+     * with a web-based UI the client leaves the status change to the window
+     * (SetPersonaStateInternal_t). The window sends ClientChangeStatus and
+     * ClientRequestFriendData itself through the client's shared connection,
+     * so Dock sends the same two messages that way (sh_friends_poll).
+     * MADEIRA_DOCK_FRIENDS_ONLINE=0 sends neither. */
+    int32_t own = ((own_state_fn)SLOT(f, 4))(friends);
+    o->event("friends-own-state", own);
+    wchar_t online[4] = {0};
+    bool keep = GetEnvironmentVariableW(L"MADEIRA_DOCK_FRIENDS_ONLINE", online, 4) == 1 && online[0] == L'0';
+    if (keep || !dock_method_is(base, engine, 69, layout->engine_shared)) {
+        o->event("friends-signin-available", 0);
+        return;
+    }
+    void *shared = ((get_shared_fn)(*(void ***)engine)[69])(engine, user, pipe);
+    if (!shared || !dock_method_is(base, shared, 0, layout->shared_allocate) ||
+        !dock_method_is(base, shared, 2, layout->shared_send)) {
+        o->event("friends-signin-available", 0);
+        return;
+    }
+    f->shared = shared;
+    f->connection = ((allocate_fn)SHARED(f, 0))(shared);
+    o->event("friends-signin-available", f->connection ? 1 : 2);
+    if (!f->connection) { f->shared = NULL; return; }
+    /* The app's choice; disabled() made sure there is one. */
+    f->announce_state = chosen_status();
+    f->announce_pending = true;
+    o->event("friends-persona-chosen", f->announce_state);
+    f->announce_ms = o->now_ms() + 2000;
+}
+
+static uint32_t game_app(const struct game_info *game)
+{
+    /* CGameID: type in the top byte (0 = app), App ID in the low 24 bits. */
+    return (game->game >> 56) == 0 ? (uint32_t)(game->game & 0xffffff) : 0;
+}
+
+/* Copies the friend's rich presence "connect" into out when it is valid. */
+static bool friend_connect(struct sh_friends *f, uint64_t id, char *out)
+{
+    const char *value = ((presence_fn)SLOT(f, 93))(f->friends, f->appid, id, "connect");
+    if (!sh_friend_connect_valid(value)) return false;
+    strcpy(out, value);
+    return true;
+}
+
+/* The lobby this friend invited this player to, or 0. */
+static uint64_t invited_lobby(const struct sh_friends *f, uint64_t from)
+{
+    for (unsigned i = 0; i < f->invite_count; ++i) if (f->invites[i].from == from) return f->invites[i].lobby;
+    return 0;
+}
+
+static void forget_invite(struct sh_friends *f, uint64_t from)
+{
+    for (unsigned i = 0; i < f->invite_count; ++i)
+        if (f->invites[i].from == from) {
+            f->invites[i] = f->invites[--f->invite_count];
+            return;
+        }
+}
+
+static bool friend_known(struct sh_friends *f, uint64_t id)
+{
+    int32_t count = ((count_fn)SLOT(f, 7))(f->friends, SH_FRIEND_FLAG_IMMEDIATE);
+    for (int32_t i = 0; i < count && i < 2000; ++i) {
+        uint64_t other = 0;
+        ((by_index_fn)SLOT(f, 10))(f->friends, &other, i, SH_FRIEND_FLAG_IMMEDIATE);
+        if (other == id) return true;
+    }
+    return false;
+}
+
+static void write_feed(struct sh_friends *f)
+{
+    static struct sh_friend seen[SH_FRIENDS_SCAN];
+    static uint8_t ranks[SH_FRIENDS_SCAN];
+    static uint32_t keep[SH_FRIENDS_MAX];
+    static struct sh_friend list[SH_FRIENDS_MAX];
+    static uint8_t feed[SH_FRIENDS_FEED_CAP];
+    int32_t total = ((count_fn)SLOT(f, 7))(f->friends, SH_FRIEND_FLAG_IMMEDIATE);
+    uint32_t n = 0;
+    int32_t valid = 0, named = 0, playing = 0, online = 0;
+    /* Like desktop Steam, Invite is offered only when this player has something
+     * to join: a lobby of this app, or a rich presence "connect" the game set. */
+    struct game_info mine = {0};
+    char mine_connect[SH_FRIEND_CONNECT_CAP];
+    bool in_lobby = ((game_fn)SLOT(f, 23))(f->friends, f->self, &mine) && mine.lobby && game_app(&mine) == f->appid;
+    in_lobby = in_lobby || friend_connect(f, f->self, mine_connect);
+    /* One pass over the client's list, each call at most once per friend:
+     * SteamID and status for every friend; the game only for a friend who
+     * appears online (one who appears offline, invisible included, shows no
+     * game, as in desktop Steam); "connect" only for one in this game without
+     * a lobby. The counts come from the same calls. Names are asked below, for
+     * the listed friends only. */
+    for (int32_t i = 0; i < total && i < (int32_t)SH_FRIENDS_SCAN; ++i) {
+        uint64_t id = 0;
+        ((by_index_fn)SLOT(f, 10))(f->friends, &id, i, SH_FRIEND_FLAG_IMMEDIATE);
+        if (!sh_friend_steamid_valid(id)) continue;
+        ++valid;
+        int32_t state = ((state_fn)SLOT(f, 13))(f->friends, id);
+        if (state < 0) state = 0;
+        struct sh_friend *entry = &seen[n];
+        memset(entry, 0, sizeof *entry);
+        entry->steamid = id;
+        entry->state = (uint32_t)state;
+        if (invited_lobby(f, id)) entry->flags |= SH_FRIEND_INVITED;
+        if (in_lobby) entry->flags |= SH_FRIEND_CAN_INVITE;
+        struct game_info game = {0};
+        if (state > 0) {
+            ++online;
+            if (((game_fn)SLOT(f, 23))(f->friends, id, &game) && game.game) {
+                ++playing;
+                entry->flags |= SH_FRIEND_IN_GAME;
+                entry->appid = game_app(&game);
+                if (entry->appid && entry->appid == f->appid) {
+                    char connect[SH_FRIEND_CONNECT_CAP];
+                    entry->flags |= SH_FRIEND_SAME_APP;
+                    if (game.lobby || friend_connect(f, id, connect)) entry->flags |= SH_FRIEND_JOINABLE;
+                }
+            }
+        }
+        ranks[n++] = (uint8_t)sh_friend_rank(entry->state, entry->flags);
+    }
+    /* Past the cap, invited, joinable, same-game, in-game and online friends
+     * are kept before offline ones; within each, the client's order. */
+    uint32_t count = sh_friends_pick(ranks, n, keep, SH_FRIENDS_MAX);
+    for (uint32_t k = 0; k < count; ++k) {
+        list[k] = seen[keep[k]];
+        sh_friend_name_copy(list[k].name, sizeof list[k].name, ((name_fn)SLOT(f, 14))(f->friends, list[k].steamid));
+        if (list[k].name[0]) ++named;
+    }
+    /* As the Friends window does: ask for persona data only for friends whose
+     * name has not loaded, at most once a minute. Asking for loaded friends
+     * resets their live status to offline; status comes from the
+     * Chat.RequestFriendPersonaStates subscription (sh_friends_poll). */
+    uint64_t now = f->o->now_ms();
+    if (f->shared && !f->announce_pending && valid && now >= f->next_request_ms) {
+        static uint64_t ids[SH_FRIENDS_MAX];
+        static uint8_t message[8 + 14 + SH_FRIENDS_MAX * 9];
+        uint32_t unnamed = 0;
+        for (uint32_t i = 0; i < count; ++i) if (!list[i].name[0]) ids[unnamed++] = list[i].steamid;
+        f->next_request_ms = now + 60000;
+        if (unnamed) {
+            size_t size = sh_cm_request_friend_data(message, sizeof message, SH_CM_FRIEND_DATA_FLAGS, ids, unnamed);
+            bool sent = size && ((send_fn)SHARED(f, 2))(f->shared, f->connection, message, (uint32_t)size);
+            int32_t requested = sent ? (int32_t)unnamed : -1;
+            if (requested != f->logged_requested) f->o->event("friends-requested", requested);
+            f->logged_requested = requested;
+        }
+    }
+    /* Counts only, to tell an empty list from a failing step. */
+    if (total != f->last_total) f->o->event("friends-total", total);
+    if (valid != f->last_valid) f->o->event("friends-valid-ids", valid);
+    if ((named != f->logged_named || playing != f->logged_playing || online != f->logged_online ||
+         (int32_t)count != f->logged_count) && now >= f->next_counts_ms) {
+        f->o->event("friends-online", online);
+        f->o->event("friends-named", named);
+        f->o->event("friends-playing", playing);
+        f->o->event("friends-seconds", (int32_t)((now - f->started_ms) / 1000));
+        f->logged_named = named;
+        f->logged_playing = playing;
+        f->logged_online = online;
+        f->logged_count = (int32_t)count;
+        f->counts_interval_ms = !f->counts_interval_ms ? 15000
+            : f->counts_interval_ms >= 300000 ? 600000 : f->counts_interval_ms * 2;
+        f->next_counts_ms = now + f->counts_interval_ms;
+    }
+    f->last_total = total;
+    f->last_valid = valid;
+    f->last_named = named;
+    f->last_playing = playing;
+    f->last_online = online;
+    size_t size = sh_friends_feed_encode(feed, sizeof feed, list, count);
+    HANDLE file = size ? CreateFileW(feed_temp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL) : INVALID_HANDLE_VALUE;
+    if (file == INVALID_HANDLE_VALUE) return;
+    DWORD written = 0;
+    bool ok = WriteFile(file, feed, (DWORD)size, &written, NULL) && written == size;
+    CloseHandle(file);
+    if (!ok || !MoveFileExW(feed_temp, feed_path, MOVEFILE_REPLACE_EXISTING)) {
+        DeleteFileW(feed_temp);
+        return;
+    }
+    if ((int32_t)count != f->last_count) f->o->event("friends-count", (int32_t)count);
+    f->last_count = (int32_t)count;
+}
+
+static int32_t run_command(struct sh_friends *f, const struct sh_friend_command *c, bool game_running)
+{
+    if (c->op == SH_FRIEND_SET_STATE) {
+        uint8_t message[64];
+        size_t size = f->shared ? sh_cm_change_status(message, sizeof message, (uint32_t)c->steamid) : 0;
+        bool sent = size && ((send_fn)SHARED(f, 2))(f->shared, f->connection, message, (uint32_t)size);
+        f->o->event("friends-state-set", sent ? (int32_t)c->steamid : -1);
+        if (sent) f->announce_state = (int32_t)c->steamid;   /* re-sent after a reconnect */
+        return sent ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+    }
+    if (!friend_known(f, c->steamid)) return SH_FRIEND_UNKNOWN;
+    if (c->op == SH_FRIEND_INVITE) {
+        if (!game_running) return SH_FRIEND_NOT_JOINABLE;
+        /* The invite carries this player's own join details: in a lobby of this
+         * app, the friends menu's "Invite to lobby" (a lobby invite, which games
+         * accept through their lobby join callback); else the game's rich
+         * presence "connect"; else its lobby as +connect_lobby. With none of
+         * these there is nothing to join and no invite is sent. */
+        char connect[SH_FRIEND_CONNECT_CAP] = "";
+        int32_t kind = 0;
+        struct game_info own = {0};
+        /* What the client knows of this player's own game: 0 nothing, 1 no
+         * game, 2 another app, 3 this app without a lobby, 4 with a lobby. */
+        bool have = ((game_fn)SLOT(f, 23))(f->friends, f->self, &own);
+        f->o->event("friends-own-game", !have ? 0 : !own.game ? 1 : game_app(&own) != f->appid ? 2 : own.lobby ? 4 : 3);
+        bool lobby = have && own.lobby && game_app(&own) == f->appid;
+        if (lobby && f->shared) {
+            uint8_t message[40];
+            size_t size = sh_cm_invite_to_lobby(message, sizeof message, f->appid, own.lobby, c->steamid);
+            f->o->event("friends-invite-connect", 3);
+            return size && ((send_fn)SHARED(f, 2))(f->shared, f->connection, message, (uint32_t)size)
+                ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+        }
+        if (friend_connect(f, f->self, connect)) kind = 1;
+        else if (lobby) {
+            snprintf(connect, sizeof connect, "+connect_lobby %llu", (unsigned long long)own.lobby);
+            kind = 2;
+        }
+        f->o->event("friends-invite-connect", kind);
+        if (!kind) return SH_FRIEND_NOT_JOINABLE;
+        return ((invite_fn)SLOT(f, 215))(f->friends, f->appid, c->steamid, connect) ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+    }
+    /* An invite from this friend names the lobby to join. */
+    uint64_t invited = invited_lobby(f, c->steamid);
+    if (invited) {
+        forget_invite(f, c->steamid);
+        return ((join_lobby_fn)SLOT(f, 194))(f->friends, f->appid, invited, c->steamid)
+            ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+    }
+    struct game_info game = {0};
+    if (((state_fn)SLOT(f, 13))(f->friends, c->steamid) <= 0 ||
+        !((game_fn)SLOT(f, 23))(f->friends, c->steamid, &game) || game_app(&game) != f->appid)
+        return SH_FRIEND_NOT_JOINABLE;
+    if (game.lobby)
+        return ((join_lobby_fn)SLOT(f, 194))(f->friends, f->appid, game.lobby, c->steamid)
+            ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+    char connect[SH_FRIEND_CONNECT_CAP];
+    if (!friend_connect(f, c->steamid, connect)) return SH_FRIEND_NOT_JOINABLE;
+    return ((join_presence_fn)SLOT(f, 195))(f->friends, f->appid, c->steamid, connect)
+        ? SH_FRIEND_DONE : SH_FRIEND_CALL_FAILED;
+}
+
+static void read_command(struct sh_friends *f, bool game_running)
+{
+    /* The command is taken by renaming it first: one the app writes after
+     * this lands at command_path again and is read at the next poll, rather
+     * than deleted unread with this one. Without a command (the usual case)
+     * the rename fails and nothing else happens. */
+    if (!MoveFileExW(command_path, command_taken, MOVEFILE_REPLACE_EXISTING)) return;
+    HANDLE file = CreateFileW(command_taken, GENERIC_READ, 0, NULL, OPEN_EXISTING, 0, NULL);
+    uint8_t data[SH_FRIENDS_COMMAND_SIZE + 1];
+    DWORD size = 0;
+    bool read = file != INVALID_HANDLE_VALUE && ReadFile(file, data, sizeof data, &size, NULL);
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    DeleteFileW(command_taken);
+    struct sh_friend_command command;
+    int32_t result = SH_FRIEND_BAD_COMMAND;
+    if (read && sh_friend_command_parse(data, size, &command)) {
+        if (command.sequence == f->last_sequence) return;   /* already answered */
+        f->last_sequence = command.sequence;
+        f->o->event("friends-cmd-seq", (int32_t)command.sequence);
+        result = run_command(f, &command, game_running);
+    }
+    f->o->event("friends-cmd-result", result);
+}
+
+void sh_friends_poll(struct sh_friends *f, bool game_running)
+{
+    /* Friends off: the app has no Friends page, so nothing to read or send. */
+    if (!f->friends) return;
+    uint64_t now = f->o->now_ms();
+    if (now < f->next_command_ms) return;
+    f->next_command_ms = now + SH_FRIENDS_FEED_MS / 6;
+    read_command(f, game_running);
+    if (f->shared && f->announce_pending && now >= f->announce_ms) {
+        uint8_t message[64];
+        size_t size = sh_cm_change_status(message, sizeof message, (uint32_t)f->announce_state);
+        bool sent = size && ((send_fn)SHARED(f, 2))(f->shared, f->connection, message, (uint32_t)size);
+        f->o->event("friends-signin", sent ? f->announce_state : -1);
+        /* Then, as the window does once the friends list is in, subscribe to
+         * friends' status; without it Steam sends their names only. */
+        bool subscribed = false;
+        if (sent) {
+            size = sh_cm_service_call(message, sizeof message, "Chat.RequestFriendPersonaStates#1");
+            subscribed = size && ((send_fn)SHARED(f, 2))(f->shared, f->connection, message, (uint32_t)size);
+            f->o->event("friends-subscribed", subscribed);
+        }
+        /* A failed send is tried again every 5 s, five times in all. */
+        if (subscribed || ++f->announce_tries >= 5) f->announce_pending = false;
+        else f->announce_ms = now + 5000;
+    }
+    if (now < f->next_feed_ms) return;
+    f->next_feed_ms = now + SH_FRIENDS_FEED_MS;
+    write_feed(f);
+}
+
+void sh_friends_callback(struct sh_friends *f, int32_t id, const void *data, int32_t size)
+{
+    if (!f->friends) return;
+    /* SteamServersConnected_t: the client logged on again (a dropped network,
+     * a new CM). That logon does not sign in to Friends either, so announce
+     * the status and subscribe again, as at start. */
+    if (id == 101 && f->shared) {
+        f->announce_pending = true;
+        f->announce_tries = 0;
+        f->announce_ms = f->o->now_ms() + 2000;
+    }
+    /* PersonaStateChange_t {uint64 SteamID; int32 flags}: which kinds of
+     * change (1 name, 2 status, 4 came online, 8 went offline, 16 game, ...)
+     * reach this session. Counts and flag bits only. */
+    /* LobbyInvite_t {inviter, lobby, CGameID}: a friend invited this player
+     * to a lobby. Kept for this app only (the newest per friend); Join on
+     * that friend joins it. */
+    if (id == 503 && size >= 24) {
+        uint64_t from, lobby, game;
+        memcpy(&from, data, 8);
+        memcpy(&lobby, (const uint8_t *)data + 8, 8);
+        memcpy(&game, (const uint8_t *)data + 16, 8);
+        struct game_info info = {.game = game};
+        bool ours = game_app(&info) == f->appid && lobby && sh_friend_steamid_valid(from);
+        f->o->event("friends-invite-received", ours ? 1 : 0);
+        if (ours) {
+            forget_invite(f, from);
+            if (f->invite_count == sizeof f->invites / sizeof f->invites[0]) {
+                memmove(f->invites, f->invites + 1, sizeof f->invites - sizeof f->invites[0]);
+                --f->invite_count;
+            }
+            f->invites[f->invite_count].from = from;
+            f->invites[f->invite_count].lobby = lobby;
+            ++f->invite_count;
+            f->next_feed_ms = 0;   /* show it at the next poll */
+        }
+    }
+    if (id == 304 && size >= 12) {
+        uint64_t who;
+        int32_t flags;
+        memcpy(&who, data, sizeof who);
+        memcpy(&flags, (const uint8_t *)data + 8, sizeof flags);
+        if (who != f->self) {
+            ++f->persona_updates;
+            if ((f->persona_flags | flags) != f->persona_flags) {
+                f->persona_flags |= flags;
+                f->o->event("friends-persona-flags", f->persona_flags);
+            }
+            /* At 1, 2, 4, 8, ...: a few lines however long the session. */
+            if ((f->persona_updates & (f->persona_updates - 1)) == 0) f->o->event("friends-persona-updates", f->persona_updates);
+        }
+    }
+    for (unsigned i = 0; i < f->callback_count; ++i) if (f->callback_ids[i] == id) return;
+    if (f->callback_count >= sizeof f->callback_ids / sizeof f->callback_ids[0]) return;
+    f->callback_ids[f->callback_count++] = id;
+    f->o->event("friends-callback-id", id);
+}
+
+void sh_friends_end(struct sh_friends *f)
+{
+    /* Friends off: init removed these and nothing has written them since. */
+    if (!f->friends) return;
+    DeleteFileW(feed_path);
+    DeleteFileW(feed_temp);
+    DeleteFileW(command_path);
+    DeleteFileW(command_taken);
+}
+#else
+void sh_friends_init(struct sh_friends *f, HMODULE module, void *engine, int32_t user, int32_t pipe,
+                     uint64_t self, uint32_t appid, const struct dock_client_layout *layout, const struct sh_observer *o)
+{
+    (void)module; (void)engine; (void)user; (void)pipe; (void)self; (void)appid; (void)layout;
+    memset(f, 0, sizeof *f);
+    f->o = o;
+    o->event("friends-available", 0);
+}
+void sh_friends_poll(struct sh_friends *f, bool game_running) { (void)f; (void)game_running; }
+void sh_friends_callback(struct sh_friends *f, int32_t id, const void *data, int32_t size) { (void)f; (void)id; (void)data; (void)size; }
+void sh_friends_end(struct sh_friends *f) { (void)f; }
+#endif
diff --git a/src/friends.h b/src/friends.h
new file mode 100644
index 0000000..163e054
--- /dev/null
+++ b/src/friends.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 125hz
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md */
+#ifndef MADEIRA_DOCK_FRIENDS_H
+#define MADEIRA_DOCK_FRIENDS_H
+#include "session.h"
+#include "friends_format.h"
+
+/* Friends feed and Join/Invite commands during a launched game. Optional:
+ * when unavailable (unpinned client build, MADEIRA_DOCK_FRIENDS=0, a method
+ * mismatch) it reports friends-available=0 and does nothing else; the launch
+ * is never affected. SteamIDs and names go only to the feed file, never to
+ * the report or a log. */
+struct sh_friends {
+    void *friends;
+    const struct dock_client_layout *layout;
+    const struct sh_observer *o;
+    uint32_t appid, last_sequence;
+    uint64_t next_command_ms, next_feed_ms;
+    int32_t last_count, last_total, last_valid, last_named, last_playing, last_online;
+    uint64_t started_ms, announce_ms, next_request_ms, self;
+    int32_t callback_ids[48];
+    unsigned callback_count;
+    int32_t announce_state;
+    bool announce_pending; /* announce_state (1, 3 or 7) still to be sent */
+    unsigned announce_tries; /* failed sends of the current announce */
+    void *shared;          /* IClientSharedConnection, or NULL */
+    uint32_t connection;   /* its allocated connection */
+    int32_t persona_flags; /* PersonaStateChange_t flags seen, OR-ed */
+    int32_t persona_updates;
+    /* The counts last written to the report, and when they may be written
+     * again: the interval doubles from 15 s to 10 min, so a long session's
+     * report stays small (the app reads at most 1 MB of it). */
+    int32_t logged_count, logged_named, logged_playing, logged_online, logged_requested;
+    uint64_t next_counts_ms, counts_interval_ms;
+    /* Lobby invites received for this app (LobbyInvite_t), newest kept. */
+    struct { uint64_t from, lobby; } invites[16];
+    unsigned invite_count;
+};
+
+void sh_friends_init(struct sh_friends *f, HMODULE module, void *engine, int32_t user, int32_t pipe,
+                     uint64_t self, uint32_t appid, const struct dock_client_layout *layout, const struct sh_observer *o);
+/* Rate-limited; call from the launch loop. Invites need the game running. */
+void sh_friends_poll(struct sh_friends *f, bool game_running);
+/* Records each distinct callback ID seen on the pipe (numbers only), to
+ * show which notifications reach this session. */
+void sh_friends_callback(struct sh_friends *f, int32_t id, const void *data, int32_t size);
+/* Removes the feed so the app never reads a stale list. */
+void sh_friends_end(struct sh_friends *f);
+#endif
diff --git a/src/friends_format.c b/src/friends_format.c
new file mode 100644
index 0000000..70d52ca
--- /dev/null
+++ b/src/friends_format.c
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 125hz
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md */
+#include "friends_format.h"
+#include <string.h>
+
+static const uint8_t feed_magic[8] = {'M', 'F', 'R', 'N', 'D', '0', '0', '1'};
+static const uint8_t command_magic[8] = {'M', 'F', 'C', 'M', 'D', '0', '0', '1'};
+
+/* Length of the UTF-8 sequence starting at s (at most `left` bytes), or 0. */
+static size_t utf8_length(const unsigned char *s, size_t left)
+{
+    unsigned char c = s[0];
+    size_t n = c < 0x80 ? 1 : (c & 0xe0) == 0xc0 ? 2 : (c & 0xf0) == 0xe0 ? 3 : (c & 0xf8) == 0xf0 ? 4 : 0;
+    if (!n || n > left || (n == 2 && c < 0xc2) || (n == 4 && c > 0xf4)) return 0;
+    for (size_t i = 1; i < n; ++i) if ((s[i] & 0xc0) != 0x80) return 0;
+    if (n == 3 && ((c == 0xe0 && s[1] < 0xa0) || (c == 0xed && s[1] >= 0xa0))) return 0;
+    if (n == 4 && ((c == 0xf0 && s[1] < 0x90) || (c == 0xf4 && s[1] >= 0x90))) return 0;
+    return n;
+}
+
+void sh_friend_name_copy(char *out, size_t cap, const char *in)
+{
+    if (!out || !cap) return;
+    out[0] = 0;
+    if (!in) return;
+    const unsigned char *s = (const unsigned char *)in;
+    size_t length = strnlen(in, 4096), used = 0;
+    for (size_t i = 0; i < length;) {
+        size_t n = utf8_length(s + i, length - i);
+        if (!n) { out[0] = 0; return; }
+        if (!(n == 1 && (s[i] < 32 || s[i] == 127))) {
+            if (used + n >= cap) break;
+            memcpy(out + used, s + i, n);
+            used += n;
+        }
+        i += n;
+    }
+    out[used] = 0;
+}
+
+bool sh_friend_connect_valid(const char *connect)
+{
+    if (!connect || !connect[0]) return false;
+    size_t length = strnlen(connect, SH_FRIEND_CONNECT_CAP);
+    if (length >= SH_FRIEND_CONNECT_CAP) return false;
+    for (size_t i = 0; i < length; ++i)
+        if ((unsigned char)connect[i] < 32 || (unsigned char)connect[i] > 126) return false;
+    return true;
+}
+
+bool sh_friend_steamid_valid(uint64_t steamid)
+{
+    return (steamid >> 56) == 1 && ((steamid >> 52) & 0xf) == 1 && (uint32_t)steamid != 0;
+}
+
+static void put32(uint8_t *p, uint32_t v) { for (int i = 0; i < 4; ++i) p[i] = (uint8_t)(v >> (8 * i)); }
+static void put64(uint8_t *p, uint64_t v) { for (int i = 0; i < 8; ++i) p[i] = (uint8_t)(v >> (8 * i)); }
+
+size_t sh_friends_feed_encode(uint8_t *out, size_t cap, const struct sh_friend *friends, uint32_t count)
+{
+    if (!out || count > SH_FRIENDS_MAX || (count && !friends) || cap < 12) return 0;
+    memcpy(out, feed_magic, 8);
+    put32(out + 8, count);
+    size_t at = 12;
+    for (uint32_t i = 0; i < count; ++i) {
+        const struct sh_friend *f = &friends[i];
+        size_t name = strnlen(f->name, SH_FRIEND_NAME_CAP);
+        if (name >= SH_FRIEND_NAME_CAP || at + 18 + name > cap) return 0;
+        put64(out + at, f->steamid);
+        put32(out + at + 8, f->state);
+        put32(out + at + 12, f->appid);
+        out[at + 16] = f->flags & (SH_FRIEND_IN_GAME | SH_FRIEND_SAME_APP | SH_FRIEND_JOINABLE | SH_FRIEND_INVITED | SH_FRIEND_CAN_INVITE);
+        out[at + 17] = (uint8_t)name;
+        memcpy(out + at + 18, f->name, name);
+        at += 18 + name;
+    }
+    return at;
+}
+
+bool sh_friend_command_parse(const uint8_t *data, size_t size, struct sh_friend_command *command)
+{
+    if (!data || !command || size != SH_FRIENDS_COMMAND_SIZE || memcmp(data, command_magic, 8)) return false;
+    uint8_t op = data[8];
+    uint64_t id = 0;
+    uint32_t sequence = 0;
+    for (int i = 7; i >= 0; --i) id = (id << 8) | data[9 + i];
+    for (int i = 3; i >= 0; --i) sequence = (sequence << 8) | data[17 + i];
+    if (!sequence) return false;
+    if (op == SH_FRIEND_SET_STATE) {
+        if (!sh_friend_status_valid(id)) return false;
+    } else if ((op != SH_FRIEND_INVITE && op != SH_FRIEND_JOIN) || !sh_friend_steamid_valid(id)) {
+        return false;
+    }
+    command->op = op;
+    command->steamid = id;
+    command->sequence = sequence;
+    return true;
+}
+
+bool sh_friend_status_valid(uint64_t state)
+{
+    return state == 1 || state == 3 || state == 7;
+}
+
+int32_t sh_friend_status_choice(const wchar_t *value, uint32_t length)
+{
+    if (!value || length != 1 || value[0] < L'0' || value[0] > L'9') return -1;
+    uint32_t state = (uint32_t)(value[0] - L'0');
+    return sh_friend_status_valid(state) ? (int32_t)state : -1;
+}
+
+unsigned sh_friend_rank(uint32_t state, uint8_t flags)
+{
+    if (flags & SH_FRIEND_INVITED) return 0;
+    if (flags & SH_FRIEND_JOINABLE) return 1;
+    if (flags & SH_FRIEND_SAME_APP) return 2;
+    if (flags & SH_FRIEND_IN_GAME) return 3;
+    return state ? 4 : 5;
+}
+
+uint32_t sh_friends_pick(const uint8_t *ranks, uint32_t n, uint32_t *keep, uint32_t max)
+{
+    if (!ranks || !keep) return 0;
+    uint32_t count = 0;
+    for (unsigned rank = 0; rank <= 5 && count < max; ++rank)
+        for (uint32_t i = 0; i < n && count < max; ++i)
+            if ((ranks[i] > 5 ? 5u : ranks[i]) == rank) keep[count++] = i;
+    return count;
+}
+
+static size_t varint(uint8_t *out, uint32_t v)
+{
+    size_t n = 0;
+    do { out[n] = (uint8_t)(v & 0x7f); v >>= 7; if (v) out[n] |= 0x80; ++n; } while (v);
+    return n;
+}
+
+static size_t cm_header(uint8_t *out, uint32_t emsg)
+{
+    put32(out, emsg | 0x80000000u);
+    put32(out + 4, 0);
+    return 8;
+}
+
+size_t sh_cm_invite_to_lobby(uint8_t *out, size_t cap, uint32_t appid, uint64_t lobby, uint64_t user)
+{
+    if (!out || cap < 8 + 6 + 18 || !appid || !lobby || !sh_friend_steamid_valid(user)) return 0;
+    put32(out, SH_CM_INVITE_TO_LOBBY | 0x80000000u);
+    size_t at = 8;
+    out[at++] = 0x18; at += varint(out + at, appid);   /* header 3 routing_appid */
+    put32(out + 4, (uint32_t)(at - 8));
+    out[at++] = 0x11; put64(out + at, lobby); at += 8;  /* 2 steam_id_lobby */
+    out[at++] = 0x19; put64(out + at, user); at += 8;   /* 3 steam_id_user_invited */
+    return at;
+}
+
+size_t sh_cm_service_call(uint8_t *out, size_t cap, const char *method)
+{
+    size_t length = method ? strnlen(method, 128) : 0;
+    if (!out || !length || length >= 128 || cap < 8 + 2 + length) return 0;
+    put32(out, SH_CM_SERVICE_METHOD | 0x80000000u);
+    out[8] = 0x62;                                      /* header 12 target_job_name */
+    out[9] = (uint8_t)length;
+    memcpy(out + 10, method, length);
+    put32(out + 4, (uint32_t)(2 + length));
+    return 10 + length;
+}
+
+size_t sh_cm_change_status(uint8_t *out, size_t cap, uint32_t state)
+{
+    if (!out || cap < 8 + 1 + 5 + 6) return 0;
+    size_t at = cm_header(out, SH_CM_CHANGE_STATUS);
+    out[at++] = 0x08; at += varint(out + at, state);     /* 1 persona_state */
+    out[at++] = 0x28; out[at++] = 0;                    /* 5 persona_set_by_user */
+    out[at++] = 0x38; out[at++] = 1;                    /* 7 need_persona_response */
+    out[at++] = 0x40; out[at++] = 0;                    /* 8 is_client_idle */
+    return at;
+}
+
+size_t sh_cm_request_friend_data(uint8_t *out, size_t cap, uint32_t flags, const uint64_t *ids, uint32_t count)
+{
+    if (!out || (count && !ids) || count > SH_FRIENDS_MAX || cap < 8 + 1 + 5 + (size_t)count * 9) return 0;
+    size_t at = cm_header(out, SH_CM_REQUEST_FRIEND_DATA);
+    out[at++] = 0x08; at += varint(out + at, flags);     /* 1 persona_state_requested */
+    for (uint32_t i = 0; i < count; ++i) {               /* 2 friends, fixed64 */
+        out[at++] = 0x11;
+        put64(out + at, ids[i]);
+        at += 8;
+    }
+    return at;
+}
diff --git a/src/friends_format.h b/src/friends_format.h
new file mode 100644
index 0000000..5bd6f75
--- /dev/null
+++ b/src/friends_format.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright 2026 125hz
+ * Madeira Converter Exception: see LICENSE-EXCEPTION.md
+ * Bounded friends feed (host -> app) and command (app -> host) formats.
+ * Portable: no Windows or Steam calls, so the parsers are unit-tested natively.
+ */
+#ifndef MADEIRA_DOCK_FRIENDS_FORMAT_H
+#define MADEIRA_DOCK_FRIENDS_FORMAT_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <wchar.h>
+
+#define SH_FRIENDS_MAX 250u
+#define SH_FRIEND_NAME_CAP 64u          /* bytes including the terminator */
+#define SH_FRIEND_CONNECT_CAP 256u      /* rich presence "connect", with terminator */
+/* magic(8) count(4), then per friend: id(8) state(4) app(4) flags(1) name length(1) name */
+#define SH_FRIENDS_FEED_CAP (12u + SH_FRIENDS_MAX * (18u + SH_FRIEND_NAME_CAP))
+#define SH_FRIENDS_COMMAND_SIZE 21u     /* magic(8) op(1) id(8) sequence(4) */
+
+enum sh_friend_flag {
+    SH_FRIEND_IN_GAME = 1,      /* playing any game */
+    SH_FRIEND_SAME_APP = 2,     /* playing this session's App ID */
+    SH_FRIEND_JOINABLE = 4,     /* same app with a lobby or a connect string */
+    SH_FRIEND_INVITED = 8,      /* invited this player to a lobby of this app */
+    SH_FRIEND_CAN_INVITE = 16   /* this player has a lobby or connect string to invite with */
+};
+
+/* SET_STATE carries the new persona state in the id field: 1 Online, 3 Away or
+ * 7 Invisible. Offline is chosen before launch only (it turns friends off). */
+enum sh_friend_op { SH_FRIEND_INVITE = 1, SH_FRIEND_JOIN = 2, SH_FRIEND_SET_STATE = 3 };
+
+/* The friends the feed considers (the client's list in its order, up to this
+ * many); at most SH_FRIENDS_MAX of them are written. */
+#define SH_FRIENDS_SCAN 2000u
+
+/* friends-cmd-result values in the report. */
+enum sh_friend_result {
+    SH_FRIEND_DONE = 1,
+    SH_FRIEND_NOT_JOINABLE = 2,
+    SH_FRIEND_UNKNOWN = 3,
+    SH_FRIEND_CALL_FAILED = 4,
+    SH_FRIEND_BAD_COMMAND = 5
+};
+
+struct sh_friend {
+    uint64_t steamid;
+    uint32_t state, appid;
+    uint8_t flags;
+    char name[SH_FRIEND_NAME_CAP];
+};
+
+struct sh_friend_command {
+    uint8_t op;
+    uint64_t steamid;
+    uint32_t sequence;
+};
+
