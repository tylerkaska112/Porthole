+    double sec = b.GPUEndTime - b.GPUStartTime;
+    os_unfair_lock_lock(&g_pp_lock);
+    if (sec > 0 && last_ef > first_sv) { g_pp_span_sec += sec; g_pp_span_ticks += (double)(last_ef - first_sv); }
+    for (int j = 0; j < nl; j++) {
+      int k;
+      for (k = 0; k < g_pp_nstat; k++) if (!memcmp(&g_pp_stat[k].k, &local[j].k, sizeof local[j].k)) break;
+      if (k == g_pp_nstat && g_pp_nstat < 128) { g_pp_stat[k].k = local[j].k; g_pp_nstat++; }
+      if (k < g_pp_nstat) { g_pp_stat[k].n++; g_pp_stat[k].ticks += d[j]; }
+    }
+    os_unfair_lock_unlock(&g_pp_lock);
+  }];
+}
+
+static double pp_bpp(uint32_t fmt) {
+  switch (fmt) {
+  case 10: case 12: case 253: return 1;
+  case 20: case 22: case 25: case 30: case 250: return 2;
+  case 40: case 55: case 65: case 70: case 71: case 80: case 81: case 90: case 92: case 93: case 252: return 4;
+  case 255: case 260: return 5;   /* depth 24/32 + stencil 8 (real storage may be 8) */
+  case 105: case 115: case 114: return 8;
+  case 125: return 16;
+  default: return 4;
+  }
+}
+/* bytes one pass of this kind moves between the tile memory and RAM, counting what its load and store actions ask for */
+static double pp_traffic(const struct pp_key *k) {
+  double px = (double)k->w * k->h * (k->samples ? k->samples : 1);
+  double b = 0;
+  if (k->cload == 1) b += px * pp_bpp(k->cfmt) * k->ncolor;
+  if (k->cstore == 1 || k->cstore == 3) b += px * pp_bpp(k->cfmt) * k->ncolor;
+  if (k->dfmt) { if (k->dload == 1) b += px * pp_bpp(k->dfmt); if (k->dstore == 1 || k->dstore == 3) b += px * pp_bpp(k->dfmt); }
+  return b;
+}
+
+static int pp_cmp(const void *a, const void *b) {
+  double x = ((const struct pp_stat *)a)->ticks, y = ((const struct pp_stat *)b)->ticks;
+  return x < y ? 1 : x > y ? -1 : 0;
+}
+
+void madeira_passprof_dump(double seconds) {
+  atomic_store_explicit(&g_pp_on, 0, memory_order_relaxed);
+  if (!g_pp_sb || !g_pp_cpu0) { dprintf(STDERR_FILENO, "[gpu-prof] no render passes were timed\n"); return; }
+  usleep(300000);   /* the last command buffers may still be completing */
+  struct pp_stat st[128]; int n; double span_sec, span_ticks;
+  os_unfair_lock_lock(&g_pp_lock);
+  n = g_pp_nstat; memcpy(st, g_pp_stat, sizeof st); span_sec = g_pp_span_sec; span_ticks = g_pp_span_ticks;
+  os_unfair_lock_unlock(&g_pp_lock);
+  /* seconds per timestamp tick: the command buffers' own GPU time against the timestamps between their first and last pass */
+  double ns_per_tick = span_ticks > 0 ? span_sec * 1e9 / span_ticks : 1.0;
+  qsort(st, n, sizeof st[0], pp_cmp);
+  double total = 0, traffic = 0; uint64_t passes = 0;
+  for (int i = 0; i < n; i++) { total += st[i].ticks; passes += st[i].n; traffic += st[i].n * pp_traffic(&st[i].k); }
+  dprintf(STDERR_FILENO, "[gpu-prof] %.0f s: %llu render passes, %d kinds, %.1f ms of GPU time per second spent in them (%.3f ns per timestamp tick, from %.1f s of command buffers); load/store traffic asked for: %.0f MB/s\n",
+          seconds, (unsigned long long)passes, n, seconds > 0 ? total * ns_per_tick / 1e6 / seconds : 0.0, ns_per_tick, span_sec, seconds > 0 ? traffic / 1e6 / seconds : 0.0);
+  static const char *ld[] = { "dontcare", "load", "clear" };
+  static const char *stn[] = { "dontcare", "store", "resolve", "storeresolve", "unknown", "custom" };
+  for (int i = 0; i < n && i < 24; i++) {
+    const struct pp_key *k = &st[i].k;
+    double ms_total = st[i].ticks * ns_per_tick / 1e6;
+    dprintf(STDERR_FILENO, "[gpu-prof]   %5.1f%% %6.1f ms/s  %4.1f/s of %ux%u (%ux), %u colour(s) fmt %u [%s/%s], depth fmt %u [%s/%s]: %.2f ms each, %.1f MB moved each\n",
+            total > 0 ? 100.0 * st[i].ticks / total : 0.0, seconds > 0 ? ms_total / seconds : 0.0, seconds > 0 ? st[i].n / seconds : 0.0, k->w, k->h, k->samples,
+            k->ncolor, k->cfmt, k->cload < 3 ? ld[k->cload] : "?", k->cstore < 6 ? stn[k->cstore] : "?", k->dfmt, k->dload < 3 ? ld[k->dload] : "?",
+            k->dstore < 6 ? stn[k->dstore] : "?", st[i].n ? ms_total / st[i].n : 0.0, pp_traffic(k) / 1e6);
+  }
+}
