+/* 0157 (Porthole): the window is resized/moved the way native DXGI does it when a program asks for it (ResizeTarget, SetFullscreenState),
+ * but ONLY when it does not already match: a window that already has the right size or already covers the screen is left exactly as before.
+ * American Truck Simulator creates a 1x1-client placeholder window, strips its border and relies on DXGI to make it screen-sized; with these
+ * no-ops it stayed 132x38 and the picture showed as a postage stamp. Everything is logged as [wsi-0157]. */
+static bool screenRect(RECT *pRect) {
+  int sw = ::GetSystemMetrics(SM_CXSCREEN), sh = ::GetSystemMetrics(SM_CYSCREEN);
+  if (sw < 320 || sh < 240)
+    return false;
+  pRect->left = 0;
+  pRect->top = 0;
+  pRect->right = sw;
+  pRect->bottom = sh;
+  return true;
+}
+
+static bool coversRect(HWND hWindow, const RECT &r) {
+  RECT w = {};
+  if (!::GetWindowRect(hWindow, &w))
+    return false;
+  return w.left <= r.left && w.top <= r.top && w.right >= r.right && w.bottom >= r.bottom;
+}
+
 void resizeWindow(HWND hWindow, DXMTWindowState *pState, uint32_t width,
                   uint32_t height) {
+  RECT screen = {};
+  RECT client = {};
+  if (!hWindow || !screenRect(&screen) || !::GetClientRect(hWindow, &client))
+    return;
+  if (width > (uint32_t)screen.right)
+    width = (uint32_t)screen.right;
+  if (height > (uint32_t)screen.bottom)
+    height = (uint32_t)screen.bottom;
+  if (width < 64 || height < 64)
+    return;
+  if ((uint32_t)(client.right - client.left) == width &&
+      (uint32_t)(client.bottom - client.top) == height)
+    return;
+  RECT oldRect = {};
+  ::GetWindowRect(hWindow, &oldRect);
+  RECT newRect = {0, 0, (LONG)width, (LONG)height};
+  ::AdjustWindowRectEx(&newRect, ::GetWindowLongW(hWindow, GWL_STYLE), FALSE,
+                       ::GetWindowLongW(hWindow, GWL_EXSTYLE));
+  LONG outerW = newRect.right - newRect.left, outerH = newRect.bottom - newRect.top;
+  WARN("[wsi-0157] resizeWindow ", width, "x", height, " (client was ", client.right - client.left, "x",
+       client.bottom - client.top, ")");
+  ::MoveWindow(hWindow, oldRect.left, oldRect.top, outerW, outerH, TRUE);
 }
 
