+static NTSTATUS
+_MTLComputePipelineState_limits(void *obj) {
+  struct unixcall_pso_limits *params = obj;
+  struct WMTComputePipelineLimits *out = (void *)(uintptr_t)params->out;
+  if (!out) return STATUS_INVALID_PARAMETER;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  id<MTLComputePipelineState> pso = (id<MTLComputePipelineState>)params->pipeline;
+  out->max_total_threads_per_threadgroup = (uint32_t)pso.maxTotalThreadsPerThreadgroup;
+  out->thread_execution_width = (uint32_t)pso.threadExecutionWidth;
+  out->static_threadgroup_memory_length = (uint32_t)pso.staticThreadgroupMemoryLength;
+  out->reserved = 0;
+  return STATUS_SUCCESS;
+}
