+/* ml1190 (Porthole 1.2.133): a program named in MADEIRA_SLOW_CLOCK ("Launcher.exe:0.4;...", the same list as madeira.cfg
+ * slow-clock) must read the counter the unix side slows down (NtQueryPerformanceCounter), not this user-mode copy of the
+ * generic timer, which always runs at real speed.  Returns 1 = named, 0 = not named, -1 = the process parameters do not exist yet. */
+static int qpc_slow_program(void)
+{
+    static const WCHAR varW[] = {'M','A','D','E','I','R','A','_','S','L','O','W','_','C','L','O','C','K',0};
+    RTL_USER_PROCESS_PARAMETERS *pp = NtCurrentTeb()->Peb->ProcessParameters;
+    UNICODE_STRING name, value;
+    WCHAR buf[200], *base, *p, *end;
+    int k, found = 0;
+
+    if (!pp || !pp->ImagePathName.Buffer) return -1;
+    base = pp->ImagePathName.Buffer;
+    for (k = 0; k < pp->ImagePathName.Length / (int)sizeof(WCHAR); k++)
+        if (pp->ImagePathName.Buffer[k] == '\\' || pp->ImagePathName.Buffer[k] == '/') base = pp->ImagePathName.Buffer + k + 1;
+    RtlInitUnicodeString( &name, varW );
+    value.Buffer = buf; value.Length = 0; value.MaximumLength = sizeof(buf) - sizeof(WCHAR);
+    if (RtlQueryEnvironmentVariable_U( NULL, &name, &value )) return 0;
+    buf[value.Length / sizeof(WCHAR)] = 0;
+    for (p = buf; *p && !found; p = end + (*end ? 1 : 0))
+    {
+        WCHAR *colon = NULL, *q;
+        int len, ok;
+        for (end = p; *end && *end != ';' && *end != ','; end++) if (*end == ':') colon = end;
+        if (!colon) continue;
+        len = (int)(colon - p);
+        if (len != (int)(pp->ImagePathName.Length / sizeof(WCHAR) - (base - pp->ImagePathName.Buffer))) continue;
+        for (ok = 1, q = p, k = 0; k < len && ok; k++)
+        {
+            WCHAR a = q[k], b = base[k];
+            if (a >= 'A' && a <= 'Z') a += 32;
+            if (b >= 'A' && b <= 'Z') b += 32;
+            if (a != b) ok = 0;
+        }
+        if (ok) found = 1;
+    }
+    if (found) ERR( "[slow-clock] ml1190 %s reads the performance counter through the system call (MADEIRA_SLOW_CLOCK)\n", debugstr_w( base ) );
+    return found;
+}
 
