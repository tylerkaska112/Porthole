 }
 
+/* ml1190 (Porthole 1.2.133): a slower clock for named programs.
+ * madeira.cfg  slow-clock = Launcher.exe:0.4;Other.exe:0.5   (program : speed, 1.0 = normal)
+ * Rockstar's Launcher gives its Social Club browser 30 s to show a window and that browser takes 35-36 s under
+ * emulation; the Launcher thinks time passes at 0.4 of the real rate, so it waits 75 s.  Only the named
+ * programs' own view changes: NtQueryPerformanceCounter runs slow for them, and every finite relative
+ * wait of 1 s or more (NtWait*, NtDelayExecution, NtWaitForAlertByThreadId) takes 1/speed as long.  The
+ * wineserver, the game and everything inside this file keep the real clock (ios_qpc_raw).  The
+ * shared tick count (GetTickCount, read straight from user_shared_data) cannot be slowed for one program. */
+#define IOS_SLOW_MAX 32
+struct ios_slow_proc
+{
+    const void *peb, *params;
+    int permille;                      /* 1000 = real time */
+    ULONGLONG base_raw, base_slow;
+    volatile int ready;
+    volatile long long qpc_reads, waits_scaled;
+};
+volatile int ios_slow_on = -1;         /* -1 = madeira.cfg not read yet, 0 = no program is slowed */
+static struct { char name[48]; int permille; } ios_slow_names[4];
+static int ios_slow_nnames;
+static struct ios_slow_proc ios_slow_procs[IOS_SLOW_MAX];
+static volatile int ios_slow_nprocs, ios_slow_lock;
+
+ULONGLONG ios_qpc_raw(void) { return monotonic_counter(); }
+
+static void ios_slow_init(void)
+{
+    char v[200], *p, *save = NULL;
+    int n = 0;
+    while (__sync_lock_test_and_set( &ios_slow_lock, 1 )) ;
+    if (ios_slow_on < 0)
+    {
+        v[0] = 0;
+        if (!madeira_cfg_get( "slow-clock", v, sizeof(v) ) && getenv( "MADEIRA_SLOW_CLOCK" ))
+            snprintf( v, sizeof(v), "%s", getenv( "MADEIRA_SLOW_CLOCK" ) );
+        for (p = strtok_r( v, ";,", &save ); p && n < 4; p = strtok_r( NULL, ";,", &save ))
+        {
+            char *colon = strrchr( p, ':' );
+            double speed = colon ? atof( colon + 1 ) : 0;
+            if (!colon || speed < 0.05 || speed > 1.0) continue;
+            *colon = 0;
+            snprintf( ios_slow_names[n].name, sizeof(ios_slow_names[n].name), "%s", p );
+            ios_slow_names[n].permille = (int)(speed * 1000 + 0.5);
+            n++;
+        }
+        ios_slow_nnames = n;
+        if (n)
+            fprintf( stderr, "[slow-clock] ml1190 madeira.cfg slow-clock: %d program(s), first %s at %d/1000\n",
+                     n, ios_slow_names[0].name, ios_slow_names[0].permille );
+        __atomic_store_n( &ios_slow_on, n ? 1 : 0, __ATOMIC_RELEASE );
+    }
+    __sync_lock_release( &ios_slow_lock );
+}
+
+static struct ios_slow_proc *ios_slow_find(void)
+{
+    PEB *peb = NtCurrentTeb()->Peb;
+    RTL_USER_PROCESS_PARAMETERS *pp = peb ? peb->ProcessParameters : NULL;
+    int i, n = ios_slow_nprocs, slot, permille = 1000;
+    struct ios_slow_proc *e;
+
+    if (n > IOS_SLOW_MAX) n = IOS_SLOW_MAX;
+    for (i = 0; i < n; i++)
+    {
+        e = &ios_slow_procs[i];
+        if (e->ready && e->peb == peb && e->params == pp) return e;
+    }
+    while (__sync_lock_test_and_set( &ios_slow_lock, 1 )) ;
+    n = ios_slow_nprocs; if (n > IOS_SLOW_MAX) n = IOS_SLOW_MAX;
+    for (i = 0; i < n; i++)
+    {
+        e = &ios_slow_procs[i];
+        if (e->ready && e->peb == peb && e->params == pp) { __sync_lock_release( &ios_slow_lock ); return e; }
+    }
+    if (pp && pp->ImagePathName.Buffer)
+    {
+        const WCHAR *w = pp->ImagePathName.Buffer, *base = w;
+        int len = pp->ImagePathName.Length / sizeof(WCHAR), k, j;
+        for (k = 0; k < len; k++) if (w[k] == '\\' || w[k] == '/') base = w + k + 1;
+        len -= (int)(base - w);
+        for (j = 0; j < ios_slow_nnames; j++)
+        {
+            const char *nm = ios_slow_names[j].name;
+            int ok = (int)strlen( nm ) == len;
+            for (k = 0; ok && k < len; k++)
+            {
+                int a = base[k], b = (unsigned char)nm[k];
+                if (a >= 'A' && a <= 'Z') a += 32;
+                if (b >= 'A' && b <= 'Z') b += 32;
+                if (a != b) ok = 0;
+            }
+            if (ok) { permille = ios_slow_names[j].permille; break; }
+        }
+    }
+    slot = ios_slow_nprocs % IOS_SLOW_MAX;
+    e = &ios_slow_procs[slot];
+    e->ready = 0;
+    e->peb = peb; e->params = pp; e->permille = permille;
+    e->base_raw = e->base_slow = monotonic_counter();
+    e->qpc_reads = e->waits_scaled = 0;
+    __atomic_store_n( &e->ready, 1, __ATOMIC_RELEASE );
+    ios_slow_nprocs++;
+    if (permille != 1000)
+        fprintf( stderr, "[slow-clock] ml1190 peb=%p runs at %d/1000 of real time (clock and waits of 1 s or more)\n",
+                 (void *)peb, permille );
+    __sync_lock_release( &ios_slow_lock );
+    return e;
+}
+
+/* The program's reading of the monotonic counter. */
+static ULONGLONG ios_slow_qpc( ULONGLONG raw )
+{
+    struct ios_slow_proc *e = ios_slow_find();
+    long long n;
+    if (!e || e->permille == 1000) return raw;
+    n = __sync_add_and_fetch( &e->qpc_reads, 1 );
+    if (n == 1 || n == 100 || n == 10000 || n == 1000000)
+        fprintf( stderr, "[slow-clock] ml1190 peb=%p has read the performance counter %lld time(s)\n", (void *)e->peb, n );
+    return e->base_slow + (raw - e->base_raw) / 1000 * e->permille + (raw - e->base_raw) % 1000 * e->permille / 1000;
+}
+
+/* A finite relative wait of 1 s or more, stretched for a slowed program; the same timeout otherwise. */
+static const LARGE_INTEGER *ios_slow_wait( const LARGE_INTEGER *timeout, LARGE_INTEGER *store )
+{
+    struct ios_slow_proc *e;
+    long long rel;
+    if (!timeout || timeout->QuadPart >= 0 || timeout->QuadPart == TIMEOUT_INFINITE) return timeout;
+    rel = -timeout->QuadPart;
+    if (rel < 10000000) return timeout;
+    e = ios_slow_find();
+    if (!e || e->permille == 1000) return timeout;
+    store->QuadPart = -(rel / e->permille * 1000 + rel % e->permille * 1000 / e->permille);
+    if (__sync_add_and_fetch( &e->waits_scaled, 1 ) <= 20)
+        fprintf( stderr, "[slow-clock] ml1190 peb=%p wait of %lld ms becomes %lld ms\n",
+                 (void *)e->peb, (long long)(rel / 10000), (long long)(-store->QuadPart / 10000) );
+    return store;
+}
+
+#define IOS_SLOW_WAIT() \
+    LARGE_INTEGER ios_slow_store; \
+    if (__builtin_expect( ios_slow_on != 0, 0 )) \
+    { \
+        if (ios_slow_on < 0) ios_slow_init(); \
+        if (ios_slow_on > 0) timeout = ios_slow_wait( timeout, &ios_slow_store ); \
+    }
+
