+++ engine-r29/vendor-engine/dxmt/src/d3d11/d3d11_upscale_ctl.hpp	2026-11-09 00:30:43
@@ -0,0 +1,122 @@
+#pragma once
+/* Porthole 0199: upscaling that the in-game menu can change while the game runs.
+ *
+ * The app writes a small control file (MADEIRA_UPSCALE_CTL, C:\ProgramData\Porthole\upscale.ctl) with the lines
+ *     mode=0|1|2      0 = off, 1 = "to the screen" (the factor is worked out from fit), 2 = a fixed factor
+ *     factor=1.5      for mode 2 (1 to 2)
+ *     fit=2752x2064   the screen's pixels, for mode 1
+ * and rewrites it whenever the person changes the choice. The swap chain looks at it twice a second at most. Without the file (or without the variable) everything
+ * is as before: DXMT_METALFX_SPATIAL_SWAPCHAIN / DXMT_METALFX_FIT / d3d11.metalSpatialUpscaleFactor at the start decide, once. A status file next to it
+ * ("<control file>.status") says what the swap chain does with it, for the menu. */
+#include <windows.h>
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace dxmt::upscale {
+
+struct Control {
+  std::string ctlPath, statusPath;
+  bool available = false;        // the app set a control file up
+  int mode = 0;                  // 0 off, 1 to the screen, 2 fixed
+  float factor = 2.0f;           // for mode 2
+  unsigned fitW = 0, fitH = 0;   // for mode 1
+  uint32_t version = 0;          // raised whenever the wish changes
+  uint64_t lastWrite_ = 0;
+  std::chrono::steady_clock::time_point lastPoll_{};
+  bool seenFile_ = false;
+
+  static std::string getenvStr(const char *name) {
+    char buf[1024];
+    DWORD n = GetEnvironmentVariableA(name, buf, sizeof buf);
+    return (n > 0 && n < sizeof buf) ? std::string(buf, n) : std::string();
+  }
+
+  Control() {
+    ctlPath = getenvStr("MADEIRA_UPSCALE_CTL");
+    available = !ctlPath.empty();
+    if (available) statusPath = ctlPath + ".status";
+    /* The start-up wish from the old variables (the app sets them for the game's saved choice and writes the same into the file). */
+    if (getenvStr("DXMT_METALFX_SPATIAL_SWAPCHAIN") == "1") {
+      auto fit = getenvStr("DXMT_METALFX_FIT");
+      unsigned w = 0, h = 0;
+      if (!fit.empty() && sscanf(fit.c_str(), "%ux%u", &w, &h) == 2 && w && h) { mode = 1; fitW = w; fitH = h; }
+      else mode = 2;
+    }
+    if (available) poll(std::chrono::steady_clock::now(), true);
+  }
+
+  /// Reads the file when it changed (at most twice a second unless `now_` is forced). True when the wish changed.
+  bool poll(std::chrono::steady_clock::time_point now, bool force = false) {
+    if (!available) return false;
+    if (!force && now - lastPoll_ < std::chrono::milliseconds(500)) return false;
+    lastPoll_ = now;
+    WIN32_FILE_ATTRIBUTE_DATA info{};
+    if (!GetFileAttributesExA(ctlPath.c_str(), GetFileExInfoStandard, &info)) return false;
+    uint64_t w = ((uint64_t)info.ftLastWriteTime.dwHighDateTime << 32) | info.ftLastWriteTime.dwLowDateTime;
+    if (w == lastWrite_ && seenFile_) return false;
+    HANDLE f = CreateFileA(ctlPath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) return false;
+    char buf[1024];
+    DWORD got = 0;
+    BOOL ok = ReadFile(f, buf, sizeof buf - 1, &got, nullptr);
+    CloseHandle(f);
+    if (!ok) return false;
+    buf[got] = 0;
+    seenFile_ = true;
+    lastWrite_ = w;
+    int m = mode;
+    float fa = factor;
+    unsigned fw = fitW, fh = fitH;
+    for (char *line = strtok(buf, "\r\n"); line; line = strtok(nullptr, "\r\n")) {
+      char *eq = strchr(line, '=');
+      if (!eq) continue;
+      *eq = 0;
+      const char *k = line, *v = eq + 1;
+      if (!strcmp(k, "mode")) m = std::clamp(atoi(v), 0, 2);
+      else if (!strcmp(k, "factor")) fa = std::clamp((float)atof(v), 1.0f, 2.0f);
+      else if (!strcmp(k, "fit")) { unsigned a = 0, b = 0; if (sscanf(v, "%ux%u", &a, &b) == 2 && a && b) { fw = a; fh = b; } }
+    }
+    bool changed = m != mode || fa != factor || fw != fitW || fh != fitH;
+    mode = m; factor = fa; fitW = fw; fitH = fh;
+    if (changed) version++;
+    return changed;
+  }
+
+  /// The factor for a game drawing `width` x `height` (0 = no upscaling): to the screen keeps the aspect, stops at 2x, and does nothing when the game draws about as large as the screen.
+  float factorFor(unsigned width, unsigned height, float configured) const {
+    if (!width || !height) return 0;
+    if (mode == 1) {
+      if (!fitW || !fitH) return 0;
+      float f = std::min((float)fitW / (float)width, (float)fitH / (float)height);
+      if (f > 2.0f) f = 2.0f;
+      return f >= 1.1f ? f : 0;
+    }
+    if (mode == 2) {
+      float f = available ? factor : configured;
+      return f >= 1.05f ? std::min(f, 2.0f) : 0;
+    }
+    return 0;
+  }
+
+  /// For the menu: "state=...", then lines of facts. Written when the picture changes.
+  void writeStatus(const std::string &text) {
+    if (statusPath.empty()) return;
+    HANDLE f = CreateFileA(statusPath.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) return;
+    DWORD put = 0;
+    WriteFile(f, text.data(), (DWORD)text.size(), &put, nullptr);
+    CloseHandle(f);
+  }
+};
+
+inline Control &control() {
+  static Control c;
+  return c;
+}
+
