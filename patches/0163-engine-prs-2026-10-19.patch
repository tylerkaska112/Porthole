+static REFERENCE_TIME ios_engine_period(void) {
+    static REFERENCE_TIME period = -1;
+    if (period < 0) {
+        const char *e = getenv( "MADEIRA_AUDIO_PERIOD_MS" );
+        REFERENCE_TIME hns = 100000;
+        double ms = e && *e ? atof( e ) : 0;
