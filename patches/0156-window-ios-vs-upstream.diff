+/* 0156: what a program asks of its top-level windows (position, size, show, placement, style), logged raw: the first 150 calls. */
+static void ios_wlog( const char *what, HWND hwnd, int a, int b, int c, int d, unsigned e )
+{
+    static unsigned long n;
+    if (n >= 150) return;
+    if (get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) return;
+    n++;
+    dprintf( STDERR_FILENO, "[winreq] 0156 #%lu %s hwnd=%p %d,%d %dx%d %#x\n", n, what, hwnd, a, b, c, d, e );
+}
+#else
+#define ios_wlog(...) ((void)0)
+#endif
+
