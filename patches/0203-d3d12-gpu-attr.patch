+/* Porthole upload-swap-min-kb (madeira.cfg; default 8192 = the 8 MB of before): the size from which a CPU-visible buffer gets storage of our own on the file tier (ml1154).
+ * Grand Theft Auto V Enhanced keeps ~6,900 UPLOAD buffers live, 70 KB on average and ~490 MB together, all under 8 MB, so none of them left the footprint (2026-11-13, "2, 130 MB"
+ * on file-backed storage). A smaller limit moves more of them; each takes whole 64 KB steps of address space, and only touched pages cost memory. */
+static UINT64 mad_upload_swap_min(void) {
+    static UINT64 v;
+    if (!v) {
+        long long kb = mad_cfg_int_pe("upload-swap-min-kb", 8192);
+        if (kb < 4) kb = 4;
+        if (kb > 1048576) kb = 1048576;
+        v = (UINT64)kb << 10;
+        if (kb != 8192) d3d12_log("[madeira-d3d12] upload-swap-min-kb = %lld: CPU-visible buffers of %lld KB or more live on file-backed storage\n", kb, kb);
+    }
+    return v;
