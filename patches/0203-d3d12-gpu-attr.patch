+/* Porthole gpu-attr (madeira.cfg gpu-attr = 1; default 0, a diagnostic): where Metal's currentAllocatedSize grows. The ml1150 / metal-gap lines say how much of Metal's total
+ * the resource categories explain and leave "the rest" (649-750 MB in a Grand Theft Auto V Enhanced run, 2026-11-13) unexplained. With the switch on, every Metal allocation
+ * the layer makes at the sites below is bracketed with currentAllocatedSize before and after, and the growth is added to its site. Other threads allocate at the same time, so
+ * a figure can include their growth: read the sums over thousands of calls, not one call. Costs two calls into winemetal per allocation, which is why it is off. */
+enum { MAD_GA_PSO_LAZY, MAD_GA_CPS_LAZY, MAD_GA_PSO_VDVAR, MAD_GA_PSO_EAGER, MAD_GA_CPS_EAGER, MAD_GA_LIB, MAD_GA_LIB_RESTORE, MAD_GA_TEX, MAD_GA_BUF,
+       MAD_GA_DHEAP, MAD_GA_RING, MAD_GA_SCRATCH, MAD_GA_HEAP, MAD_GA_N };
+static const char *const g_ga_name[MAD_GA_N] = { "pipeline-first-draw", "compute-first-use", "pipeline-vertex-variant", "pipeline-at-creation", "compute-at-creation", "library-create",
+    "library-read-back", "texture", "buffer", "descriptor-heap", "arg-ring-chunk", "scratch-buffers", "placement-heap" };
+static volatile LONG64 g_ga_bytes[MAD_GA_N]; static volatile LONG g_ga_calls[MAD_GA_N], g_ga_grew[MAD_GA_N];
+static int g_ga_on = -1;
+static int mad_ga_enabled(void) {
+    if (g_ga_on < 0) {
+        g_ga_on = mad_cfg_int_pe("gpu-attr", 0) > 0;
+        if (g_ga_on) d3d12_log("[madeira-d3d12] gpu-attr = 1: Metal's growth is attributed to the allocation sites (a diagnostic)\n");
+    }
+    return g_ga_on;
+}
+static LONG64 mad_ga_begin(obj_handle_t dev) { return mad_ga_enabled() && dev ? (LONG64)MTLDevice_currentAllocatedSize(dev) : -1; }
+static void mad_ga_end(unsigned site, obj_handle_t dev, LONG64 before) {
+    LONG64 after, grew;
+    if (before < 0 || site >= MAD_GA_N) return;
+    after = (LONG64)MTLDevice_currentAllocatedSize(dev);
+    grew = after - before;
+    InterlockedIncrement(&g_ga_calls[site]);
+    if (grew > 0) { InterlockedExchangeAdd64(&g_ga_bytes[site], grew); InterlockedIncrement(&g_ga_grew[site]); }
+}
