@@ -265,4 +340,89 @@ __declspec(dllexport) void DXMTLsfgAbort(DXMTLsfgFrame *f) {
   if (b.inEvent) MTLSharedEvent_signalValue(b.inEvent, f->input_value);
   if (f->reserved == 1) fail(b, control(), "the passes did not finish in time, so frame generation switched itself off for this game (switch it off and on in the menu to try again)");
 }
+
+/// Asks whether the game's picture is to be enlarged by Lossless Scaling's upscaler this frame. Returns 1 when the caller has to copy its finished picture into `input_texture`,
+/// signal `input_event` with `input_value`, and then call DXMTUpscaleRun. 0: not now (the caller enlarges it itself).
+__declspec(dllexport) int DXMTUpscaleBegin(DXMTUpscaleFrame *f) {
+  if (!f || f->size < sizeof(DXMTUpscaleFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (!processAllowed() || b.upDead || f->width < 64 || f->height < 64 || !f->out_width || !f->out_height || f->method < 1 || f->method > 2) return 0;
+  auto now = std::chrono::steady_clock::now();
+  if (!ensureDeviceQuiet(b) || !b.upInEvent) return 0;
+  if (b.up && (b.upW != f->width || b.upH != f->height || b.upOw != f->out_width || b.upOh != f->out_height || b.upMethod != f->method || b.upLevel != f->level || b.upFmt != (DXGI_FORMAT)f->dxgi_format)) {
+    b.up.reset();
+    b.upInput.reset();
+    b.upRunning = false;
+  }
+  if (!b.up) {
+    b.upW = f->width; b.upH = f->height; b.upOw = f->out_width; b.upOh = f->out_height; b.upMethod = f->method; b.upLevel = f->level; b.upFmt = (DXGI_FORMAT)f->dxgi_format;
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = b.upW; d.Height = b.upH; d.MipLevels = 1; d.ArraySize = 1; d.Format = b.upFmt; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(b.dev->CreateTexture2D(&d, nullptr, b.upInput.put())) || !metalTexture(b.upInput.get())) { upFail(b, "the picture the game's frame is copied into could not be created"); return 0; }
+    auto up = std::make_unique<Ls1Upscaler>(b.dev.get(), b.imm4.get(), b.upW, b.upH, b.upFmt, b.upOw, b.upOh, b.upMethod == 2, (int)b.upLevel, 4);
+    if (!up->ok()) { upFail(b, up->error()); return 0; }
+    b.up = std::move(up);
+    b.upStatT = now;
+    b.upFrames = 0; b.upMs = 0;
+  }
+  // start-up: the first run of each shader has to be compiled, which takes seconds: start no more passes while the last are not done
+  if ((f->flags & 1) && b.upOutValue > 0 && MTLSharedEvent_signaledValue(b.upOutEvent) < b.upOutValue) return 0;
+  f->input_texture = metalTexture(b.upInput.get());
+  f->input_event = b.upInEvent;
+  f->input_value = ++b.upInValue;
+  b.upRunning = true;
+  return 1;
+}
+
+/// The caller has copied its picture and committed the signal. Runs the passes: the enlarged picture's Metal texture and the events are filled in. Returns 1 on success.
+__declspec(dllexport) int DXMTUpscaleRun(DXMTUpscaleFrame *f) {
+  if (!f || f->size < sizeof(DXMTUpscaleFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (!b.upRunning || !b.up) return 0;
+  b.upRunning = false;
+  auto t0 = std::chrono::steady_clock::now();
+  b.imm4->Wait(b.upInFence.get(), f->input_value);        // the game's picture is in the input texture
+  b.imm4->Wait(b.upDoneFence.get(), b.upDoneWait);         // the caller has copied last time's enlarged picture out
+  std::vector<ID3D11Texture2D *> out;
+  if (!b.up->run(b.upInput.get(), {}, out) || out.size() != 1) { upFail(b, b.up->error().empty() ? std::string("the passes could not run") : b.up->error()); MTLSharedEvent_signalValue(b.upInEvent, f->input_value); return 0; }
+  b.imm4->Signal(b.upOutFence.get(), ++b.upOutValue);
+  b.imm->Flush();
+  b.upMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  b.upFrames++;
+  f->out_texture = metalTexture(out[0]);
+  f->out_event = b.upOutEvent;
+  f->out_value = b.upOutValue;
+  f->done_event = b.upDoneEvent;
+  f->done_value = ++b.upDoneValue;
+  b.upDoneWait = f->done_value;
+  if (!f->out_texture) { MTLSharedEvent_signalValue(b.upDoneEvent, f->done_value); upFail(b, "the enlarged picture has no Metal texture"); return 0; }
+  auto now = std::chrono::steady_clock::now();
+  double secs = std::chrono::duration<double>(now - b.upStatT).count();
+  if (secs >= 5.0) {
+    Logger::info(std::format("[ls-up] (Direct3D 12) {:.1f} s: {} frames, {}x{} -> {}x{} ({}, sharpness {}), the passes cost {:.2f} ms on the present thread per frame", secs, b.upFrames, b.upW, b.upH, b.upOw, b.upOh,
+                             b.upMethod == 2 ? "LS1 performance" : "LS1", b.upLevel + 1, b.upFrames ? b.upMs / (double)b.upFrames : 0.0));
+    b.upStatT = now; b.upFrames = 0; b.upMs = 0;
+  }
+  return 1;
+}
+
+/// The caller could not copy its picture after DXMTUpscaleBegin said yes: nothing waits for it.
+__declspec(dllexport) void DXMTUpscaleAbort(DXMTUpscaleFrame *f) {
+  if (!f) return;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  b.upRunning = false;
+  if (b.upInEvent) MTLSharedEvent_signalValue(b.upInEvent, f->input_value);
+}
+
+/// 1 when the upscaler has been given up on (it could not be set up, or its passes failed): the caller uses MetalFX; `message` says why (up to cap bytes).
+__declspec(dllexport) int DXMTUpscaleFailed(char *message, uint32_t cap) {
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (message && cap) { std::snprintf(message, cap, "%s", b.upError.c_str()); }
+  return b.upDead ? 1 : 0;
+}
 }
