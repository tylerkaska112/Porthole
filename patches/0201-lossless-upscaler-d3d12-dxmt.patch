+void upFail(Bridge &b, const std::string &why) {
+  b.upError = why;
+  b.upDead = true;
+  b.up.reset();
+  Logger::info("[ls-up] (Direct3D 12 bridge) " + why);
+}
+
+/// The device for the passes without the frame generation's status messages (the upscaler works without the frame generation being on).
+bool ensureDeviceQuiet(Bridge &b) {
+  if (b.dev) return true;
+  D3D_FEATURE_LEVEL level{};
+  HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, nullptr, 0, D3D11_SDK_VERSION, b.dev.put(), &level, b.imm.put());
+  if (FAILED(hr) || !b.dev || !b.imm) { upFail(b, std::format("the Direct3D 11 device for the passes could not be created (0x{:x})", (unsigned)hr)); b.dev.reset(); return false; }
+  if (FAILED(b.imm->QueryInterface(__uuidof(ID3D11DeviceContext4), reinterpret_cast<void **>(b.imm4.put())))) { upFail(b, "the Direct3D 11 device has no fences"); b.dev.reset(); return false; }
+  auto *d = static_cast<MTLD3D11Device *>(b.dev.get());
+  if (FAILED(CreateFenceExposingEvent(d, 0, &b.inEvent, b.inFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.outEvent, b.outFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.doneEvent, b.doneFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.upInEvent, b.upInFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.upOutEvent, b.upOutFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.upDoneEvent, b.upDoneFence.put()))) {
+    upFail(b, "the events that join the two graphics paths could not be created");
+    b.dev.reset();
+    return false;
+  }
+  b.inValue = b.outValue = b.doneValue = b.doneWait = 0;
+  b.upInValue = b.upOutValue = b.upDoneValue = b.upDoneWait = 0;
+  Logger::info("[ls-up] (Direct3D 12 bridge) Direct3D 11 device for the passes created");
+  return true;
+}
