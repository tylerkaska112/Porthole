+HANDLE WINAPI NtUserQueryWindow( HWND hwnd, WINDOWINFOCLASS cls )
+{
+    DWORD pid;
+    GUITHREADINFO info;
+
+    switch (cls)
+    {
+    case WindowProcess:
+    case WindowProcess2:
+        if (!get_window_thread( hwnd, &pid )) return NULL;
+        return UlongToHandle( pid );
+
+    case WindowThread:
+        return UlongToHandle( get_window_thread( hwnd, NULL ));
