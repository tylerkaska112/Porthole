+    0x48,0x83,0x3a,0x68,                    /* cmp  qword [rdx], 0x68         */
+    0x72,0x16,                              /* jb   tail                      */
+    0x48,0x81,0x3a,0x00,0x10,0x00,0x00,     /* cmp  qword [rdx], 0x1000       */
+    0x77,0x0d,                              /* ja   tail                      */
+    0x83,0x7a,0x64,0x01,                    /* cmp  dword [rdx+0x64], 1       */
+    0x75,0x07,                              /* jne  tail                      */
