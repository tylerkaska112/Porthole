+     * for the next session in the same app run, and Just Cause 2's own list sets
+     * env.MADEIRA_KEEP_INPUT_DESKTOP = 0 for its session only, so a value kept from the game
+     * before would ignore it. madeira_cfg_get reads the game's own lines ($MADEIRA_CFG_GAME). */
+    if (!keep_checked_at || monotonic_time - keep_checked_at >= TICKS_PER_SEC)
+    {
+        char buf[16];
+        const char *env = madeira_cfg_get( "env.MADEIRA_KEEP_INPUT_DESKTOP", buf, sizeof(buf) )
