+static void madeira_vk_bc_probe( void *handle )
+{
+    static int done;
+    PFN_vkGetInstanceProcAddr gipa;
+    PFN_vkCreateInstance create_instance;
+    PFN_vkEnumerateInstanceExtensionProperties enum_ext;
+    PFN_vkDestroyInstance destroy_instance;
