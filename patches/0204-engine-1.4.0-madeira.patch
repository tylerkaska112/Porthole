+static int ios_pa32_win_take( uint64_t size, void **out )
+{
+    uint64_t b;
+    if (size < 0x40000000ULL || size > 0x200000000ULL || (size & (size - 1))) return 0;
+    for (b = IOS_PA32_WIN_HI - size; b >= IOS_PA32_WIN_LO; b -= size)
