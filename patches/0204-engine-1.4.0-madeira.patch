+    BOOL ok = [text writeToFile:regPath atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    ws_log("[japanese] %u Japanese font names %s %s in user.reg", added, ok ? "mapped to" : "could NOT be mapped to",
+           family.UTF8String);
