+    __asm__ volatile(
+        "mov sp, %0\n"
+        "mov x29, xzr\n"
+        "mov x30, xzr\n"
+        "blr %1\n"
+        "brk #1\n"
+        :
+        : "r"(top), "r"(madeira_msm_after_switch)
+        : "memory");
+    __builtin_unreachable();
+}
