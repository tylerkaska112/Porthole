+            mach_vm_address_t lo = a;
+            if (align) lo = (a + align - 1) & ~(mach_vm_address_t)(align - 1);   /* 0111: an aligned start inside this gap */
+            if (gap_end > lo && gap_end - lo > best_sz) { best = lo; best_sz = gap_end - lo; }
+        }
