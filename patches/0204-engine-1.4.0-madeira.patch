+ DXGI_FORMAT_B8G8R8A8_UNORM=87, DXGI_FORMAT_B8G8R8X8_UNORM_SRGB=93, DXGI_FORMAT_BC6H_TYPELESS=94, DXGI_FORMAT_BC7_UNORM_SRGB=99, DXGI_FORMAT_R8G8B8A8_UNORM=28 };
+typedef int DXGI_FORMAT;
+enum { D3D12_RESOURCE_DIMENSION_UNKNOWN, D3D12_RESOURCE_DIMENSION_BUFFER, D3D12_RESOURCE_DIMENSION_TEXTURE1D, D3D12_RESOURCE_DIMENSION_TEXTURE2D, D3D12_RESOURCE_DIMENSION_TEXTURE3D };
+#define D3D12_TEXTURE_DATA_PITCH_ALIGNMENT 256
+#define D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT 512
+typedef struct { UINT Count, Quality; } SD;
+typedef struct { int Dimension; UINT64 Alignment; UINT64 Width; UINT Height; UINT16 DepthOrArraySize; UINT16 MipLevels; DXGI_FORMAT Format; SD SampleDesc; } D3D12_RESOURCE_DESC;
+typedef struct { DXGI_FORMAT Format; UINT Width, Height, Depth, RowPitch; } FP;
+typedef struct { UINT64 Offset; FP Footprint; } D3D12_PLACED_SUBRESOURCE_FOOTPRINT;
+static int cfg_val = 1;
+static int mad_cfg_int_pe(const char *k, int d) { (void)k; (void)d; return cfg_val; }
+#define d3d12_log printf
+#include "extract.c"
+static int fails;
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); fails++; } } while (0)
+int main(void) {
+    D3D12_RESOURCE_DESC d; memset(&d, 0, sizeof d);
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT L[16]; UINT rows[16]; UINT64 rs[16], total, total_old;
+    d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; d.Width = 64; d.Height = 32; d.DepthOrArraySize = 1; d.MipLevels = 7; d.Format = DXGI_FORMAT_BC1_UNORM; d.SampleDesc.Count = 1;
+    device_GetCopyableFootprints(NULL, &d, 0, 7, 0, L, rows, rs, &total);
+    for (int i = 0; i < 7; i++) {
+        printf("BC1 mip%d %ux%u rows=%u rowbytes=%llu pitch=%u off=%llu\n", i, L[i].Footprint.Width, L[i].Footprint.Height, rows[i], (unsigned long long)rs[i], L[i].Footprint.RowPitch, (unsigned long long)L[i].Offset);
+        CHECK(L[i].Footprint.Width % 4 == 0); CHECK(L[i].Footprint.Height % 4 == 0);
+        CHECK(rows[i] == L[i].Footprint.Height / 4);
+        CHECK(rs[i] == (UINT64)(L[i].Footprint.Width / 4) * 8);
+    }
+    CHECK(L[4].Footprint.Width == 4 && L[4].Footprint.Height == 4); /* 4x2 -> 4x4 */
+    CHECK(L[6].Footprint.Width == 4 && L[6].Footprint.Height == 4); /* 1x1 -> 4x4 */
+    /* non-multiple top level: 100x60 BC7 -> 100x60 (already), mip1 50x30 -> 52x32 */
+    d.Width = 100; d.Height = 60; d.MipLevels = 2; d.Format = DXGI_FORMAT_BC7_UNORM_SRGB;
+    device_GetCopyableFootprints(NULL, &d, 0, 2, 0, L, rows, rs, &total);
+    CHECK(L[1].Footprint.Width == 52 && L[1].Footprint.Height == 32);
+    /* total bytes unchanged vs gate off (rows/rowbytes never depended on rounding) */
+    g_bc_fp_align = -1; cfg_val = 0;
+    device_GetCopyableFootprints(NULL, &d, 0, 2, 0, L, rows, rs, &total_old);
+    CHECK(total == total_old); CHECK(L[1].Footprint.Width == 50 && L[1].Footprint.Height == 30);
+    /* uncompressed unaffected */
+    g_bc_fp_align = -1; cfg_val = 1;
+    d.Format = DXGI_FORMAT_R8G8B8A8_UNORM; d.Width = 3; d.Height = 3; d.MipLevels = 2;
+    device_GetCopyableFootprints(NULL, &d, 0, 2, 0, L, rows, rs, &total);
+    CHECK(L[0].Footprint.Width == 3 && L[1].Footprint.Width == 1);
+    /* buffer unaffected */
+    d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; d.Width = 1000; d.Height = 1; d.MipLevels = 1; d.Format = DXGI_FORMAT_UNKNOWN;
+    device_GetCopyableFootprints(NULL, &d, 0, 1, 0, L, rows, rs, &total);
+    CHECK(L[0].Footprint.Width == 1000);
+    /* clip */
+    { UINT w = 4, h = 4; mad_bc_clip(4, 2, 2, 0, 0, &w, &h); CHECK(w == 2 && h == 2); }
+    { UINT w = 4, h = 4; mad_bc_clip(1, 2, 2, 0, 0, &w, &h); CHECK(w == 4 && h == 4); }
+    { UINT w = 8, h = 4; mad_bc_clip(4, 50, 30, 44, 28, &w, &h); CHECK(w == 6 && h == 2); }
+    { UINT w = 16, h = 16; mad_bc_clip(4, 64, 64, 0, 0, &w, &h); CHECK(w == 16 && h == 16); }
+    printf(fails ? "FAILED %d\n" : "ALL PASS\n", fails);
+    return fails != 0;
+}
diff --git a/madeira-d3d12/tests/host/check-bc-footprint.sh b/madeira-d3d12/tests/host/check-bc-footprint.sh
new file mode 100755
index 0000000..ddf2507
--- /dev/null
+++ b/madeira-d3d12/tests/host/check-bc-footprint.sh
@@ -0,0 +1,10 @@
+#!/bin/bash
+# Host check: BC footprints are whole 4x4 blocks and a copy is cut to its level (bc-footprint).
+set -eu
+DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SRC="$DIR/../../src/pe/madeira_d3d12.c"
+OUT="$(mktemp -d)"; trap 'rm -rf "$OUT"' EXIT
+awk '/^static void mad_format_info\(DXGI_FORMAT f, UINT \*bytes, UINT \*block\) \{/{p=1} p&&/^static D3D12_RESOURCE_ALLOCATION_INFO/{exit} p{print}' "$SRC" > "$OUT/extract.c"
+cp "$DIR/bc_footprint_test.c" "$OUT/t.c"
+${CC:-cc} -std=c11 -Wall -Wno-unused-function -I"$OUT" -o "$OUT/t" "$OUT/t.c"
+"$OUT/t"
diff --git a/madeira-d3d12/tests/native/dxil_cache_test.c b/madeira-d3d12/tests/native/dxil_cache_test.c
index 8339eea..8441fd5 100644
--- a/madeira-d3d12/tests/native/dxil_cache_test.c
+++ b/madeira-d3d12/tests/native/dxil_cache_test.c
@@ -15,11 +15,13 @@
  *   - the size bound evicts least-recently-used entries and nothing else.
  *
  * Build and run (Linux / WSL / macOS):
- *   cc -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Werror -I madeira-d3d12/src \
+ *   cc -std=c11 -D_DEFAULT_SOURCE -Wall -Wextra -Werror -pthread -I madeira-d3d12/src \
  *      madeira-d3d12/tests/native/dxil_cache_test.c -o /tmp/dxil_cache_test && /tmp/dxil_cache_test
  */
 #include "unix/madeira_dxil_cache.h"
 
+#include <errno.h>
+#include <pthread.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -405,11 +407,119 @@ static void test_prune(void)
     CHECK(mad_dxc_prune("/nonexistent/ml1990", MAD_DXC_EXT, 1, 1, &nf, &rm) == 0 && nf == 0, "missing directory");
 }
 
+struct concurrent_store {
+    const char *path;
+    unsigned char value;
+    int failures;
+};
+
+static void *store_repeatedly(void *opaque)
+{
+    struct concurrent_store *s = opaque;
+    unsigned char data[65536];
+    memset(data, s->value, sizeof data);
+    for (unsigned i = 0; i < 64; ++i)
+        if (!mad_dxc_file_store(s->path, data, sizeof data)) ++s->failures;
+    return NULL;
+}
+
+static void test_concurrent_store(void)
+{
+    char dir[] = "/tmp/madeira-dxc-concurrent-XXXXXX", path[256];
+    pthread_t threads[4];
+    struct concurrent_store stores[4];
+    unsigned char data[65536];
+    CHECK(mkdtemp(dir) != NULL, "concurrent store directory");
+    snprintf(path, sizeof path, "%s/entry.mdxc", dir);
+    for (unsigned i = 0; i < 4; ++i) {
+        stores[i] = (struct concurrent_store){ path, (unsigned char)('A' + i), 0 };
+        if (pthread_create(&threads[i], NULL, store_repeatedly, &stores[i])) abort();
+    }
+    for (unsigned i = 0; i < 4; ++i) {
+        pthread_join(threads[i], NULL);
+        CHECK(stores[i].failures == 0, "concurrent writer %u had %d failures", i, stores[i].failures);
+    }
+    int fd = open(path, O_RDONLY);
+    struct stat st;
+    size_t bytes = 0;
+    int valid_size = fd >= 0 && fstat(fd, &st) == 0 && st.st_size == (off_t)sizeof data;
+    while (valid_size && bytes < sizeof data) {
+        ssize_t n = read(fd, data + bytes, sizeof data - bytes);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) break;
+        bytes += (size_t)n;
+    }
+    if (fd >= 0) close(fd);
+    int whole = valid_size && bytes == sizeof data && data[0] >= 'A' && data[0] <= 'D';
+    for (size_t i = 1; whole && i < sizeof data; ++i) whole = data[i] == data[0];
+    CHECK(whole, "concurrent store left one complete writer's data");
+    unlink(path);
+    rmdir(dir);
+}
+
+struct counted_store {
+    struct mad_dxc_disk_state *state;
+    const char *path;
+    int failures;
+};
+
+static void *store_counted_repeatedly(void *opaque)
+{
+    struct counted_store *s = opaque;
+    unsigned char data[4096];
+    memset(data, 'C', sizeof data);
+    for (unsigned i = 0; i < 64; ++i) {
+        uint64_t total;
+        if (mad_dxc_counted_store(s->state, s->path, data, sizeof data, &total) != MAD_DXC_STORE_OK)
+            ++s->failures;
+    }
+    return NULL;
+}
+
+static void test_counted_store(void)
+{
+    char dir[] = "/tmp/madeira-dxc-counted-XXXXXX", path[256];
+    struct mad_dxc_disk_state state = MAD_DXC_DISK_STATE_INIT;
+    struct counted_store stores[4];
+    pthread_t threads[4];
+    uint64_t left = 0, total = 0;
+    unsigned nfiles = 0, removed = 0;
+    CHECK(mkdtemp(dir) != NULL, "counted store directory");
+    snprintf(path, sizeof path, "%s/0000000000000001.%s", dir, MAD_DXC_EXT);
+    CHECK(mad_dxc_counted_prune(&state, dir, MAD_DXC_EXT, UINT64_MAX, 0, 1, &left, &nfiles, &removed),
+          "initial scan succeeds");
+    for (unsigned i = 0; i < 4; ++i) {
+        stores[i] = (struct counted_store){ &state, path, 0 };
+        if (pthread_create(&threads[i], NULL, store_counted_repeatedly, &stores[i])) abort();
+    }
+    for (unsigned i = 0; i < 4; ++i) {
+        pthread_join(threads[i], NULL);
+        CHECK(stores[i].failures == 0, "counted writer %u had %d failures", i, stores[i].failures);
+    }
+    struct stat st;
+    CHECK(stat(path, &st) == 0 && state.bytes == (uint64_t)st.st_size && state.bytes == 4096,
+          "repeated writes count the file once");
+    CHECK(mad_dxc_counted_store(&state, path, "x", 1, &total) == MAD_DXC_STORE_OK && total == 1,
+          "smaller replacement updates the byte count");
+    CHECK(pthread_rwlock_wrlock(&state.scan_lock) == 0, "hold scan lock");
+    CHECK(mad_dxc_counted_store(&state, path, "x", 1, &total) == MAD_DXC_STORE_BUSY,
+          "write does not wait for a scan");
+    pthread_rwlock_unlock(&state.scan_lock);
+    CHECK(mad_dxc_counted_prune(&state, dir, MAD_DXC_EXT, 0, 0, 1, &left, &nfiles, &removed) &&
+          left == 0 && state.bytes == 0 && removed == 1, "prune publishes the remaining size");
+    pthread_rwlock_destroy(&state.scan_lock);
+    pthread_mutex_destroy(&state.write_lock);
+    unlink(path);
+    rmdir(dir);
+}
+
 int main(void)
 {
     test_key();
     test_entry();
     test_prune();
+    test_concurrent_store();
+    test_counted_store();
     printf("[dxil-cache-test] ml1990 %d passed, %d failed\n", g_pass, g_fail);
     return g_fail ? 1 : 0;
 }
