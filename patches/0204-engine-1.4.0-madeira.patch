+        if (names[i] + sizeof("cef_initialize") > size) continue;
+        if (strcmp( (const char *)base + names[i], "cef_initialize" )) continue;
+        if (ords[i] >= exp->NumberOfFunctions) return "cef_initialize ordinal out of range";
