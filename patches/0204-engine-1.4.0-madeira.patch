+        a = r + s;
+    }
+    if (best_sz < (align ? 0x40020000ULL : 0x80020000ULL)) return STATUS_NO_MEMORY;   /* wants a hole of at least 2GB (1GB when aligned) */
+    back = (SIZE_T)(best_sz - 0x20000);
+    if (!cap) cap = 0x40000000ULL;
+    if (back > cap) back = cap;                                              /* 0109: up to 1GB real (4GB twice took 8 of the furniture window's 15) */
+    back &= ~(SIZE_T)0xffff;
+    pick = (void *)(uintptr_t)(align ? best : ((best + 0x10000) & ~(mach_vm_address_t)0xffff));
