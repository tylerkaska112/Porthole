+        keep = !(env && env[0] == '0' && !env[1]);
+        keep_checked_at = monotonic_time ? monotonic_time : 1;
+    }
+    if (log < 0)
+    {
+        char lbuf[16];
+        const char *lenv = madeira_cfg_get( "env.MADEIRA_INPUT_DESKTOP_LOG", lbuf, sizeof(lbuf) )
+                           ? lbuf : getenv( "MADEIRA_INPUT_DESKTOP_LOG" );
+        log = lenv && lenv[0] == '1' && !lenv[1];
+    }
