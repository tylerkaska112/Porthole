+                if (abs_off >= -cur && abs_off < filesize) {
+                    int32_t rel = abs_off >= 0 ? (int32_t)(abs_off - cur) : (int32_t)(abs_off + filesize);
+                    p[0] = (uint8_t)rel; p[1] = (uint8_t)(rel >> 8); p[2] = (uint8_t)(rel >> 16); p[3] = (uint8_t)(rel >> 24);
+                }
