+    /// Reports a Session page's content height so the card can fit it (iOS 18+; older systems keep the full height).
+    /// No Session page gets a card shorter than this: a lazy list can report a near-zero content height
+    /// before its rows exist, and a card that small shows only the header and slides off.
+    private static let sessionCardFloor: CGFloat = 220
+
+    @ViewBuilder private func fitsSessionCard<V: View>(_ key: String, extra: CGFloat = 0, _ view: V) -> some View {
+        if #available(iOS 18.0, *) {
+            view.onScrollGeometryChange(for: CGFloat.self, of: { $0.contentSize.height + $0.contentInsets.top + $0.contentInsets.bottom + extra + (extra > 0 ? 12 : 0) }) { _, h in
+                // A reading under the floor is a lazy list that has not built its rows yet: ignore it
+                // (the card keeps the last good height, or the full height when there is none).
+                guard h >= Self.sessionCardFloor else { return }
+                // Only the page on show reports (the page sliding out must not overwrite the height),
+                // and a change under half a point is noise.
+                guard key == (sessionSub ?? ""), abs(h - (sessionHeights[key] ?? -1)) > 0.5 else { return }
+                if sessionSliding && sessionHeights[key] != nil {
+                    var t = Transaction(); t.disablesAnimations = true
+                    withTransaction(t) { sessionHeights[key] = h; sessionLastHeight = h }
+                } else {
+                    withAnimation(sessionSlide) { sessionHeights[key] = h; sessionLastHeight = h }
                 }
