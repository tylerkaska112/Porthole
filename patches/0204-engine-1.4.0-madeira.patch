+static int ios_pa32_win_overlaps( uint64_t base, uint64_t size )
+{
+    unsigned i;
+    if (base < IOS_PA32_WIN_LO + 0x10000000ULL) return 1;                                    /* the first 256 MB of the first pool */
+    if (base < IOS_PA32_WIN_LO + 0x400000000ULL + 0x10000000ULL && base + size > IOS_PA32_WIN_LO + 0x400000000ULL) return 1;   /* the first 256 MB of the second pool at 0x7c00000000 */
