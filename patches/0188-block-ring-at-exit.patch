+/* Porthole 0188: the calling thread's block ring at a deliberate exit (NtTerminateProcess), for a program that quits by itself with no fault to dump at (a protection stub that ends
+ * the run). Only when MADEIRA_BLOCK_RING gave this thread a ring (silent otherwise, so ordinary runs log nothing extra); at most twice per process, 1536 entries each. */
+void ios_block_ring_dump_current( const char *why )
+{
+    static int dumps = 0;
+    uintptr_t tsd_b, teb, ring = 0;
+    mach_vm_size_t got = 0;
+    extern int ios_teb_tls_slot_offset;
+
+    if (dumps >= 2 || !ios_teb_tls_slot_offset) return;
+    __asm__ volatile("mrs %0, TPIDRRO_EL0" : "=r"(tsd_b)); tsd_b &= ~7ULL;
+    teb = *(uintptr_t *)(tsd_b + ios_teb_tls_slot_offset);
+    if (!teb) return;
+    if (mach_vm_read_overwrite( mach_task_self(), (mach_vm_address_t)(teb + 0x1710), 8, (mach_vm_address_t)&ring, &got ) != KERN_SUCCESS || got != 8 || !ring) return;
+    dumps++;
+    ios_block_ring_dump( teb, 1536, why );
+}
