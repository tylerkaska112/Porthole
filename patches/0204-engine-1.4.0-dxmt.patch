diff --git a/tests/dx11/dx11_local_share.cpp b/tests/dx11/dx11_local_share.cpp
new file mode 100644
index 0000000..23f13fe
--- /dev/null
+++ b/tests/dx11/dx11_local_share.cpp
@@ -0,0 +1,41 @@
+#include <d3d11.h>
+#include <dxgi.h>
+#include <cassert>
+#include <initializer_list>
+
+// Run against the iOS DXMT port: handles stay valid while the originating texture lives.
+int main() {
+  ID3D11Device *a = nullptr, *b = nullptr;
+  assert(SUCCEEDED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0,
+    nullptr, 0, D3D11_SDK_VERSION, &a, nullptr, nullptr)));
+  assert(SUCCEEDED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0,
+    nullptr, 0, D3D11_SDK_VERSION, &b, nullptr, nullptr)));
+  for (UINT flags : {UINT(0), UINT(D3D11_RESOURCE_MISC_SHARED)}) {
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = desc.Height = 16;
+    desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    desc.MiscFlags = flags;
+    ID3D11Texture2D *source = nullptr;
+    assert(SUCCEEDED(a->CreateTexture2D(&desc, nullptr, &source)));
+    IDXGIResource *resource = nullptr;
+    assert(SUCCEEDED(source->QueryInterface(__uuidof(IDXGIResource), (void **)&resource)));
+    HANDLE handle = nullptr;
+    assert(SUCCEEDED(resource->GetSharedHandle(&handle)) && handle);
+    for (auto device : {a, b}) {
+      ID3D11Texture2D *opened = nullptr;
+      assert(SUCCEEDED(device->OpenSharedResource(handle, __uuidof(ID3D11Texture2D), (void **)&opened)));
+      D3D11_TEXTURE2D_DESC actual = {};
+      opened->GetDesc(&actual);
+      assert(actual.Width == desc.Width && actual.Format == desc.Format);
+      opened->Release();
+    }
+    resource->Release();
+    source->Release();
+    ID3D11Texture2D *retired = nullptr;
+    assert(FAILED(b->OpenSharedResource(handle, __uuidof(ID3D11Texture2D), (void **)&retired)));
+  }
+  a->Release();
+  b->Release();
+}
diff --git a/tests/dx11/dx11_typeless_views.cpp b/tests/dx11/dx11_typeless_views.cpp
new file mode 100644
index 0000000..0ec9ff3
--- /dev/null
+++ b/tests/dx11/dx11_typeless_views.cpp
@@ -0,0 +1,29 @@
+#include <d3d11.h>
+#include <cassert>
+#include <initializer_list>
+
+// A colour typeless texture must still support every compatible typed view.
+int main() {
+  ID3D11Device *device = nullptr;
+  assert(SUCCEEDED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0,
+    nullptr, 0, D3D11_SDK_VERSION, &device, nullptr, nullptr)));
+  D3D11_TEXTURE2D_DESC desc = {};
+  desc.Width = desc.Height = 16;
+  desc.MipLevels = desc.ArraySize = desc.SampleDesc.Count = 1;
+  desc.Format = DXGI_FORMAT_R8G8B8A8_TYPELESS;
+  desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+  ID3D11Texture2D *texture = nullptr;
+  assert(SUCCEEDED(device->CreateTexture2D(&desc, nullptr, &texture)));
+  for (auto format : {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB,
+                     DXGI_FORMAT_R8G8B8A8_UINT, DXGI_FORMAT_R8G8B8A8_SINT}) {
+    D3D11_SHADER_RESOURCE_VIEW_DESC view = {};
+    view.Format = format;
+    view.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+    view.Texture2D.MipLevels = 1;
+    ID3D11ShaderResourceView *srv = nullptr;
+    assert(SUCCEEDED(device->CreateShaderResourceView(texture, &view, &srv)));
+    srv->Release();
+  }
+  texture->Release();
+  device->Release();
+}
