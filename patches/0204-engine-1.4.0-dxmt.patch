+      stored += m_currentBegin - lo;
+    }
+    if (hi > m_currentEnd) {
+      m_dynamic->immediateName()->updateContents(m_currentEnd, mirror + m_currentEnd, hi - m_currentEnd, sub);
+      stored += hi - m_currentEnd;
+    }
