diff --git a/src/d3d11/d3d11_lsfg.hpp b/src/d3d11/d3d11_lsfg.hpp
new file mode 100644
index 0000000..51d853c
--- /dev/null
+++ b/src/d3d11/d3d11_lsfg.hpp
@@ -0,0 +1,626 @@
+// Porthole: Lossless Scaling frame generation, run through the ordinary D3D11 interface.
+//
+// The shaders are NOT part of this repository or of the app: the owner's own copy of Lossless Scaling's Lossless.dll is read on the device
+// by the app (only when Steam says the account owns the program), the 202 compiled compute shaders in it are written to a file in the game's
+// prefix for the length of the session, and this code reads that file. Nothing is generated without it.
+//
+// How the passes are chained (which shader, what it reads and writes, how many thread groups, the constant buffer) follows lsfg-vk 1.0.0
+// (https://github.com/PancakeTAS/lsfg-vk, tag v1.0.0, MIT licence, copyright (c) 2025 lsfg-vk contributors), framegen/v3.1_src. That
+// layout was checked against the shaders in Lossless.dll 3.2.1 themselves (resource counts, thread-group sizes and the constant buffer's
+// fields are all read out of each shader's own reflection data).
+#pragma once
+
+#include "d3d11_device.hpp"
+#include "log/log.hpp"
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <format>
+#include <map>
+#include <memory>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace dxmt::lsfg {
+
+/// A COM pointer that does only what is needed here.
+template <class T> class Ptr {
+public:
+  Ptr() = default;
+  Ptr(const Ptr &o) : p_(o.p_) { if (p_) p_->AddRef(); }
+  Ptr(Ptr &&o) noexcept : p_(o.p_) { o.p_ = nullptr; }
+  Ptr &operator=(Ptr o) noexcept { std::swap(p_, o.p_); return *this; }
+  ~Ptr() { if (p_) p_->Release(); }
+  T **put() { reset(); return &p_; }
+  void reset() { if (p_) { p_->Release(); p_ = nullptr; } }
+  T *get() const { return p_; }
+  T *operator->() const { return p_; }
+  explicit operator bool() const { return p_ != nullptr; }
+private:
+  T *p_ = nullptr;
+};
+
+/// What the app asks for, now. At start from the environment (MADEIRA_LSFG_CTL = a control file, MADEIRA_LSFG_SHADERS, and the older MADEIRA_LSFG=1 switch), afterwards from the
+/// control file, which the app rewrites whenever the person changes something in the game's menu: lines "enabled=1", "generated=2", "flow=1.5", "force=1", "hz=120".
+/// It is looked at twice a second at most. A status file next to it ("<control file>.status") says what the passes are doing, for the menu.
+struct Control {
+  std::string shaderFile, ctlPath, statusPath;
+  bool available = false;       // the app set something up at all
+  bool enabled = false;
+  bool measure = false;         // run the passes but do not show what they make (tells the cost of the passes from the cost of showing more frames)
+  bool performance = false;     // the lighter pass layout (fewer, smaller intermediate pictures)
+  bool force = false;           // generate even when the game is fast enough to need no help (for testing)
+  uint32_t generated = 1;       // frames made between two real ones (1 = double the frame rate)
+  float flowDivisor = 1.0f;     // the motion search runs at the picture's size divided by this
+  double screenHz = 0;          // 0 = ask the display
+  uint32_t version = 0;         // raised when the passes have to be rebuilt or started again
+  uint64_t lastWrite_ = 0;
+  std::chrono::steady_clock::time_point lastPoll_{};
+  bool seenFile_ = false, envOn_ = false;
+
+  Control() {
+    auto env = getenvStr("MADEIRA_LSFG");
+    envOn_ = env == "1";
+    ctlPath = getenvStr("MADEIRA_LSFG_CTL");
+    shaderFile = getenvStr("MADEIRA_LSFG_SHADERS");
+    if (shaderFile.empty()) shaderFile = "C:\\ProgramData\\Porthole\\lsfg.bin";
+    if (!ctlPath.empty()) statusPath = ctlPath + ".status";
+    available = envOn_ || !ctlPath.empty();
+    enabled = envOn_;
+    auto g = getenvStr("MADEIRA_LSFG_GENERATED");
+    if (!g.empty()) generated = (uint32_t)std::clamp(atoi(g.c_str()), 1, 3);
+    auto f = getenvStr("MADEIRA_LSFG_FLOW");
+    if (!f.empty()) flowDivisor = std::clamp((float)atof(f.c_str()), 1.0f, 4.0f);
+    auto h = getenvStr("MADEIRA_FRAMEGEN_HZ");
+    if (!h.empty()) screenHz = atof(h.c_str());
+  }
+
+  static std::string getenvStr(const char *name) {
+    char buf[1024];
+    DWORD n = GetEnvironmentVariableA(name, buf, sizeof buf);
+    return (n > 0 && n < sizeof buf) ? std::string(buf, n) : std::string();
+  }
+
+  void poll(std::chrono::steady_clock::time_point now) {
+    if (ctlPath.empty() || now - lastPoll_ < std::chrono::milliseconds(500)) return;
+    lastPoll_ = now;
+    WIN32_FILE_ATTRIBUTE_DATA info{};
+    if (!GetFileAttributesExA(ctlPath.c_str(), GetFileExInfoStandard, &info)) {
+      if (seenFile_) { seenFile_ = false; lastWrite_ = 0; apply(envOn_, generated, flowDivisor, force, screenHz, performance); }
+      return;
+    }
+    uint64_t w = ((uint64_t)info.ftLastWriteTime.dwHighDateTime << 32) | info.ftLastWriteTime.dwLowDateTime;
+    if (w == lastWrite_ && seenFile_) return;
+    HANDLE f = CreateFileA(ctlPath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) return;
+    char buf[2048];
+    DWORD got = 0;
+    BOOL ok = ReadFile(f, buf, sizeof buf - 1, &got, nullptr);
+    CloseHandle(f);
+    if (!ok) return;
+    buf[got] = 0;
+    seenFile_ = true;
+    lastWrite_ = w;
+    bool en = enabled, fc = force;
+    uint32_t gen = generated;
+    float fl = flowDivisor;
+    double hz = screenHz;
+    bool pf = performance;
+    bool ms = measure;
+    for (char *line = strtok(buf, "\r\n"); line; line = strtok(nullptr, "\r\n")) {
+      char *eq = strchr(line, '=');
+      if (!eq) continue;
+      *eq = 0;
+      const char *k = line, *v = eq + 1;
+      if (!strcmp(k, "enabled")) en = atoi(v) != 0;
+      else if (!strcmp(k, "force")) fc = atoi(v) != 0;
+      else if (!strcmp(k, "generated")) gen = (uint32_t)std::clamp(atoi(v), 1, 3);
+      else if (!strcmp(k, "flow")) fl = std::clamp((float)atof(v), 1.0f, 4.0f);
+      else if (!strcmp(k, "hz")) hz = atof(v);
+      else if (!strcmp(k, "performance")) pf = atoi(v) != 0;
+      else if (!strcmp(k, "measure")) ms = atoi(v) != 0;
+    }
+    measure = ms;
+    apply(en, gen, fl, fc, hz, pf);
+  }
+
+  void apply(bool en, uint32_t gen, float fl, bool fc, double hz, bool pf) {
+    bool rebuild = en != enabled || gen != generated || fl != flowDivisor || pf != performance;
+    enabled = en; generated = gen; flowDivisor = fl; force = fc; screenHz = hz; performance = pf;
+    if (rebuild) version++;
+  }
+
+  /// For the menu: "state=...", then free text lines. Written at most every couple of seconds.
+  void writeStatus(const std::string &text) {
+    if (statusPath.empty()) return;
+    HANDLE f = CreateFileA(statusPath.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) return;
+    DWORD put = 0;
+    WriteFile(f, text.data(), (DWORD)text.size(), &put, nullptr);
+    CloseHandle(f);
+  }
+};
+
+inline Control &control() {
+  static Control c;
+  return c;
+}
+
+/// Frame generation is for the game, not for the programs that start it: Rockstar's Launcher and Social Club helper, Steam, the Epic and EA clients and every browser helper also present
+/// through Direct3D, and the control file is the same for all of them (they share the prefix), so each ran the passes on its own window (a 1280x600 and a 700x800 window at 2-8 FPS)
+/// and the game's own start-up suffered. Decided once per process from its program name; MADEIRA_LSFG_ANY_PROCESS=1 lifts it.
+inline bool processAllowed() {
+  static int allowed = -1;
+  if (allowed >= 0) return allowed == 1;
+  char path[MAX_PATH] = {};
+  DWORD n = GetModuleFileNameA(nullptr, path, sizeof path);
+  std::string name(path, n < sizeof path ? n : 0);
+  size_t slash = name.find_last_of("\\/");
+  if (slash != std::string::npos) name = name.substr(slash + 1);
+  for (auto &c : name) c = (char)tolower((unsigned char)c);
+  static const char *deny[] = {"helper", "launcher", "service", "webview", "crashhandler", "crashreport", "reporter", "setup", "install", "unins", "steam.exe", "upc.exe", "uplay",
+                               "eadesktop", "eabackground", "ealink", "origin.exe", "galaxyclient", "cefsubprocess", "dockhost", "wineboot", "explorer.exe", "playgtav.exe"};
+  bool ok = true;
+  for (auto *d : deny) if (name.find(d) != std::string::npos) ok = false;
+  if (Control::getenvStr("MADEIRA_LSFG_ANY_PROCESS") == "1") ok = true;
+  allowed = ok ? 1 : 0;
+  if (control().available) Logger::info(std::format("[lsfg] {} {} get frame generation", name, ok ? "may" : "may not (a launcher or helper program)"));
+  return ok;
+}
+
+/// The compiled shaders, by the resource id they have in Lossless.dll. File: "LSFG", u32 version 1, u32 count, then (u32 id, u32 size, bytes) each.
+class ShaderStore {
+public:
+  static ShaderStore &get() { static ShaderStore s; return s; }
+  /// Reads the file once it exists; asked again later (the app writes it when the person switches the feature on), it tries again while nothing has been loaded.
+  bool load() {
+    if (!blobs_.empty()) return true;
+    HANDLE f = CreateFileA(control().shaderFile.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) {
+      error_ = "the shader file is not there (" + control().shaderFile + ")";
+      WARN("[lsfg] ", error_);
+      return false;
+    }
+    LARGE_INTEGER sz{};
+    GetFileSizeEx(f, &sz);
+    std::vector<uint8_t> data((size_t)sz.QuadPart);
+    DWORD got = 0;
+    bool ok = sz.QuadPart > 12 && sz.QuadPart < (256ll << 20) && ReadFile(f, data.data(), (DWORD)data.size(), &got, nullptr) && got == data.size();
+    CloseHandle(f);
+    if (!ok || std::memcmp(data.data(), "LSFG", 4) != 0) {
+      error_ = "the shader file cannot be read";
+      WARN("[lsfg] ", error_);
+      return false;
+    }
+    auto u32 = [&](size_t o) { uint32_t v; std::memcpy(&v, data.data() + o, 4); return v; };
+    if (u32(4) != 1) { error_ = "the shader file has an unknown version"; WARN("[lsfg] ", error_); return false; }
+    uint32_t count = u32(8);
+    size_t o = 12;
+    for (uint32_t i = 0; i < count; i++) {
+      if (o + 8 > data.size()) break;
+      uint32_t id = u32(o), n = u32(o + 4);
+      o += 8;
+      if (o + n > data.size()) break;
+      blobs_[id].assign(data.begin() + o, data.begin() + o + n);
+      o += n;
+    }
+    Logger::info(std::format("[lsfg] {} shaders loaded", blobs_.size()));
+    return !blobs_.empty();
+  }
+  const std::vector<uint8_t> *find(uint32_t id) const {
+    auto it = blobs_.find(id);
+    return it == blobs_.end() ? nullptr : &it->second;
+  }
+private:
+public:
+  std::string error_;
+private:
+  std::map<uint32_t, std::vector<uint8_t>> blobs_;
+};
+
+/// Resource ids in Lossless.dll: the 3.1 "quality" layout and the lighter "performance" one (fewer, smaller intermediate pictures; the same chain of passes).
+struct Ids {
+  uint32_t mip, gen;
+  uint32_t alpha[4], beta[5], gamma[5], delta[10];
+};
+inline constexpr Ids kQuality{255, 256, {267, 268, 269, 270}, {275, 276, 277, 278, 279}, {257, 259, 260, 261, 262}, {257, 263, 264, 265, 266, 258, 271, 272, 273, 274}};
+inline constexpr Ids kPerformance{255, 256, {290, 291, 292, 293}, {298, 299, 300, 301, 302}, {280, 282, 283, 284, 285}, {280, 286, 287, 288, 289, 281, 294, 295, 296, 297}};
+
+struct ConstantBuffer { // read back out of the shaders' own reflection: InputOffset, FirstIter, FirstIterS, AdvancedColorKind, HdrSupport, ResolutionInvScale, Timestamp, UiThreshold
+  uint32_t inputOffset[2];
+  uint32_t firstIter, firstIterS, advancedColorKind, hdrSupport;
+  float resolutionInvScale, timestamp, uiThreshold;
+  uint32_t pad[3];
+};
+static_assert(sizeof(ConstantBuffer) == 48);
+
+/// The shader objects, kept for the life of the device: building the passes again (a setting changed) must not make the engine convert and compile all of them once more.
+inline std::map<ID3D11Device *, std::map<uint32_t, Ptr<ID3D11ComputeShader>>> &shaderCache() {
+  static std::map<ID3D11Device *, std::map<uint32_t, Ptr<ID3D11ComputeShader>>> c;
+  return c;
+}
+
+struct Img {
+  Ptr<ID3D11Texture2D> tex;
+  Ptr<ID3D11ShaderResourceView> srv;
+  Ptr<ID3D11UnorderedAccessView> uav;
+  UINT w = 0, h = 0;
+};
+using Imgs = std::vector<Img>;
+
+class FrameGen {
+public:
+  FrameGen(ID3D11Device *dev, ID3D11DeviceContext4 *imm, UINT width, UINT height, DXGI_FORMAT format, uint32_t generated, float flowDivisor, bool performance)
+      : dev_(dev), imm_(imm), w_(width), h_(height), fmt_(format), n_(std::max(1u, generated)), flowDiv_(flowDivisor), perf_(performance), id_(performance ? kPerformance : kQuality) {
+    ok_ = build();
+    if (!ok_) {
+      if (error_.empty()) error_ = "a picture or sampler could not be created (" + stage_ + ")";
+      Logger::info("[lsfg] could not be set up: " + error_);
+    }
+  }
+  bool ok() const { return ok_; }
+  const std::string &error() const { return error_; }
+  float flowDivisor() const { return flowDiv_; }
+  UINT width() const { return w_; }
+  UINT height() const { return h_; }
+  DXGI_FORMAT format() const { return fmt_; }
+  /// The format of the pictures made (the game's own, except for an sRGB back buffer: 16-bit floats).
+  DXGI_FORMAT generatedFormat() const { return genFmt_; }
+  uint32_t generated() const { return n_; }
+
+  /// Feeds the game's frame in. When `generate` and enough history is there, the in-between frames are made as well; returns how many (their textures are in `out`).
+  /// Everything is recorded on a deferred context and replayed on the game's own with its state put back.
+  size_t run(ID3D11Resource *backbuffer, bool generate, std::vector<ID3D11Texture2D *> &out) {
+    out.clear();
+    if (!ok_) return 0;
+    uint64_t f = frame_;
+    ID3D11DeviceContext *c = def_.get();
+    prevSrv_ = prevUav_ = 0;
+    c->CopyResource(in_[f % 2].tex.get(), backbuffer);
+    mipmaps(c, f);
+    for (int i = 6; i >= 0; i--) alpha(c, i, f);
+    beta(c, f);
+    bool made = false;
+    if (generate && history_ >= 2) {
+      for (uint32_t p = 0; p < n_; p++) {
+        for (int i = 0; i < 7; i++) {
+          gamma(c, i, f, p);
+          if (i >= 4) delta(c, i - 4, f, p);
+        }
+        generateFrame(c, f, p);
+        out.push_back(gen_[p].tex.get());
+      }
+      made = true;
+    }
+    Ptr<ID3D11CommandList> cl;
+    if (FAILED(c->FinishCommandList(FALSE, cl.put()))) {
+      Logger::info("[lsfg] FinishCommandList failed");
+      ok_ = false;
+      error_ = "the engine could not finish the command list";
+      out.clear();
+      return 0;
+    }
+    imm_->ExecuteCommandList(cl.get(), TRUE);
+    frame_++;
+    if (history_ < 3) history_++;
+    return made ? out.size() : 0;
+  }
+
+  /// A frame was skipped (the game ran too fast to show two frames): the motion history is no longer one frame apart.
+  void breakHistory() { history_ = 0; }
+
+private:
+  // MARK: building
+
+  bool img(Img &i, UINT w, UINT h, DXGI_FORMAT f, UINT bind) {
+    w = std::max(1u, w); h = std::max(1u, h);
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = w; d.Height = h; d.MipLevels = 1; d.ArraySize = 1; d.Format = f; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = bind;
+    if (FAILED(dev_->CreateTexture2D(&d, nullptr, i.tex.put()))) return false;
+    if (bind & D3D11_BIND_SHADER_RESOURCE)
+      if (FAILED(dev_->CreateShaderResourceView(i.tex.get(), nullptr, i.srv.put()))) return false;
+    if (bind & D3D11_BIND_UNORDERED_ACCESS)
+      if (FAILED(dev_->CreateUnorderedAccessView(i.tex.get(), nullptr, i.uav.put()))) return false;
+    i.w = w; i.h = h;
+    return true;
+  }
+  bool work(Img &i, UINT w, UINT h, DXGI_FORMAT f = DXGI_FORMAT_R8G8B8A8_UNORM) {
+    return img(i, w, h, f, D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS);
+  }
+  bool works(Imgs &v, size_t n, UINT w, UINT h, DXGI_FORMAT f = DXGI_FORMAT_R8G8B8A8_UNORM) {
+    v.assign(n, Img());
+    for (auto &i : v) if (!work(i, w, h, f)) return false;
+    return true;
+  }
+
+  ID3D11SamplerState *sampler(int kind) { return samplers_[kind].get(); }
+  bool makeSampler(int kind, D3D11_TEXTURE_ADDRESS_MODE mode, float border) {
+    D3D11_SAMPLER_DESC d{};
+    d.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    d.AddressU = d.AddressV = d.AddressW = mode;
+    d.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    d.MaxLOD = D3D11_FLOAT32_MAX;
+    d.MaxAnisotropy = 1;
+    d.BorderColor[0] = d.BorderColor[1] = d.BorderColor[2] = d.BorderColor[3] = border;
+    return SUCCEEDED(dev_->CreateSamplerState(&d, samplers_[kind].put()));
+  }
+
+  ID3D11Buffer *cbuf(float ts, bool firstIter = false, bool firstIterS = false) {
+    auto key = std::make_tuple(ts, firstIter, firstIterS);
+    auto it = cbufs_.find(key);
+    if (it != cbufs_.end()) return it->second.get();
+    ConstantBuffer cb{};
+    cb.firstIter = firstIter; cb.firstIterS = firstIterS;
+    cb.advancedColorKind = hdr_ ? 2u : 0u; cb.hdrSupport = hdr_ ? 1u : 0u;
+    cb.resolutionInvScale = flowDiv_; cb.timestamp = ts; cb.uiThreshold = 0.5f;
+    D3D11_BUFFER_DESC d{};
+    d.ByteWidth = sizeof cb; d.Usage = D3D11_USAGE_IMMUTABLE; d.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    D3D11_SUBRESOURCE_DATA sd{&cb, 0, 0};
+    Ptr<ID3D11Buffer> b;
+    if (FAILED(dev_->CreateBuffer(&d, &sd, b.put()))) return nullptr;
+    return (cbufs_[key] = b).get();
+  }
+
+  ID3D11ComputeShader *shader(uint32_t id) {
+    auto &cache = shaderCache()[dev_];
+    auto it = cache.find(id);
+    if (it != cache.end()) return it->second.get();
+    auto *blob = ShaderStore::get().find(id);
+    if (!blob) { error_ = std::format("shader {} is not in the shader file", id); return nullptr; }
+    Ptr<ID3D11ComputeShader> s;
+    if (FAILED(dev_->CreateComputeShader(blob->data(), blob->size(), nullptr, s.put()))) {
+      error_ = std::format("the engine refused shader {}", id);
+      return nullptr;
+    }
+    return (cache[id] = s).get();
+  }
+
+  static UINT half(UINT v) { return std::max(1u, (v + 1) >> 1); }
+
+  bool build() {
+    auto t0 = std::chrono::steady_clock::now();
+    stage_ = "shader file";
+    if (!ShaderStore::get().load()) { error_ = ShaderStore::get().error_; return false; }
+    DXGI_FORMAT f = fmt_;
+    // An sRGB back buffer (Unity games, mostly) is read through its sRGB view, which hands the passes linear light, and the pictures they make are kept in 16-bit floats (an 8-bit
+    // linear picture would band in the shadows). The presenter treats a source texture as sRGB-encoded only by the swap chain's format and encodes what it samples, so linear
+    // floats come out right through the same pipeline as the game's own frame.
+    srgb_ = f == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || f == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+    if (f != DXGI_FORMAT_R8G8B8A8_UNORM && f != DXGI_FORMAT_B8G8R8A8_UNORM && f != DXGI_FORMAT_R10G10B10A2_UNORM && f != DXGI_FORMAT_R16G16B16A16_FLOAT && !srgb_) {
+      error_ = std::format("the game's back buffer format ({}) is not supported", (int)f);
+      return false;
+    }
+    genFmt_ = srgb_ ? DXGI_FORMAT_R16G16B16A16_FLOAT : f;
+    hdr_ = f == DXGI_FORMAT_R16G16B16A16_FLOAT;
+    // how many intermediate pictures each pass works with (the performance layout has fewer)
+    const size_t a1 = perf_ ? 1 : 2, a3 = perf_ ? 2 : 4;   // alpha: first two stages / last two stages
+    n1_ = perf_ ? 3 : 4; n2_ = perf_ ? 2 : 4; nm_ = perf_ ? 1 : 2;   // gamma and delta: first temporaries / second temporaries and the middle stages / delta's last stages
+    stage_ = "deferred context";
+    Ptr<ID3D11DeviceContext> d;
+    if (FAILED(dev_->CreateDeferredContext(0, d.put()))) return false;
+    def_ = d;
+    stage_ = "samplers";
+    if (!makeSampler(0, D3D11_TEXTURE_ADDRESS_BORDER, 0.0f) || !makeSampler(1, D3D11_TEXTURE_ADDRESS_BORDER, 1.0f) || !makeSampler(2, D3D11_TEXTURE_ADDRESS_CLAMP, 0.0f))
+      return false;
+    stage_ = "history pictures";
+    for (auto &i : in_) if (!img(i, w_, h_, f, D3D11_BIND_SHADER_RESOURCE)) return false;
+    stage_ = std::format("output pictures (format {} as an unordered-access view)", (int)f);
+    for (uint32_t p = 0; p < n_; p++) {
+      gen_.emplace_back();
+      if (!img(gen_.back(), w_, h_, genFmt_, D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS)) return false;
+    }
+    UINT fw = std::max(1u, (UINT)(w_ / flowDiv_)), fh = std::max(1u, (UINT)(h_ / flowDiv_));
+    flowW_ = fw; flowH_ = fh;
+    stage_ = "motion pictures";
+    for (int i = 0; i < 7; i++)
+      if (!work(mip_[i], fw >> i, fh >> i, DXGI_FORMAT_R8_UNORM)) return false;
+    for (int i = 0; i < 7; i++) {
+      Alpha &a = alpha_[i];
+      UINT ew = std::max(1u, fw >> i), eh = std::max(1u, fh >> i);
+      UINT hw = half(ew), hh = half(eh), qw = half(hw), qh = half(hh);
+      a.half = {hw, hh}; a.quarter = {qw, qh};
+      if (!works(a.t1, a1, hw, hh) || !works(a.t2, a1, hw, hh) || !works(a.t3, a3, qw, qh)) return false;
+      for (int s = 0; s < 3; s++) if (!works(a.out[s], a3, qw, qh)) return false;
+    }
+    Beta &b = beta_;
+    UINT bw = alpha_[0].quarter.first, bh = alpha_[0].quarter.second;
+    b.ext = {bw, bh};
+    if (!works(b.t1, 2, bw, bh) || !works(b.t2, 2, bw, bh)) return false;
+    b.out.assign(6, Img());
+    for (int k = 0; k < 6; k++) if (!work(b.out[k], bw >> k, bh >> k, DXGI_FORMAT_R8_UNORM)) return false;
+    for (int i = 0; i < 7; i++) {
+      Gamma &g = gamma_[i];
+      g.ext = alpha_[6 - i].quarter;
+      if (!works(g.t1, n1_, g.ext.first, g.ext.second) || !works(g.t2, n2_, g.ext.first, g.ext.second)) return false;
+      if (!work(g.out, g.ext.first, g.ext.second, DXGI_FORMAT_R16G16B16A16_FLOAT)) return false;
+    }
+    for (int k = 0; k < 3; k++) {
+      Delta &d2 = delta_[k];
+      d2.ext = alpha_[6 - (k + 4)].quarter;
+      if (!works(d2.t1, n1_, d2.ext.first, d2.ext.second) || !works(d2.t2, n2_, d2.ext.first, d2.ext.second)) return false;
+      if (!work(d2.out1, d2.ext.first, d2.ext.second, DXGI_FORMAT_R16G16B16A16_FLOAT) || !work(d2.out2, d2.ext.first, d2.ext.second, DXGI_FORMAT_R16G16B16A16_FLOAT)) return false;
+    }
+    // every shader up front, so a missing or refused one is known before the first frame
+    stage_ = "shaders";
+    for (uint32_t id : {id_.mip, id_.gen})
+      if (!shader(id)) return false;
+    for (uint32_t id : id_.alpha) if (!shader(id)) return false;
+    for (uint32_t id : id_.beta) if (!shader(id)) return false;
+    for (uint32_t id : id_.gamma) if (!shader(id)) return false;
+    for (uint32_t id : id_.delta) if (!shader(id)) return false;
+    Logger::info(std::format("[lsfg] ready in {:.0f} ms: {}x{} format {}, {} layout, motion search {}x{}, {} generated per frame", std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(), w_, h_, (int)f, perf_ ? "performance" : "quality", fw, fh, n_));
+    return true;
+  }
+
+  // MARK: recording
+
+  using Srvs = std::vector<ID3D11ShaderResourceView *>;
+  using Uavs = std::vector<ID3D11UnorderedAccessView *>;
+
+  static void add(Srvs &v, const Img &i) { v.push_back(i.srv.get()); }
+  static void add(Srvs &v, const Imgs &a, size_t n = ~size_t(0)) { for (size_t i = 0; i < a.size() && i < n; i++) v.push_back(a[i].srv.get()); }
+  static void add(Uavs &v, const Img &i) { v.push_back(i.uav.get()); }
+  static void add(Uavs &v, const Imgs &a, size_t n = ~size_t(0)) { for (size_t i = 0; i < a.size() && i < n; i++) v.push_back(a[i].uav.get()); }
+
+  void dispatch(ID3D11DeviceContext *c, uint32_t id, ID3D11Buffer *cb, std::initializer_list<int> smp, const Srvs &srv, const Uavs &uav, UINT gx, UINT gy) {
+    ID3D11ShaderResourceView *s[16] = {};
+    ID3D11UnorderedAccessView *u[8] = {};
+    ID3D11SamplerState *ss[2] = {};
+    UINT counts[8];
+    for (auto &x : counts) x = ~0u;
+    for (size_t i = 0; i < srv.size() && i < 16; i++) s[i] = srv[i];
+    for (size_t i = 0; i < uav.size() && i < 8; i++) u[i] = uav[i];
+    int k = 0;
+    for (int kind : smp) ss[k++] = sampler(kind);
+    // only as many slots as are needed now or were used by the dispatch before (those have to be cleared): every slot set costs the engine work
+    size_t ns = std::max(std::min<size_t>(srv.size(), 16), prevSrv_), nu = std::max(std::min<size_t>(uav.size(), 8), prevUav_);
+    prevSrv_ = std::min<size_t>(srv.size(), 16); prevUav_ = std::min<size_t>(uav.size(), 8);
+    c->CSSetShader(shader(id), nullptr, 0);
+    c->CSSetConstantBuffers(0, 1, &cb);
+    c->CSSetSamplers(0, (UINT)k, ss);
+    if (ns) c->CSSetShaderResources(0, (UINT)ns, s);
+    if (nu) c->CSSetUnorderedAccessViews(0, (UINT)nu, u, counts);
+    c->Dispatch(gx, gy, 1);
+  }
+
+  static UINT groups(UINT v, int shift) { return (v + (1u << shift) - 1) >> shift; }
+
+  void mipmaps(ID3D11DeviceContext *c, uint64_t f) {
+    Srvs s; add(s, in_[f % 2]);
+    Uavs u; for (auto &m : mip_) add(u, m);
+    dispatch(c, id_.mip, cbuf(0.0f), {0}, s, u, groups(flowW_, 6), groups(flowH_, 6));
+  }
+
+  void alpha(ID3D11DeviceContext *c, int lvl, uint64_t f) {
+    Alpha &a = alpha_[lvl];
+    UINT hx = groups(a.half.first, 3), hy = groups(a.half.second, 3), qx = groups(a.quarter.first, 3), qy = groups(a.quarter.second, 3);
+    { Srvs s; add(s, mip_[lvl]); Uavs u; add(u, a.t1); dispatch(c, id_.alpha[0], nullptr, {0}, s, u, hx, hy); }
+    { Srvs s; add(s, a.t1); Uavs u; add(u, a.t2); dispatch(c, id_.alpha[1], nullptr, {0}, s, u, hx, hy); }
+    { Srvs s; add(s, a.t2); Uavs u; add(u, a.t3); dispatch(c, id_.alpha[2], nullptr, {0}, s, u, qx, qy); }
+    { Srvs s; add(s, a.t3); Uavs u; add(u, a.out[f % 3]); dispatch(c, id_.alpha[3], nullptr, {0}, s, u, qx, qy); }
+  }
+
+  void beta(ID3D11DeviceContext *c, uint64_t f) {
+    Beta &b = beta_;
+    auto &hist = alpha_[0].out;
+    UINT i = (UINT)(f % 3);
+    UINT x = groups(b.ext.first, 3), y = groups(b.ext.second, 3);
+    { Srvs s; add(s, hist[(i + 1) % 3]); add(s, hist[(i + 2) % 3]); add(s, hist[i % 3]); Uavs u; add(u, b.t1); dispatch(c, id_.beta[0], nullptr, {1}, s, u, x, y); }
+    { Srvs s; add(s, b.t1); Uavs u; add(u, b.t2); dispatch(c, id_.beta[1], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, b.t2); Uavs u; add(u, b.t1); dispatch(c, id_.beta[2], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, b.t1); Uavs u; add(u, b.t2); dispatch(c, id_.beta[3], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, b.t2); Uavs u; add(u, b.out); dispatch(c, id_.beta[4], cbuf(0.5f), {0}, s, u, groups(b.ext.first, 5), groups(b.ext.second, 5)); }
+  }
+
+  float stamp(uint32_t p) const { return (float)(p + 1) / (float)(n_ + 1); }
+
+  void gamma(ID3D11DeviceContext *c, int i, uint64_t f, uint32_t p) {
+    Gamma &g = gamma_[i];
+    auto &hist = alpha_[6 - i].out;
+    UINT fi = (UINT)(f % 3);
+    UINT x = groups(g.ext.first, 3), y = groups(g.ext.second, 3);
+    const Img *opt = i == 0 ? nullptr : &gamma_[i - 1].out;
+    const Img &in2 = beta_.out[std::min(6 - i, 5)];
+    ID3D11Buffer *cb = cbuf(stamp(p), i == 0);
+    { Srvs s; add(s, hist[(fi + 2) % 3]); add(s, hist[fi % 3]); if (opt) add(s, *opt);
+      Uavs u; add(u, g.t1, 3); dispatch(c, id_.gamma[0], cb, {1, 2}, s, u, x, y); }
+    { Srvs s; add(s, g.t1, 3); Uavs u; add(u, g.t2); dispatch(c, id_.gamma[1], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, g.t2); Uavs u; add(u, g.t1, n2_); dispatch(c, id_.gamma[2], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, g.t1, n2_); Uavs u; add(u, g.t2); dispatch(c, id_.gamma[3], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, g.t2); if (opt) add(s, *opt); else s.push_back(nullptr); add(s, in2);
+      Uavs u; add(u, g.out); dispatch(c, id_.gamma[4], cb, {0, 2}, s, u, x, y); }
+  }
+
+  void delta(ID3D11DeviceContext *c, int k, uint64_t f, uint32_t p) {
+    Delta &d = delta_[k];
+    int i = k + 4;
+    auto &hist = alpha_[6 - i].out;
+    UINT fi = (UINT)(f % 3);
+    UINT x = groups(d.ext.first, 3), y = groups(d.ext.second, 3);
+    const Img *opt1 = k == 0 ? nullptr : &gamma_[i - 1].out;
+    const Img *opt2 = k == 0 ? nullptr : &delta_[k - 1].out1;
+    const Img *opt3 = k == 0 ? nullptr : &delta_[k - 1].out2;
+    const Img &in2 = beta_.out[6 - i];
+    ID3D11Buffer *cb = cbuf(stamp(p), false, k == 0);
+    auto optSrv = [&](Srvs &s, const Img *o) { s.push_back(o ? o->srv.get() : nullptr); };
+    { Srvs s; add(s, hist[(fi + 2) % 3]); add(s, hist[fi % 3]); optSrv(s, opt1);
+      Uavs u; add(u, d.t1, 3); dispatch(c, id_.delta[0], cb, {1, 2}, s, u, x, y); }
+    { Srvs s; add(s, d.t1, 3); Uavs u; add(u, d.t2); dispatch(c, id_.delta[1], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t2); Uavs u; add(u, d.t1, n2_); dispatch(c, id_.delta[2], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t1, n2_); Uavs u; add(u, d.t2); dispatch(c, id_.delta[3], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t2); optSrv(s, opt1); add(s, in2);
+      Uavs u; add(u, d.out1); dispatch(c, id_.delta[4], cb, {0, 2}, s, u, x, y); }
+    { Srvs s; add(s, hist[(fi + 2) % 3]); add(s, hist[fi % 3]); optSrv(s, opt1); optSrv(s, opt2);
+      Uavs u; add(u, d.t2, nm_); dispatch(c, id_.delta[5], cb, {1, 2}, s, u, x, y); }
+    { Srvs s; add(s, d.t2, nm_); Uavs u; add(u, d.t1, nm_); dispatch(c, id_.delta[6], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t1, nm_); Uavs u; add(u, d.t2, nm_); dispatch(c, id_.delta[7], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t2, nm_); Uavs u; add(u, d.t1, nm_); dispatch(c, id_.delta[8], nullptr, {0}, s, u, x, y); }
+    { Srvs s; add(s, d.t1, nm_); optSrv(s, opt3);
+      Uavs u; add(u, d.out2); dispatch(c, id_.delta[9], cb, {0, 2}, s, u, x, y); }
+  }
+
+  void generateFrame(ID3D11DeviceContext *c, uint64_t f, uint32_t p) {
+    const Img &img0 = in_[0], &img1 = in_[1];
+    bool even = f % 2 == 0;
+    Srvs s;
+    add(s, even ? img1 : img0); add(s, even ? img0 : img1);
+    add(s, gamma_[6].out); add(s, delta_[2].out1); add(s, delta_[2].out2);
+    Uavs u; add(u, gen_[p]);
+    dispatch(c, id_.gen, cbuf(stamp(p)), {0, 2}, s, u, groups(w_, 4), groups(h_, 4));
+  }
+
+  struct Alpha {
+    Imgs t1, t2, t3;
+    std::array<Imgs, 3> out;
+    std::pair<UINT, UINT> half, quarter;
+  };
+  struct Beta {
+    Imgs t1, t2;
+    Imgs out;
+    std::pair<UINT, UINT> ext;
+  };
+  struct Gamma {
+    Imgs t1, t2;
+    Img out;
+    std::pair<UINT, UINT> ext;
+  };
+  struct Delta {
+    Imgs t1, t2;
+    Img out1, out2;
+    std::pair<UINT, UINT> ext;
+  };
+
+  ID3D11Device *dev_;
+  ID3D11DeviceContext4 *imm_;
+  Ptr<ID3D11DeviceContext> def_;
+  UINT w_, h_;
+  DXGI_FORMAT fmt_;
+  uint32_t n_;
+  float flowDiv_;
+  bool perf_;
+  const Ids &id_;
+  size_t n1_ = 4, n2_ = 4, nm_ = 2, prevSrv_ = 0, prevUav_ = 0;
+  UINT flowW_ = 0, flowH_ = 0;
+  bool hdr_ = false, ok_ = false, srgb_ = false;
+  DXGI_FORMAT genFmt_ = DXGI_FORMAT_UNKNOWN;
+  std::string error_, stage_;
+  uint64_t frame_ = 0;
+  int history_ = 0;
+  std::array<Img, 2> in_;
+  std::vector<Img> gen_;
+  std::array<Img, 7> mip_;
+  std::array<Alpha, 7> alpha_;
+  Beta beta_;
+  std::array<Gamma, 7> gamma_;
+  std::array<Delta, 3> delta_;
+  Ptr<ID3D11SamplerState> samplers_[3];
+  std::map<std::tuple<float, bool, bool>, Ptr<ID3D11Buffer>> cbufs_;
+};
+
+} // namespace dxmt::lsfg
diff --git a/src/d3d11/d3d11_lsfg_bridge.cpp b/src/d3d11/d3d11_lsfg_bridge.cpp
new file mode 100644
index 0000000..199b494
--- /dev/null
+++ b/src/d3d11/d3d11_lsfg_bridge.cpp
@@ -0,0 +1,428 @@
+// Porthole: Lossless Scaling frame generation for Direct3D 12 games.
+//
+// Direct3D 12 games do not draw through this DLL: their swap chain belongs to madeira_d3d12.dll, which presents the finished picture with Metal directly. The frame generation
+// passes (d3d11_lsfg.hpp) are Direct3D 11 compute shaders, so they run here, on a Direct3D 11 device of their own that nobody else uses:
+//
+//   madeira_d3d12.dll                                 this DLL (bridge device)
+//   -----------------                                 ------------------------
+//   DXMTLsfgBegin()  ---------------------------->    decides (settings, speed of the game), makes the pictures; returns the Metal texture the
+//                                                     game's finished picture is to be copied into, and the shared events used below
+//   copy the picture into it, signal input_event
+//   DXMTLsfgRun()    ---------------------------->    waits for input_event, runs the passes, signals out_event; returns the Metal textures of the
+//                                                     generated pictures
+//   for each generated picture: wait out_event, copy it to a drawable, present
+//   signal done_event once the last copy is queued ->  the next run waits for done_event before it writes the generated pictures again
+//
+// Both sides use the same Metal device, so the textures and the shared events are the ones Metal hands out; no copy through the CPU happens. Everything that can go wrong ends
+// in "returns 0": the game then simply gets no extra frames (and the status file says why).
+#include "d3d11_lsfg.hpp"
+#include "d3d11_lsfg_upscale.hpp"
+#include "d3d11_fence.hpp"
+#include "d3d11_resource.hpp"
+#include <mutex>
+
+extern "C" {
+// The layout is shared with madeira_d3d12.dll (madeira-d3d12/src/pe/madeira_d3d12.c, struct lsfg_bridge_frame): both change together.
+struct DXMTLsfgFrame {
+  uint32_t size;                    // sizeof (this), so an older caller is refused
+  uint32_t width, height;           // the game's picture
+  uint32_t dxgi_format;             // its DXGI format
+  uint64_t input_texture;           // Metal texture (obj_handle_t) to copy the picture into
+  uint64_t input_event, input_value;   // shared event: the caller signals it with input_value once the copy is done
+  uint32_t count;                   // pictures generated (out of Run)
+  uint32_t reserved;
+  uint64_t out_texture[3];          // Metal textures of the generated pictures
+  uint64_t out_event, out_value;    // shared event: the passes are done when it reaches out_value
+  uint64_t done_event, done_value;  // the caller signals it with done_value once it has copied the generated pictures out
+  uint32_t out_width, out_height;   // set by Run when the generated pictures were enlarged by Lossless Scaling's upscaler (0 = they are the game's size)
+};
+
+// Porthole 0201: Lossless Scaling's upscaler (d3d11_lsfg_upscale.hpp) for Direct3D 12 games. Same two-device arrangement as above, once per presented picture. Layout shared with
+// madeira_d3d12.dll (struct upscale_bridge_frame).
+struct DXMTUpscaleFrame {
+  uint32_t size;
+  uint32_t width, height, dxgi_format;   // the game's picture
+  uint32_t out_width, out_height;        // what it is enlarged to
+  uint32_t method;                       // 1 = LS1, 2 = LS1 performance
+  uint32_t level;                        // sharpness 0..4
+  uint32_t flags;                        // in: 1 = the passes may not be running yet (start-up: do not start new ones while the last are not done)
+  uint32_t reserved;
+  uint64_t input_texture, input_event, input_value;   // as for the frame generation
+  uint64_t out_texture;                  // Metal texture of the enlarged picture
+  uint64_t out_event, out_value;         // the passes are done when it reaches out_value
+  uint64_t done_event, done_value;       // the caller signals it with done_value once it has copied the enlarged picture out
+};
+}
+
+namespace {
+
+using namespace dxmt;
+using namespace dxmt::lsfg;
+
+struct Bridge {
+  std::mutex lock;
+  Ptr<ID3D11Device> dev;
+  Ptr<ID3D11DeviceContext> imm;
+  Ptr<ID3D11DeviceContext4> imm4;
+  Ptr<ID3D11Fence> inFence, outFence, doneFence;
+  obj_handle_t inEvent = 0, outEvent = 0, doneEvent = 0;
+  uint64_t inValue = 0, outValue = 0, doneValue = 0, doneWait = 0;
+  Ptr<ID3D11Texture2D> input;
+  std::unique_ptr<FrameGen> fg;
+  UINT w = 0, h = 0;
+  DXGI_FORMAT fmt = DXGI_FORMAT_UNKNOWN;
+  uint32_t version = ~0u;
+  bool dead = false;
+  std::string error;
+  bool running = false;     // Begin said yes and Run has not been called yet
+  // pacing and statistics, as in the Direct3D 11 swap chain
+  std::chrono::steady_clock::time_point last{}, statT{};
+  double dt = 0;
+  uint64_t statFrames = 0, statMade = 0, statFast = 0;
+  double statMs = 0;
+  bool measure = false;
+  uint64_t cBegin = 0, cYes = 0, cFast = 0, cBusy = 0;   // heartbeat counters
+  std::chrono::steady_clock::time_point busySince{};
+  std::chrono::steady_clock::time_point beat{};
+  // Lossless Scaling's upscaler (Porthole 0201)
+  Ptr<ID3D11Fence> upInFence, upOutFence, upDoneFence;
+  obj_handle_t upInEvent = 0, upOutEvent = 0, upDoneEvent = 0;
+  uint64_t upInValue = 0, upOutValue = 0, upDoneValue = 0, upDoneWait = 0;
+  Ptr<ID3D11Texture2D> upInput;
+  std::unique_ptr<Ls1Upscaler> up;
+  uint32_t upW = 0, upH = 0, upOw = 0, upOh = 0, upMethod = 0, upLevel = 0;
+  DXGI_FORMAT upFmt = DXGI_FORMAT_UNKNOWN;
+  bool upDead = false, upRunning = false;
+  std::string upError;
+  std::chrono::steady_clock::time_point upStatT{};
+  uint64_t upFrames = 0;
+  double upMs = 0;
+};
+
+Bridge &bridge() {
+  static Bridge b;
+  return b;
+}
+
+void fail(Bridge &b, Control &ctl, const std::string &why) {
+  b.error = why;
+  b.dead = true;
+  b.fg.reset();
+  b.statT = std::chrono::steady_clock::now();
+  Logger::info("[lsfg] (Direct3D 12 bridge) " + why);
+  ctl.writeStatus("state=error\nmessage=" + why + "\n");
+}
+
+bool ensureDevice(Bridge &b, Control &ctl) {
+  if (b.dev) return true;
+  D3D_FEATURE_LEVEL level{};
+  HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, nullptr, 0, D3D11_SDK_VERSION, b.dev.put(), &level, b.imm.put());
+  if (FAILED(hr) || !b.dev || !b.imm) { fail(b, ctl, std::format("the Direct3D 11 device for the passes could not be created (0x{:x})", (unsigned)hr)); b.dev.reset(); return false; }
+  if (FAILED(b.imm->QueryInterface(__uuidof(ID3D11DeviceContext4), reinterpret_cast<void **>(b.imm4.put())))) { fail(b, ctl, "the Direct3D 11 device has no fences"); b.dev.reset(); return false; }
+  auto *d = static_cast<MTLD3D11Device *>(b.dev.get());
+  if (FAILED(CreateFenceExposingEvent(d, 0, &b.inEvent, b.inFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.outEvent, b.outFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.doneEvent, b.doneFence.put()))) {
+    fail(b, ctl, "the events that join the two graphics paths could not be created");
+    b.dev.reset();
+    return false;
+  }
+  b.inValue = b.outValue = b.doneValue = b.doneWait = 0;
+  if (FAILED(CreateFenceExposingEvent(d, 0, &b.upInEvent, b.upInFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.upOutEvent, b.upOutFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.upDoneEvent, b.upDoneFence.put()))) {
+    Logger::info("[ls-up] (Direct3D 12 bridge) the events for the upscaler could not be created");
+    b.upInEvent = b.upOutEvent = b.upDoneEvent = 0;
+  }
+  b.upInValue = b.upOutValue = b.upDoneValue = b.upDoneWait = 0;
+  Logger::info("[lsfg] (Direct3D 12 bridge) Direct3D 11 device for the passes created");
+  return true;
+}
+
+obj_handle_t metalTexture(ID3D11Resource *r) {
+  auto t = GetTexture(r);
+  if (!t) return 0;
+  auto *a = t->current();
+  return a ? a->texture().handle : 0;
+}
+
+void upFail(Bridge &b, const std::string &why) {
+  b.upError = why;
+  b.upDead = true;
+  b.up.reset();
+  Logger::info("[ls-up] (Direct3D 12 bridge) " + why);
+}
+
+/// The device for the passes without the frame generation's status messages (the upscaler works without the frame generation being on).
+bool ensureDeviceQuiet(Bridge &b) {
+  if (b.dev) return true;
+  D3D_FEATURE_LEVEL level{};
+  HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, nullptr, 0, D3D11_SDK_VERSION, b.dev.put(), &level, b.imm.put());
+  if (FAILED(hr) || !b.dev || !b.imm) { upFail(b, std::format("the Direct3D 11 device for the passes could not be created (0x{:x})", (unsigned)hr)); b.dev.reset(); return false; }
+  if (FAILED(b.imm->QueryInterface(__uuidof(ID3D11DeviceContext4), reinterpret_cast<void **>(b.imm4.put())))) { upFail(b, "the Direct3D 11 device has no fences"); b.dev.reset(); return false; }
+  auto *d = static_cast<MTLD3D11Device *>(b.dev.get());
+  if (FAILED(CreateFenceExposingEvent(d, 0, &b.inEvent, b.inFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.outEvent, b.outFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.doneEvent, b.doneFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.upInEvent, b.upInFence.put())) ||
+      FAILED(CreateFenceExposingEvent(d, 0, &b.upOutEvent, b.upOutFence.put())) || FAILED(CreateFenceExposingEvent(d, 0, &b.upDoneEvent, b.upDoneFence.put()))) {
+    upFail(b, "the events that join the two graphics paths could not be created");
+    b.dev.reset();
+    return false;
+  }
+  b.inValue = b.outValue = b.doneValue = b.doneWait = 0;
+  b.upInValue = b.upOutValue = b.upDoneValue = b.upDoneWait = 0;
+  Logger::info("[ls-up] (Direct3D 12 bridge) Direct3D 11 device for the passes created");
+  return true;
+}
+
+void rebuild(Bridge &b) {
+  b.fg.reset();
+  b.input.reset();
+  b.running = false;
+  b.dt = 0;
+  b.last = {};
+  b.statFrames = b.statMade = b.statFast = 0;
+  b.statMs = 0;
+}
+
+} // namespace
+
+extern "C" {
+
+/// Asks whether this frame gets extra frames. Returns 1 when the caller has to copy its finished picture into `input_texture`, signal `input_event` with `input_value`, and then
+/// call DXMTLsfgRun. Returns 0 when nothing is to be done now (switched off, not needed, or not possible: the status file says which).
+__declspec(dllexport) int DXMTLsfgBegin(DXMTLsfgFrame *f) {
+  if (!f || f->size < sizeof(DXMTLsfgFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  auto &ctl = control();
+  if (!ctl.available || !processAllowed() || f->width < 640 || f->height < 360) return 0;
+  auto now = std::chrono::steady_clock::now();
+  ctl.poll(now);
+  if (ctl.version != b.version) {
+    b.version = ctl.version;
+    rebuild(b);
+    b.dead = false;
+    b.error.clear();
+    b.statT = now;
+    if (!ctl.enabled) ctl.writeStatus("state=off\n");
+  }
+  b.measure = ctl.measure;
+  if (!ctl.enabled) return 0;
+  if (b.dead) {
+    if (now - b.statT >= std::chrono::seconds(2)) { b.statT = now; ctl.writeStatus("state=error\nmessage=" + b.error + "\n"); }
+    return 0;
+  }
+  double dt = 0;
+  if (b.last.time_since_epoch().count() != 0) dt = std::chrono::duration<double>(now - b.last).count();
+  b.last = now;
+  if (dt > 0) b.dt = b.dt > 0 ? b.dt * 0.8 + std::min(dt, 0.16) * 0.2 : std::min(dt, 0.16);
+  if (b.fg && (b.w != f->width || b.h != f->height || b.fmt != (DXGI_FORMAT)f->dxgi_format)) rebuild(b);   // the game changed its resolution
+  if (!b.fg) {
+    if (f->width < 64 || f->height < 64) return 0;
+    ctl.writeStatus("state=starting\n");
+    if (!ensureDevice(b, ctl)) return 0;
+    b.w = f->width; b.h = f->height; b.fmt = (DXGI_FORMAT)f->dxgi_format;
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = b.w; d.Height = b.h; d.MipLevels = 1; d.ArraySize = 1; d.Format = b.fmt; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(b.dev->CreateTexture2D(&d, nullptr, b.input.put())) || !metalTexture(b.input.get())) { fail(b, ctl, "the picture the game's frame is copied into could not be created"); return 0; }
+    auto fg = std::make_unique<FrameGen>(b.dev.get(), b.imm4.get(), b.w, b.h, b.fmt, ctl.generated, ctl.flowDivisor, ctl.performance);
+    if (!fg->ok()) { fail(b, ctl, fg->error()); return 0; }
+    if (fg->generatedFormat() != b.fmt) { fail(b, ctl, std::format("the game's back buffer format ({}) is not supported in Direct3D 12 games", (int)b.fmt)); return 0; }
+    b.fg = std::move(fg);
+    b.statT = now;
+    ctl.writeStatus("state=running\nmessage=waiting for the game to run slower than the screen\n");
+  }
+  double hz = ctl.screenHz > 0 ? ctl.screenHz : 60.0;
+  b.statFrames++;
+  b.cBegin++;
+  if (b.beat.time_since_epoch().count() == 0) b.beat = now;
+  if (now - b.beat >= std::chrono::seconds(5)) {   // what the bridge decided, even when it never gets to run (the log has no other trace of it)
+    Logger::info(std::format("[lsfg] (Direct3D 12 bridge) last {:.0f} s: {} presents seen, {} asked for the passes, {} skipped (game faster than {:.0f} Hz allows), {} while the last passes were still running, game frame {:.1f} ms",
+                             std::chrono::duration<double>(now - b.beat).count(), b.cBegin, b.cYes, b.cFast, hz, b.cBusy, b.dt * 1000.0));
+    b.beat = now; b.cBegin = b.cYes = b.cFast = b.cBusy = 0;
+  }
+  // The previous frame's passes are still running on the GPU (the first run of each shader also has to be compiled, which takes seconds): start no more, so no work piles up behind them
+  // and the game is never made to wait for them. A pass that is still not done after 20 s is taken for stuck.
+  if (b.outValue > 0 && MTLSharedEvent_signaledValue(b.outEvent) < b.outValue) {
+    if (b.busySince.time_since_epoch().count() == 0) b.busySince = now;
+    if (now - b.busySince > std::chrono::seconds(20)) { fail(b, ctl, "the passes did not finish in 20 seconds, so frame generation switched itself off for this game (switch it off and on in the menu to try again)"); return 0; }
+    b.fg->breakHistory();
+    b.cBusy++;
+    return 0;
+  }
+  b.busySince = {};
+  bool can = b.dt > 0 && dt <= 0.16 && (ctl.force || b.dt >= ((double)b.fg->generated() + 0.9) / hz);
+  if (!can) {
+    b.fg->breakHistory();
+    b.statFast++;
+    b.cFast++;
+    return 0;
+  }
+  f->input_texture = metalTexture(b.input.get());
+  f->input_event = b.inEvent;
+  f->input_value = ++b.inValue;
+  b.running = true;
+  b.cYes++;
+  return 1;
+}
+
+/// The caller has copied its picture and committed the signal. Runs the passes and returns how many pictures were generated (their Metal textures are in out_texture).
+__declspec(dllexport) int DXMTLsfgRun(DXMTLsfgFrame *f) {
+  if (!f || f->size < sizeof(DXMTLsfgFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  auto &ctl = control();
+  f->count = 0;
+  if (!b.running || !b.fg) return 0;
+  b.running = false;
+  auto t0 = std::chrono::steady_clock::now();
+  b.imm4->Wait(b.inFence.get(), f->input_value);          // the game's picture is in the input texture
+  b.imm4->Wait(b.doneFence.get(), b.doneWait);              // the caller has copied last time's generated pictures out
+  std::vector<ID3D11Texture2D *> out;
+  b.fg->run(b.input.get(), true, out);
+  if (!b.fg->ok()) { fail(b, ctl, b.fg->error()); return 0; }
+  f->out_width = f->out_height = 0;
+  if (b.up && b.up->ok() && !b.upDead && b.up->width() == b.w && b.up->height() == b.h && out.size() + 1 <= b.up->capacity()) {
+    // Lossless Scaling's upscaler is on for this game: the generated pictures are enlarged by the same passes as the game's own
+    std::vector<ID3D11Texture2D *> big;
+    if (b.up->run(nullptr, out, big) && big.size() == out.size()) {
+      out = big;
+      f->out_width = b.up->outWidth();
+      f->out_height = b.up->outHeight();
+    }
+  }
+  b.imm4->Signal(b.outFence.get(), ++b.outValue);
+  b.imm->Flush();
+  b.statMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  b.statMade += out.size();
+  f->out_event = b.outEvent;
+  f->out_value = b.outValue;
+  f->done_event = b.doneEvent;
+  f->done_value = ++b.doneValue;
+  b.doneWait = f->done_value;                               // the next run waits for this one
+  uint32_t n = 0;
+  if (!b.measure) {   // "measure only": the passes ran, nothing extra is shown
+    for (auto *o : out) {
+      if (n >= 3) break;
+      f->out_texture[n] = metalTexture(o);
+      if (!f->out_texture[n]) { n = 0; break; }
+      n++;
+    }
+  }
+  if (b.measure || n == 0) {   // nothing will be copied out: let the next run go on
+    MTLSharedEvent_signalValue(b.doneEvent, f->done_value);
+  }
+  f->count = n;
+  auto now = std::chrono::steady_clock::now();
+  double secs = std::chrono::duration<double>(now - b.statT).count();
+  if (secs >= 2.0) {
+    double hz = ctl.screenHz > 0 ? ctl.screenHz : 60.0;
+    uint64_t ran = b.statFrames > b.statFast ? b.statFrames - b.statFast : 0;
+    double passes = ran ? b.statMs / (double)ran : 0.0;
+    Logger::info(std::format(
+        "[lsfg] (Direct3D 12) {:.1f} s: game {:.1f} fps (frame {:.1f} ms), generated {:.1f}/s, frames without ({}: screen {:.0f} Hz cannot show more), passes cost {:.2f} ms on the present thread per frame",
+        secs, b.statFrames / secs, b.dt * 1000.0, b.statMade / secs, b.statFast, hz, passes));
+    ctl.writeStatus(std::format(
+        "state={}\ngame={:.1f}\ngenerated={:.1f}\nwithout={}\nframes={}\nscreen={:.0f}\ncost={:.2f}\nsize={}x{}\nflow={}x{}\n",
+        b.statMade ? "generating" : "running", b.statFrames / secs, b.statMade / secs, b.statFast, b.statFrames, hz, passes, b.fg->width(), b.fg->height(),
+        (UINT)(b.fg->width() / b.fg->flowDivisor()), (UINT)(b.fg->height() / b.fg->flowDivisor())));
+    b.statT = now; b.statFrames = b.statMade = b.statFast = 0; b.statMs = 0;
+  }
+  return (int)n;
+}
+
+/// The caller could not copy its picture after DXMTLsfgBegin said yes: nothing waits for it.
+__declspec(dllexport) void DXMTLsfgAbort(DXMTLsfgFrame *f) {
+  if (!f) return;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  b.running = false;
+  if (b.fg) b.fg->breakHistory();
+  if (b.inEvent) MTLSharedEvent_signalValue(b.inEvent, f->input_value);
+  if (f->reserved == 1) fail(b, control(), "the passes did not finish in time, so frame generation switched itself off for this game (switch it off and on in the menu to try again)");
+}
+
+/// Asks whether the game's picture is to be enlarged by Lossless Scaling's upscaler this frame. Returns 1 when the caller has to copy its finished picture into `input_texture`,
+/// signal `input_event` with `input_value`, and then call DXMTUpscaleRun. 0: not now (the caller enlarges it itself).
+__declspec(dllexport) int DXMTUpscaleBegin(DXMTUpscaleFrame *f) {
+  if (!f || f->size < sizeof(DXMTUpscaleFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (!processAllowed() || b.upDead || f->width < 64 || f->height < 64 || !f->out_width || !f->out_height || f->method < 1 || f->method > 2) return 0;
+  auto now = std::chrono::steady_clock::now();
+  if (!ensureDeviceQuiet(b) || !b.upInEvent) return 0;
+  if (b.up && (b.upW != f->width || b.upH != f->height || b.upOw != f->out_width || b.upOh != f->out_height || b.upMethod != f->method || b.upLevel != f->level || b.upFmt != (DXGI_FORMAT)f->dxgi_format)) {
+    b.up.reset();
+    b.upInput.reset();
+    b.upRunning = false;
+  }
+  if (!b.up) {
+    b.upW = f->width; b.upH = f->height; b.upOw = f->out_width; b.upOh = f->out_height; b.upMethod = f->method; b.upLevel = f->level; b.upFmt = (DXGI_FORMAT)f->dxgi_format;
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = b.upW; d.Height = b.upH; d.MipLevels = 1; d.ArraySize = 1; d.Format = b.upFmt; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(b.dev->CreateTexture2D(&d, nullptr, b.upInput.put())) || !metalTexture(b.upInput.get())) { upFail(b, "the picture the game's frame is copied into could not be created"); return 0; }
+    auto up = std::make_unique<Ls1Upscaler>(b.dev.get(), b.imm4.get(), b.upW, b.upH, b.upFmt, b.upOw, b.upOh, b.upMethod == 2, (int)b.upLevel, 4);
+    if (!up->ok()) { upFail(b, up->error()); return 0; }
+    b.up = std::move(up);
+    b.upStatT = now;
+    b.upFrames = 0; b.upMs = 0;
+  }
+  // start-up: the first run of each shader has to be compiled, which takes seconds: start no more passes while the last are not done
+  if ((f->flags & 1) && b.upOutValue > 0 && MTLSharedEvent_signaledValue(b.upOutEvent) < b.upOutValue) return 0;
+  f->input_texture = metalTexture(b.upInput.get());
+  f->input_event = b.upInEvent;
+  f->input_value = ++b.upInValue;
+  b.upRunning = true;
+  return 1;
+}
+
+/// The caller has copied its picture and committed the signal. Runs the passes: the enlarged picture's Metal texture and the events are filled in. Returns 1 on success.
+__declspec(dllexport) int DXMTUpscaleRun(DXMTUpscaleFrame *f) {
+  if (!f || f->size < sizeof(DXMTUpscaleFrame)) return 0;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (!b.upRunning || !b.up) return 0;
+  b.upRunning = false;
+  auto t0 = std::chrono::steady_clock::now();
+  b.imm4->Wait(b.upInFence.get(), f->input_value);        // the game's picture is in the input texture
+  b.imm4->Wait(b.upDoneFence.get(), b.upDoneWait);         // the caller has copied last time's enlarged picture out
+  std::vector<ID3D11Texture2D *> out;
+  if (!b.up->run(b.upInput.get(), {}, out) || out.size() != 1) { upFail(b, b.up->error().empty() ? std::string("the passes could not run") : b.up->error()); MTLSharedEvent_signalValue(b.upInEvent, f->input_value); return 0; }
+  b.imm4->Signal(b.upOutFence.get(), ++b.upOutValue);
+  b.imm->Flush();
+  b.upMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  b.upFrames++;
+  f->out_texture = metalTexture(out[0]);
+  f->out_event = b.upOutEvent;
+  f->out_value = b.upOutValue;
+  f->done_event = b.upDoneEvent;
+  f->done_value = ++b.upDoneValue;
+  b.upDoneWait = f->done_value;
+  if (!f->out_texture) { MTLSharedEvent_signalValue(b.upDoneEvent, f->done_value); upFail(b, "the enlarged picture has no Metal texture"); return 0; }
+  auto now = std::chrono::steady_clock::now();
+  double secs = std::chrono::duration<double>(now - b.upStatT).count();
+  if (secs >= 5.0) {
+    Logger::info(std::format("[ls-up] (Direct3D 12) {:.1f} s: {} frames, {}x{} -> {}x{} ({}, sharpness {}), the passes cost {:.2f} ms on the present thread per frame", secs, b.upFrames, b.upW, b.upH, b.upOw, b.upOh,
+                             b.upMethod == 2 ? "LS1 performance" : "LS1", b.upLevel + 1, b.upFrames ? b.upMs / (double)b.upFrames : 0.0));
+    b.upStatT = now; b.upFrames = 0; b.upMs = 0;
+  }
+  return 1;
+}
+
+/// The caller could not copy its picture after DXMTUpscaleBegin said yes: nothing waits for it.
+__declspec(dllexport) void DXMTUpscaleAbort(DXMTUpscaleFrame *f) {
+  if (!f) return;
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  b.upRunning = false;
+  if (b.upInEvent) MTLSharedEvent_signalValue(b.upInEvent, f->input_value);
+}
+
+/// 1 when the upscaler has been given up on (it could not be set up, or its passes failed): the caller uses MetalFX; `message` says why (up to cap bytes).
+__declspec(dllexport) int DXMTUpscaleFailed(char *message, uint32_t cap) {
+  Bridge &b = bridge();
+  std::lock_guard<std::mutex> g(b.lock);
+  if (message && cap) { std::snprintf(message, cap, "%s", b.upError.c_str()); }
+  return b.upDead ? 1 : 0;
+}
+}
diff --git a/src/d3d11/d3d11_lsfg_upscale.hpp b/src/d3d11/d3d11_lsfg_upscale.hpp
new file mode 100644
index 0000000..c90779c
--- /dev/null
+++ b/src/d3d11/d3d11_lsfg_upscale.hpp
@@ -0,0 +1,236 @@
+// Porthole 0200: Lossless Scaling's own upscalers (LS1 and LS1 performance), run through the ordinary D3D11 interface.
+//
+// Like the frame generation next to it (d3d11_lsfg.hpp) this uses compiled compute shaders from the owner's own Lossless.dll, which the app writes to a file in the game's prefix
+// while the game runs (only when Steam says the account owns the program). Which shader is which, what each reads and writes and how many thread groups it takes was
+// worked out from the shaders themselves and from how Lossless.dll's own code runs them (reflection data, instruction streams and the program's calls), and checked by running the
+// chain on test pictures offline:
+//   LS1:   shaders 147+3k, 148+3k, 149+3k (k = 0..4, the sharpness level), then 146.
+//          pass 1  input (the game's picture)          -> A  (w x h,   R8G8B8A8_UNORM)
+//          pass 2  A                                   -> B  (w x h,   R8G8B8A8_UNORM)
+//          pass 3  B                                   -> C  (2w x 2h, R8_SNORM: the luminance the network predicts)
+//          pass 4  C and the input (shader 146)        -> output (any size >= the input, bilinear from C and from the input)
+//   LS1_P: shader 141+k writes C directly from the input, then 146 (one network pass instead of three).
+// 16x16 thread groups for all of them. One 48-byte constant buffer for every pass: { in_w, in_h, src_w, src_h, origin_x, origin_y, gamma, 0, out_w, out_h, 0, 0 } (the origin is
+// where the input starts in its texture, `gamma` = 1 treats the input as linear scRGB). One linear clamp sampler.
+#pragma once
+
+#include "d3d11_lsfg.hpp"
+
+namespace dxmt::lsfg {
+
+class Ls1Upscaler {
+public:
+  /// `nOut` pictures can be enlarged per call to run(): the game's own frame and the frames frame generation made.
+  Ls1Upscaler(ID3D11Device *dev, ID3D11DeviceContext4 *imm, UINT w, UINT h, DXGI_FORMAT format, UINT outW, UINT outH, bool performance, int level, size_t nOut)
+      : dev_(dev), imm_(imm), w_(w), h_(h), fmt_(format), ow_(outW), oh_(outH), perf_(performance), level_(std::clamp(level, 0, 4)), nOut_(std::max<size_t>(1, nOut)) {
+    ok_ = build();
+    if (!ok_) {
+      if (error_.empty()) error_ = "a picture, a sampler or a shader could not be created (" + stage_ + ")";
+      Logger::info("[ls-up] could not be set up: " + error_);
+    }
+  }
+  bool ok() const { return ok_; }
+  const std::string &error() const { return error_; }
+  UINT width() const { return w_; }
+  UINT height() const { return h_; }
+  UINT outWidth() const { return ow_; }
+  UINT outHeight() const { return oh_; }
+  size_t capacity() const { return nOut_; }
+  bool performance() const { return perf_; }
+  int level() const { return level_; }
+  DXGI_FORMAT outFormat() const { return outFmt_; }
+
+  /// Enlarges the game's frame (`backbuffer`, null to leave it out) and then each of `extra` (generated frames, which are textures with a shader view). `out` gets one texture per
+  /// picture that was given, in that order (the game's frame first). The game's frame always goes to output 0, the extra pictures to 1, 2, ...
+  /// Everything is recorded on a deferred context and replayed on the game's own.
+  bool run(ID3D11Resource *backbuffer, const std::vector<ID3D11Texture2D *> &extra, std::vector<ID3D11Texture2D *> &out) {
+    out.clear();
+    if (!ok_ || 1 + extra.size() > nOut_) return false;
+    ID3D11DeviceContext *c = def_.get();
+    prev_ = false;
+    setup(c);
+    if (backbuffer) {
+      c->CopyResource(in_.tex.get(), backbuffer);
+      pictures(c, in_.srv.get(), 0);
+    }
+    for (size_t i = 0; i < extra.size(); i++) {
+      ID3D11ShaderResourceView *v = srvFor(extra[i]);
+      if (!v) { clear(c); Ptr<ID3D11CommandList> drop; c->FinishCommandList(FALSE, drop.put()); return false; }
+      pictures(c, v, i + 1);
+    }
+    clear(c);
+    Ptr<ID3D11CommandList> cl;
+    if (FAILED(c->FinishCommandList(FALSE, cl.put()))) {
+      Logger::info("[ls-up] FinishCommandList failed");
+      ok_ = false;
+      error_ = "the engine could not finish the command list";
+      return false;
+    }
+    imm_->ExecuteCommandList(cl.get(), TRUE);
+    if (backbuffer) out.push_back(out_[0].tex.get());
+    for (size_t i = 0; i < extra.size(); i++) out.push_back(out_[i + 1].tex.get());
+    return true;
+  }
+
+private:
+  bool img(Img &i, UINT w, UINT h, DXGI_FORMAT f, UINT bind) {
+    w = std::max(1u, w); h = std::max(1u, h);
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = w; d.Height = h; d.MipLevels = 1; d.ArraySize = 1; d.Format = f; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = bind;
+    if (FAILED(dev_->CreateTexture2D(&d, nullptr, i.tex.put()))) return false;
+    if (bind & D3D11_BIND_SHADER_RESOURCE)
+      if (FAILED(dev_->CreateShaderResourceView(i.tex.get(), nullptr, i.srv.put()))) return false;
+    if (bind & D3D11_BIND_UNORDERED_ACCESS)
+      if (FAILED(dev_->CreateUnorderedAccessView(i.tex.get(), nullptr, i.uav.put()))) return false;
+    i.w = w; i.h = h;
+    return true;
+  }
+
+  ID3D11ComputeShader *shader(uint32_t id) {
+    auto &cache = shaderCache()[dev_];
+    auto it = cache.find(id);
+    if (it != cache.end()) return it->second.get();
+    auto *blob = ShaderStore::get().find(id);
+    if (!blob) { error_ = std::format("shader {} is not in the shader file", id); return nullptr; }
+    Ptr<ID3D11ComputeShader> s;
+    if (FAILED(dev_->CreateComputeShader(blob->data(), blob->size(), nullptr, s.put()))) {
+      error_ = std::format("the engine refused shader {}", id);
+      return nullptr;
+    }
+    return (cache[id] = s).get();
+  }
+
+  bool build() {
+    auto t0 = std::chrono::steady_clock::now();
+    stage_ = "shader file";
+    if (!ShaderStore::get().load()) { error_ = ShaderStore::get().error_; return false; }
+    bool srgb = fmt_ == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || fmt_ == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+    if (fmt_ != DXGI_FORMAT_R8G8B8A8_UNORM && fmt_ != DXGI_FORMAT_B8G8R8A8_UNORM && fmt_ != DXGI_FORMAT_R10G10B10A2_UNORM && fmt_ != DXGI_FORMAT_R16G16B16A16_FLOAT && !srgb) {
+      error_ = std::format("the game's back buffer format ({}) is not supported", (int)fmt_);
+      return false;
+    }
+    // An sRGB back buffer is read through its sRGB view (linear light) and enlarged into 16-bit floats, which the presenter encodes again (as the frame generation does).
+    outFmt_ = srgb ? DXGI_FORMAT_R16G16B16A16_FLOAT : fmt_;
+    gamma_ = fmt_ == DXGI_FORMAT_R16G16B16A16_FLOAT ? 1u : 0u;
+    stage_ = "deferred context";
+    Ptr<ID3D11DeviceContext> d;
+    if (FAILED(dev_->CreateDeferredContext(0, d.put()))) return false;
+    def_ = d;
+    stage_ = "sampler";
+    D3D11_SAMPLER_DESC sd{};
+    sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    sd.MaxLOD = D3D11_FLOAT32_MAX;
+    sd.MaxAnisotropy = 1;
+    if (FAILED(dev_->CreateSamplerState(&sd, smp_.put()))) return false;
+    stage_ = "constant buffer";
+    uint32_t cb[12] = {w_, h_, w_, h_, 0, 0, gamma_, 0, ow_, oh_, 0, 0};
+    D3D11_BUFFER_DESC bd{};
+    bd.ByteWidth = sizeof cb; bd.Usage = D3D11_USAGE_IMMUTABLE; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    D3D11_SUBRESOURCE_DATA sdata{cb, 0, 0};
+    if (FAILED(dev_->CreateBuffer(&bd, &sdata, cb_.put()))) return false;
+    stage_ = "input picture";
+    if (!img(in_, w_, h_, fmt_, D3D11_BIND_SHADER_RESOURCE)) return false;
+    stage_ = "network pictures";
+    const UINT both = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+    if (!perf_) {
+      if (!img(a_, w_, h_, DXGI_FORMAT_R8G8B8A8_UNORM, both) || !img(b_, w_, h_, DXGI_FORMAT_R8G8B8A8_UNORM, both)) return false;
+    }
+    if (!img(c_, 2 * w_, 2 * h_, DXGI_FORMAT_R8_SNORM, both)) return false;
+    stage_ = std::format("output pictures (format {} as an unordered-access view)", (int)outFmt_);
+    out_.assign(nOut_, Img());
+    for (auto &o : out_) if (!img(o, ow_, oh_, outFmt_, both)) return false;
+    stage_ = "shaders";
+    ids_.clear();
+    if (perf_) ids_ = {141u + (uint32_t)level_};
+    else ids_ = {147u + 3u * (uint32_t)level_, 148u + 3u * (uint32_t)level_, 149u + 3u * (uint32_t)level_};
+    ids_.push_back(146);
+    for (uint32_t id : ids_) if (!shader(id)) return false;
+    Logger::info(std::format("[ls-up] ready in {:.0f} ms: {}x{} -> {}x{} format {} ({}, sharpness {}), up to {} pictures a frame", std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(),
+                             w_, h_, ow_, oh_, (int)fmt_, perf_ ? "LS1 performance" : "LS1", level_ + 1, nOut_));
+    return true;
+  }
+
+  ID3D11ShaderResourceView *srvFor(ID3D11Texture2D *t) {
+    for (auto &e : views_)
+      if (e.first.get() == t) return e.second.get();
+    if (views_.size() >= 8) views_.clear();   // frame generation was built again: the old pictures go
+    Ptr<ID3D11ShaderResourceView> v;
+    if (FAILED(dev_->CreateShaderResourceView(t, nullptr, v.put()))) return nullptr;
+    t->AddRef();
+    Ptr<ID3D11Texture2D> keep;
+    *keep.put() = t;   // holds the picture so that its address cannot be reused by another while the view is cached
+    views_.emplace_back(std::move(keep), std::move(v));
+    return views_.back().second.get();
+  }
+
