+/* Porthole (Cycles on Metal), slot 171: GPU binaries built ahead of time. One archive at a time (Cycles loads the one for its kernels). */
+static id<MTLBinaryArchive> g_porthole_archive = nil;
+
+static NTSTATUS
+_MTLDevice_setBinaryArchive(void *obj) {
+  struct unixcall_set_archive *params = obj;
+  params->ret = 0;
+  params->ret_error = 0;
+  char *arch_out = (char *)(uintptr_t)params->arch_out;
+  if (arch_out) arch_out[0] = 0;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  @autoreleasepool {
+    id<MTLDevice> device = (id<MTLDevice>)params->device;
+    if (arch_out) {
+      if (@available(iOS 18.0, macOS 15.0, *)) {
+        const char *name = device.architecture.name.UTF8String;
+        if (name) strlcpy(arch_out, name, 32);
+      }
+    }
+    if (!params->bytes || !params->length) return STATUS_SUCCESS;
+    NSString *path = [NSTemporaryDirectory() stringByAppendingPathComponent:@"porthole-gpu-binaries.bin"];
+    NSData *data = [NSData dataWithBytesNoCopy:(void *)(uintptr_t)params->bytes length:(NSUInteger)params->length freeWhenDone:NO];
+    if (![data writeToFile:path atomically:YES]) return STATUS_UNSUCCESSFUL;
+    MTLBinaryArchiveDescriptor *desc = [[MTLBinaryArchiveDescriptor alloc] init];
+    desc.url = [NSURL fileURLWithPath:path];
+    NSError *err = nil;
+    id<MTLBinaryArchive> archive = [device newBinaryArchiveWithDescriptor:desc error:&err];
+    [desc release];
+    [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+    if (err) params->ret_error = (obj_handle_t)[err retain];
+    if (archive) {
+      if (g_porthole_archive) [g_porthole_archive release];
+      g_porthole_archive = archive;      /* +1, kept */
+      params->ret = 1;
+    }
+  }
+  return STATUS_SUCCESS;
+}
