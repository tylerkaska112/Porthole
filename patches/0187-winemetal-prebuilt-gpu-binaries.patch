+      desc.binaryArchives = @[ g_porthole_archive ];
+      option = MTLPipelineOptionFailOnBinaryArchiveMiss;
+    }
+    id<MTLComputePipelineState> pso = [(id<MTLDevice>)params->device newComputePipelineStateWithDescriptor:desc options:option reflection:nil error:&err];
     params->ret = (obj_handle_t)pso;                      /* +1, released by the caller */
     if (err) params->ret_error = (obj_handle_t)[err retain];
     [desc release];
