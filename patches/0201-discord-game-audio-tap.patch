+/* Porthole game audio tap (Discord branch, patch 0201): the game's own mix, for Discord Go Live. The render callback copies what the game sent (after its volume and the
+ * clamp, before the background mute and before Discord's voice is added, so call voices are not in it) into a lock-free ring of interleaved stereo float frames at the
+ * endpoint's rate; the app reads it (porthole_game_audio_read). Off until the app starts it. Nothing in here blocks the real-time thread. */
+#define PV_TAP_FRAMES 16384u    /* frames, power of two: about 340 ms at 48 kHz */
+static float g_pv_tap[PV_TAP_FRAMES * 2];
+static _Atomic uint64_t g_pv_tap_w, g_pv_tap_r, g_pv_tap_drops;
+static _Atomic int g_pv_tap_on;
 
+static void ios_pv_tap_write(const float *out, UInt32 nframes, UInt32 ch)
+{
+    uint64_t w = atomic_load_explicit(&g_pv_tap_w, memory_order_relaxed);
+    uint64_t r = atomic_load_explicit(&g_pv_tap_r, memory_order_acquire);
+    uint64_t room = PV_TAP_FRAMES - (w - r);
+    uint64_t n = room < nframes ? room : nframes, i;
+    for (i = 0; i < n; i++) {
+        float l = out[i * ch], rr = ch > 1 ? out[i * ch + 1] : l;
+        g_pv_tap[((w + i) & (PV_TAP_FRAMES - 1)) * 2] = l;
+        g_pv_tap[((w + i) & (PV_TAP_FRAMES - 1)) * 2 + 1] = rr;
+    }
+    if (n < nframes) atomic_fetch_add_explicit(&g_pv_tap_drops, nframes - n, memory_order_relaxed);
+    atomic_store_explicit(&g_pv_tap_w, w + n, memory_order_release);
+}
