+/* App: the game's own sound for Go Live (patch 0201). Start empties the ring and turns the tap on; read gives interleaved stereo float frames at porthole_voice_rate(). */
+void porthole_game_audio_start(void)
+{
+    atomic_store_explicit(&g_pv_tap_r, atomic_load_explicit(&g_pv_tap_w, memory_order_acquire), memory_order_release);
+    atomic_store_explicit(&g_pv_tap_drops, 0, memory_order_relaxed);
+    atomic_store_explicit(&g_pv_tap_on, 1, memory_order_release);
+}
+
+void porthole_game_audio_stop(void) { atomic_store_explicit(&g_pv_tap_on, 0, memory_order_release); }
+
+size_t porthole_game_audio_read(float *dst, size_t max_frames)
+{
+    uint64_t r = atomic_load_explicit(&g_pv_tap_r, memory_order_relaxed);
+    uint64_t w = atomic_load_explicit(&g_pv_tap_w, memory_order_acquire);
+    uint64_t avail = w - r;
+    size_t n = avail < max_frames ? (size_t)avail : max_frames, i;
+    for (i = 0; i < n; i++) {
+        dst[i * 2] = g_pv_tap[((r + i) & (PV_TAP_FRAMES - 1)) * 2];
+        dst[i * 2 + 1] = g_pv_tap[((r + i) & (PV_TAP_FRAMES - 1)) * 2 + 1];
+    }
+    atomic_store_explicit(&g_pv_tap_r, r + n, memory_order_release);
     return n;
 }
 
+uint64_t porthole_game_audio_drops(void) { return atomic_load_explicit(&g_pv_tap_drops, memory_order_relaxed); }
