+    udiv(EmitSize, QHat, Rem, Den1);
+    // rhat = rem % den1;
+    msub(EmitSize, RHat, QHat, Den1, Rem);
+    // c1 = qhat * den0;
+    mov(ARMEmitter::Size::i32Bit, Den0, Den);
