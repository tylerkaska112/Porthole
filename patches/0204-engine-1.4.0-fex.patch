diff --git a/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm b/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm
new file mode 100644
index 0000000..0a4713a
--- /dev/null
+++ b/unittests/ASM/X87_F64/FILD_FISTP_I64_Exact_F64.asm
@@ -0,0 +1,47 @@
+%ifdef CONFIG
+{
+  "RegData": {
+    "RAX": "0x84280002320300a8",
+    "RBX": "0x84280002320300a8",
+    "RCX": "0x84280002320300a8",
+    "RSI": "0x8428000232030000"
+  },
+  "Env": { "FEX_X87REDUCEDPRECISION" : "1" }
+}
+%endif
+
+; 32-bit MSVC loads a 64-bit value atomically with fild m64; fistp m64.
+; A double holds 53 bits, so the unchanged value must come back exactly.
+mov rdx, 0xe0000000
+
+mov rax, 0x84280002320300a8
+mov [rdx + 8 * 0], rax
+
+; fild then fistp
+fild qword [rdx + 8 * 0]
+fistp qword [rdx + 8 * 1]
+mov rax, [rdx + 8 * 1]
+
+; fild, moved by fxch, then fisttp
+fild qword [rdx + 8 * 0]
+fld1
+fxch
+fisttp qword [rdx + 8 * 2]
+fstp st0
+mov rbx, [rdx + 8 * 2]
+
+; fild, copied by fld st0, then fistp of the copy
+fild qword [rdx + 8 * 0]
+fld st0
+fistp qword [rdx + 8 * 3]
+fstp st0
+mov rcx, [rdx + 8 * 3]
+
+; A changed value goes through the double: fild, +0, fistp rounds.
+fild qword [rdx + 8 * 0]
+fldz
+faddp
+fistp qword [rdx + 8 * 4]
+mov rsi, [rdx + 8 * 4]
+
+hlt
diff --git a/unittests/ASM/X87_F64/FILD_FISTP_I64_No_Stale_Shadow_F64.asm b/unittests/ASM/X87_F64/FILD_FISTP_I64_No_Stale_Shadow_F64.asm
new file mode 100644
index 0000000..1d39a5c
--- /dev/null
+++ b/unittests/ASM/X87_F64/FILD_FISTP_I64_No_Stale_Shadow_F64.asm
@@ -0,0 +1,29 @@
+%ifdef CONFIG
+{
+  "RegData": { "RAX": "0x0020000000000000" },
+  "Env": { "FEX_X87REDUCEDPRECISION": "1" }
+}
+%endif
+
+; Two values round to the same double. Reuse the physical x87 slot for a
+; double loaded after the integer is popped, then cross a translation block.
+; The earlier integer must not be reused for the later double.
+mov rdi, 0xe0000000
+mov rax, 0x0020000000000001
+mov [rdi], rax
+mov rax, 0x4340000000000000
+mov [rdi + 8], rax
+fild qword [rdi]
+test rdi, rdi
+jz .first
+nop
+.first:
+fstp st0
+fld qword [rdi + 8]
+test rdi, rdi
+jz .second
+nop
+.second:
+fistp qword [rdi + 16]
+mov rax, [rdi + 16]
+hlt
diff --git a/unittests/ASM/X87_F64/FILD_FISTP_I64_Reduced_Blocks_F64.asm b/unittests/ASM/X87_F64/FILD_FISTP_I64_Reduced_Blocks_F64.asm
new file mode 100644
index 0000000..7058274
--- /dev/null
+++ b/unittests/ASM/X87_F64/FILD_FISTP_I64_Reduced_Blocks_F64.asm
@@ -0,0 +1,70 @@
+%ifdef CONFIG
+{
+  "RegData": {
+    "RAX": "0x8428000232030000",
+    "RBX": "0x0047005c003a0044",
+    "RCX": "0x005c00730065006c",
+    "RDX": "0x8428000232030000",
+    "RSI": "0x8428000232030000"
+  },
+  "Env": { "FEX_X87REDUCEDPRECISION" : "1" }
+}
+%endif
+
+; A value crossing a block uses reduced-precision conversion. In particular,
+; do not recover a stale integer from the upper half of the x87 context slot.
+; Exact 64-bit transfers across blocks remain unsupported in reduced mode.
+mov rdi, 0xe0000000
+
+mov rax, 0x84280002320300a8
+mov [rdi + 8 * 0], rax
+mov rax, 0x0047005c003a0043
+mov [rdi + 8 * 1], rax
+mov rax, 0x005c00730065006d
+mov [rdi + 8 * 2], rax
+
+; fild, a branch, fistp
+fild qword [rdi + 8 * 0]
+test rdi, rdi
+jz .a
+nop
+.a:
+fistp qword [rdi + 8 * 3]
+mov rax, [rdi + 8 * 3]
+
+; Delphi's small Move: two loads, a branch, the stores in reverse
+fild qword [rdi + 8 * 1]
+fild qword [rdi + 8 * 2]
+test rdi, rdi
+jz .b
+nop
+.b:
+fistp qword [rdi + 8 * 5]
+fistp qword [rdi + 8 * 4]
+mov rbx, [rdi + 8 * 4]
+mov rcx, [rdi + 8 * 5]
+
+; Delphi's large Move: the first value loaded before a loop, stored after it
+fild qword [rdi + 8 * 0]
+mov r8, 1
+.loop:
+fild qword [rdi + 8 * r8]
+fistp qword [rdi + 8 * 6]
+inc r8
+cmp r8, 3
+jl .loop
+fistp qword [rdi + 8 * 7]
+mov rdx, [rdi + 8 * 7]
+
+; A changed value goes through the double: fild, a branch, +0, fistp rounds.
+fild qword [rdi + 8 * 0]
+test rdi, rdi
+jz .c
+nop
+.c:
+fldz
+faddp
+fistp qword [rdi + 8 * 8]
+mov rsi, [rdi + 8 * 8]
+
+hlt
