+mov edx, 0xbee8
+mov rcx, 16
+clc
+shld ax, dx, cl
+setc cl
+mov r14, rcx
+
+; Test with shrd and immediate
+mov eax, 0x8eeb
+mov edx, 1
+mov rcx, 0
+clc
+shrd ax, dx, 16
+setc cl
+mov r13, rcx
+
+; Test with shrd and CL
+mov eax, 0x8eeb
+mov edx, 1
+mov rcx, 16
+clc
+shrd ax, dx, cl
+setc cl
+mov r12, rcx
+
+hlt
