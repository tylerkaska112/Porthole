index 0000000..3c175d1
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/signal_sra_state.32.cpp
@@ -0,0 +1,126 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <thread>
+
+#pragma GCC diagnostic ignored "-Wattributes"
+
+__attribute__((aligned(16))) constexpr static uint32_t xmm_values[8][4] = {
+  {0x00000001, 0x00000002, 0x00000003, 0x00000004}, {0x00000011, 0x00000012, 0x00000013, 0x00000014},
+  {0x00000021, 0x00000022, 0x00000023, 0x00000024}, {0x00000031, 0x00000032, 0x00000033, 0x00000034},
+  {0x00000041, 0x00000042, 0x00000043, 0x00000044}, {0x00000051, 0x00000052, 0x00000053, 0x00000054},
+  {0x00000061, 0x00000062, 0x00000063, 0x00000064}, {0x00000071, 0x00000072, 0x00000073, 0x00000074},
+};
+
+// 4 GPR slots (2 used + 2 pad for 16-byte alignment) + 32 XMM slots
+static uint32_t results[4 + 32] __attribute__((aligned(16)));
+static volatile int alarm_fired = 0;
+
+static std::atomic<uint32_t> test_ready {};
+
+extern "C" void ContinueAfterSignal();
+
+static void SignalHandler(int signal, siginfo_t* siginfo, void* context) {
+  ucontext_t* _context = (ucontext_t*)context;
+  alarm_fired = 1;
+
+#ifdef REG_RIP
+#define FEX_IP_REG REG_RIP
+#else
+#define FEX_IP_REG REG_EIP
+#endif
+  _context->uc_mcontext.gregs[FEX_IP_REG] = reinterpret_cast<greg_t>(ContinueAfterSignal);
+#undef FEX_IP_REG
+}
+
+// Load GPRs (ECX, EDX) and XMM0-XMM7 with known values, keep them
+// live in SRA with a reload loop. SIGALRM fires asynchronously, the
+// handler modifies EIP, forcing FEX to spill and reload all register
+// state via SpillSRA. After returning, store all registers for comparison.
+__attribute__((nocf_check)) static void LoadRegsLoopAndStore() {
+  __asm volatile(R"(
+    movaps xmm0, [%[v]]
+    movaps xmm1, [%[v]+16]
+    movaps xmm2, [%[v]+32]
+    movaps xmm3, [%[v]+48]
+    movaps xmm4, [%[v]+64]
+    movaps xmm5, [%[v]+80]
+    movaps xmm6, [%[v]+96]
+    movaps xmm7, [%[v]+112]
+
+  .Lloop:
+    mov ecx, 0x89ABCDEF
+    mov edx, 0xFEDCBA98
+
+    movaps xmm0, [%[v]]
+    movaps xmm1, [%[v]+16]
+    movaps xmm2, [%[v]+32]
+    movaps xmm3, [%[v]+48]
+    movaps xmm4, [%[v]+64]
+    movaps xmm5, [%[v]+80]
+    movaps xmm6, [%[v]+96]
+    movaps xmm7, [%[v]+112]
+
+    mov %[test_ready], ecx
+    mov eax, %[alarm]
+    test eax, eax
+    jz .Lloop
+
+    .global ContinueAfterSignal
+  ContinueAfterSignal:
+    mov [%[res]], ecx
+    mov [%[res]+4], edx
+
+    movaps [%[res]+16], xmm0
+    movaps [%[res]+32], xmm1
+    movaps [%[res]+48], xmm2
+    movaps [%[res]+64], xmm3
+    movaps [%[res]+80], xmm4
+    movaps [%[res]+96], xmm5
+    movaps [%[res]+112], xmm6
+    movaps [%[res]+128], xmm7
+  )" ::[v] "r"(&xmm_values),
+                 [alarm] "m"(alarm_fired), [res] "r"(results), [test_ready] "m"(test_ready)
+                 : "memory", "cc", "eax", "ecx", "edx");
+}
+
+static void AlarmThread(int thread_to_alarm) {
+  while (!test_ready.load())
+    ;
+  tgkill(::getpid(), thread_to_alarm, SIGALRM);
+}
+
+TEST_CASE("Signals: Register state preserved across async signal with SRA") {
+  struct sigaction act {};
+  act.sa_sigaction = SignalHandler;
+  act.sa_flags = SA_SIGINFO;
+  sigaction(SIGALRM, &act, nullptr);
+
+  alarm_fired = 0;
+  memset(results, 0, sizeof(results));
+
+  std::thread t(AlarmThread, ::gettid());
+  LoadRegsLoopAndStore();
+
+  REQUIRE(alarm_fired == 1);
+
+  CHECK(results[0] == 0x89ABCDEF);
+  CHECK(results[1] == 0xFEDCBA98);
+
+  for (int i = 0; i < 8; i++) {
+    for (int j = 0; j < 4; j++) {
+      uint32_t val = results[4 + i * 4 + j];
+      if (val != xmm_values[i][j]) {
+        printf("XMM%d[%d] = 0x%08x, expected 0x%08x\n", i, j, val, xmm_values[i][j]);
+      }
+      CHECK(val == xmm_values[i][j]);
+    }
+  }
+
+  t.join();
+}
diff --git a/unittests/FEXLinuxTests/tests/signal/sigtest_resethandler.cpp b/unittests/FEXLinuxTests/tests/signal/sigtest_resethandler.cpp
new file mode 100644
index 0000000..8cbd3d6
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/sigtest_resethandler.cpp
@@ -0,0 +1,184 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/wait.h>
+#include <thread>
+
+void sig_handler(int signum, siginfo_t* info, void* context) {
+  printf("Inside handler function\n");
+}
+
+TEST_CASE("Signals: Check waitpid works") {
+  int pid = ::fork();
+  if (pid == 0) {
+    _exit(0);
+  }
+
+  int status {};
+  auto res = ::waitpid(pid, &status, 0);
+  REQUIRE(res != -1);
+  CHECK(WIFEXITED(status));
+  CHECK(WEXITSTATUS(status) == 0);
+}
+
+TEST_CASE("Signals: Check terminate works.") {
+  int pid = ::fork();
+  if (pid == 0) {
+    // Reset Catch2's signal handler for this fork.
+    struct sigaction act = {};
+    act.sa_flags = 0;
+    act.sa_handler = SIG_DFL;
+    REQUIRE(sigaction(SIGTERM, &act, nullptr) == 0);
+
+    ::tgkill(::getpid(), ::gettid(), SIGTERM);
+  }
+
+  int status {};
+  auto res = ::waitpid(pid, &status, 0);
+  REQUIRE(res != -1);
+  CHECK(!WIFEXITED(status));
+  CHECK(WIFSIGNALED(status));
+  CHECK(WTERMSIG(status) == SIGTERM);
+}
+
+TEST_CASE("Signals: Check flags.") {
+  constexpr static uint32_t SIGNAL_FLAGS = SA_SIGINFO | SA_NODEFER;
+
+  int pid = ::fork();
+  if (pid == 0) {
+    static struct sigaction act = {};
+    auto sig_handler = [](int signum, siginfo_t* info, void* context) -> void {
+      REQUIRE(sigaction(SIGTERM, nullptr, &act) == 0);
+    };
+
+    // Reset Catch2's signal handler for this fork.
+    act.sa_flags = SIGNAL_FLAGS;
+    act.sa_sigaction = sig_handler;
+    REQUIRE(sigaction(SIGTERM, &act, nullptr) == 0);
+
+    ::tgkill(::getpid(), ::gettid(), SIGTERM);
+
+#define SA_RESTORER 0x04000000
+    if ((act.sa_flags & ~SA_RESTORER) != SIGNAL_FLAGS) {
+      _exit(1);
+    }
+
+    if (act.sa_sigaction != sig_handler) {
+      _exit(1);
+    }
+
+    _exit(0);
+  }
+
+  int status {};
+  auto res = ::waitpid(pid, &status, 0);
+  REQUIRE(res != -1);
+  CHECK(WIFEXITED(status));
+  CHECK(WEXITSTATUS(status) == 0);
+}
+
+TEST_CASE("Signals: Check flags reset handler.") {
+  constexpr static uint32_t SIGNAL_FLAGS = SA_SIGINFO | SA_NODEFER | SA_RESETHAND;
+
+  int pid = ::fork();
+  if (pid == 0) {
+    static struct sigaction act = {};
+    auto sig_handler = [](int signum, siginfo_t* info, void* context) -> void {
+      REQUIRE(sigaction(SIGTERM, nullptr, &act) == 0);
+    };
+
+    // Reset Catch2's signal handler for this fork.
+    act.sa_flags = SIGNAL_FLAGS;
+    act.sa_sigaction = sig_handler;
+    REQUIRE(sigaction(SIGTERM, &act, nullptr) == 0);
+
+    ::tgkill(::getpid(), ::gettid(), SIGTERM);
+
+#define SA_RESTORER 0x04000000
+    // With SA_RESETHAND, sa_handler resets to SIG_DFL but everything else stays the same.
+    REQUIRE((act.sa_flags & ~SA_RESTORER) == SIGNAL_FLAGS);
+    REQUIRE(act.sa_handler == SIG_DFL);
+    _exit(0);
+  }
+
+  int status {};
+  auto res = ::waitpid(pid, &status, 0);
+  REQUIRE(res != -1);
+  CHECK(WIFEXITED(status));
+  CHECK(WEXITSTATUS(status) == 0);
+}
+
+TEST_CASE("Signals: Check flags reset handler ignore.") {
+  // SIGWINCH by default is type SIG_DFL but that means SIG_IGN in the kernel.
+  // Ensure SA_RESETHAND resets it to SIG_DFL, not SIG_IGN.
+  constexpr static uint32_t SIGNAL_FLAGS = SA_SIGINFO | SA_NODEFER | SA_RESETHAND;
+
+  int pid = ::fork();
+  if (pid == 0) {
+    static struct sigaction act = {};
+    auto sig_handler = [](int signum, siginfo_t* info, void* context) -> void {
+      REQUIRE(sigaction(SIGWINCH, nullptr, &act) == 0);
+    };
+
+    // Reset Catch2's signal handler for this fork.
+    act.sa_flags = SIGNAL_FLAGS;
+    act.sa_sigaction = sig_handler;
+    REQUIRE(sigaction(SIGWINCH, &act, nullptr) == 0);
+
+    ::tgkill(::getpid(), ::gettid(), SIGWINCH);
+
+#define SA_RESTORER 0x04000000
+    // With SA_RESETHAND, sa_handler resets to SIG_DFL but everything else stays the same.
+    REQUIRE((act.sa_flags & ~SA_RESTORER) == SIGNAL_FLAGS);
+    REQUIRE(act.sa_handler == SIG_DFL);
+    _exit(0);
+  }
+
+  int status {};
+  auto res = ::waitpid(pid, &status, 0);
+  REQUIRE(res != -1);
+  CHECK(WIFEXITED(status));
+  CHECK(WEXITSTATUS(status) == 0);
+}
+
+TEST_CASE("Signals: Check flags reset handler thread.") {
+  constexpr static uint32_t SIGNAL_FLAGS = SA_SIGINFO | SA_NODEFER | SA_RESETHAND;
+
+  static struct sigaction act = {};
+  static struct sigaction orig_act = {};
+
+  auto sig_handler = [](int signum, siginfo_t* info, void* context) -> void {
+    REQUIRE(sigaction(SIGTERM, nullptr, &act) == 0);
+  };
+
+  // Reset Catch2's signal handler for this fork.
+  act.sa_flags = SIGNAL_FLAGS;
+  act.sa_sigaction = sig_handler;
+  REQUIRE(sigaction(SIGTERM, &act, &orig_act) == 0);
+
+  std::thread t([]() {
+    ::tgkill(::getpid(), ::gettid(), SIGTERM);
+
+#define SA_RESTORER 0x04000000
+    // With SA_RESETHAND, sa_handler resets to SIG_DFL but everything else stays the same.
+    REQUIRE((act.sa_flags & ~SA_RESTORER) == SIGNAL_FLAGS);
+    REQUIRE(act.sa_handler == SIG_DFL);
+  });
+
+  // DFL switch should be visible from parent thread.
+  static struct sigaction act_parent = {};
+  while (sigaction(SIGTERM, nullptr, &act_parent) == 0) {
+    if (act_parent.sa_handler == SIG_DFL) {
+      fprintf(stderr, "Hit DFL!\n");
+      break;
+    }
+  }
+
+  t.join();
+
+  // Set the original handler back for any remaining tests.
+  REQUIRE(sigaction(SIGTERM, &orig_act, nullptr) == 0);
+}
diff --git a/unittests/FEXLinuxTests/tests/syscalls/consecutive_syscalls.cpp b/unittests/FEXLinuxTests/tests/syscalls/consecutive_syscalls.cpp
new file mode 100644
index 0000000..520db3e
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/syscalls/consecutive_syscalls.cpp
@@ -0,0 +1,34 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <sys/syscall.h>
+#include <unistd.h>
+
+// Regression test for issue #5942. Not ending the block after a syscall
+// can cause the register state to be incorrect afterwards, demonstrated here
+// by running two syscalls in a row in the same block.
+TEST_CASE("Two syscalls in one block") {
+  long Result {};
+#ifdef __x86_64__
+  __asm volatile(R"(
+    mov eax, %[GetPPid]
+    syscall
+    mov eax, %[GetPPid]
+    syscall
+  )"
+                 : "=a"(Result)
+                 : [GetPPid] "i"(SYS_getppid)
+                 : "rcx", "r11", "memory");
+#else
+  __asm volatile(R"(
+    mov eax, %[GetPPid]
+    int 0x80
+    mov eax, %[GetPPid]
+    int 0x80
+  )"
+                 : "=a"(Result)
+                 : [GetPPid] "i"(SYS_getppid)
+                 : "memory");
+#endif
+
+  CHECK(Result == ::getppid());
+}
diff --git a/unittests/FEXLinuxTests/tests/syscalls/rlimit_data_pthread.cpp b/unittests/FEXLinuxTests/tests/syscalls/rlimit_data_pthread.cpp
new file mode 100644
index 0000000..c528bee
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/syscalls/rlimit_data_pthread.cpp
@@ -0,0 +1,42 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <pthread.h>
+#include <sys/resource.h>
+#include <unistd.h>
+
+static void* ThreadFunc(void* Arg) {
+  auto Semaphore = static_cast<std::atomic<bool>*>(Arg);
+  while (*Semaphore) {
+    // Sleep for a bit to avoid thrashing.
+    usleep(100'000);
+  }
+  return nullptr;
+}
+
+// NB: At present, empirical testing shows that we can
+// actually set this to ~45, and still pass. To give us wiggle room for
+// any other per thread overhead let's set it to a nice round number instead.
+#define NUM_THREADS 32
+
+// Chromium's sandbox lowers RLIMIT_DATA to 16GB and then spawns threads.
+// Historically, FEX would allocate a several TB writtable region
+// for its host stack, which would blow past this limit.
+TEST_CASE("pthread_create after lowering RLIMIT_DATA") {
+  rlimit64 Limit {
+    .rlim_cur = 16ULL * 1024 * 1024 * 1024,
+    .rlim_max = 16ULL * 1024 * 1024 * 1024,
+  };
+  REQUIRE(setrlimit64(RLIMIT_DATA, &Limit) == 0);
+
+  pthread_t Threads[NUM_THREADS];
+  std::atomic<bool> Semaphore = true;
+  for (int i = 0; i < NUM_THREADS; ++i) {
+    REQUIRE(pthread_create(&Threads[i], nullptr, ThreadFunc, &Semaphore) == 0);
+  }
+
+  Semaphore = false;
+  for (int i = 0; i < NUM_THREADS; ++i) {
+    CHECK(pthread_join(Threads[i], nullptr) == 0);
+  }
+}
diff --git a/unittests/FEXLinuxTests/tests/syscalls/stat_efault.32.cpp b/unittests/FEXLinuxTests/tests/syscalls/stat_efault.32.cpp
new file mode 100644
index 0000000..d475b17
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/syscalls/stat_efault.32.cpp
@@ -0,0 +1,49 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/statfs.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define CHECK_EFAULT(Expr)  \
+  do {                      \
+    REQUIRE((Expr) == -1);  \
+    CHECK(errno == EFAULT); \
+  } while (0)
+
+#define CHECK_ENOENT(Expr)  \
+  do {                      \
+    REQUIRE((Expr) == -1);  \
+    CHECK(errno == ENOENT); \
+  } while (0)
+
+TEST_CASE("stat et al. returns EFAULT for null pointers") {
+  int FD = ::open("/", O_RDONLY);
+  CHECK_EFAULT(::syscall(SYS_oldstat, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_oldfstat, FD, nullptr));
+  CHECK_EFAULT(::syscall(SYS_oldlstat, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_stat, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_fstat, FD, nullptr));
+  CHECK_EFAULT(::syscall(SYS_lstat, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_stat64, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_lstat64, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_fstat64, FD, nullptr));
+  CHECK_EFAULT(::syscall(SYS_statfs, "/", nullptr));
+  CHECK_EFAULT(::syscall(SYS_fstatfs, FD, nullptr));
+  CHECK_EFAULT(::syscall(SYS_fstatfs64, FD, sizeof(struct statfs64), nullptr));
+  CHECK_EFAULT(::syscall(SYS_statfs64, "/", sizeof(struct statfs64), nullptr));
+  CHECK_EFAULT(::syscall(SYS_fstatat64, AT_FDCWD, "/", nullptr, 0));
+}
+
+TEST_CASE("stat et al. returns ENOENT for missing paths with null buffers") {
+  CHECK_ENOENT(::syscall(SYS_oldstat, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_oldlstat, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_stat, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_lstat, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_stat64, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_lstat64, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_statfs, "/does/not/exist", nullptr));
+  CHECK_ENOENT(::syscall(SYS_statfs64, "/does/not/exist", sizeof(struct statfs64), nullptr));
+  CHECK_ENOENT(::syscall(SYS_fstatat64, AT_FDCWD, "/does/not/exist", nullptr, 0));
+}
