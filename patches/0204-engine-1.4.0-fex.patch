diff --git a/unittests/FEXLinuxTests/tests/signal/dead_flags_load_fault.cpp b/unittests/FEXLinuxTests/tests/signal/dead_flags_load_fault.cpp
new file mode 100644
index 0000000..764f1e5
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/dead_flags_load_fault.cpp
@@ -0,0 +1,44 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <csetjmp>
+#include <signal.h>
+#include <stdint.h>
+
+// A compare against memory whose flags are never read still has to perform
+// the load, because the load can fault. HotSpot's C1 relies on this for its
+// explicit null checks: `cmp rax, [reg]` with the flags dead, and the SIGSEGV
+// at that address becomes the NullPointerException. FEX used to remove the
+// load together with the dead flag calculation, so the null receiver went on
+// to fault at a later instruction instead.
+
+static sigjmp_buf JumpBuffer;
+static volatile int Faulted;
+
+static void SIGSEGVHandler(int, siginfo_t*, void*) {
+  Faulted = 1;
+  siglongjmp(JumpBuffer, 1);
+}
+
+TEST_CASE("Signals: load with dead flags still faults") {
+  struct sigaction act {};
+  act.sa_sigaction = SIGSEGVHandler;
+  act.sa_flags = SA_SIGINFO;
+  sigaction(SIGSEGV, &act, nullptr);
+
+  uint32_t Counter = 0;
+  uintptr_t Null = 0;
+  Faulted = 0;
+
+  if (sigsetjmp(JumpBuffer, 1) == 0) {
+    // The add overwrites every flag the compare produced, so only the
+    // fault from the load is observable.
+    __asm volatile("cmp %[Null], [%[Null]];"
+                   "add dword ptr [%[Counter]], 1;"
+                   :
+                   : [Null] "r"(Null), [Counter] "r"(&Counter)
+                   : "cc", "memory");
+  }
+
+  CHECK(Faulted == 1);
+  CHECK(Counter == 0);
+}
diff --git a/unittests/FEXLinuxTests/tests/signal/instruction_fetch_fault.64.cpp b/unittests/FEXLinuxTests/tests/signal/instruction_fetch_fault.64.cpp
new file mode 100644
index 0000000..98b9e00
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/instruction_fetch_fault.64.cpp
@@ -0,0 +1,52 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <signal.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <csetjmp>
+#include <cstdint>
+
+static jmp_buf LongJump {};
+static volatile sig_atomic_t CaughtSignal {};
+
+static void SignalHandler(int Signal, siginfo_t*, void*) {
+  CaughtSignal = Signal;
+  longjmp(LongJump, 1);
+}
+
+TEST_CASE("Signals: Instruction fetch faults take priority over decode errors") {
+  struct sigaction Act {};
+  Act.sa_sigaction = SignalHandler;
+  Act.sa_flags = SA_SIGINFO;
+
+  REQUIRE(sigaction(SIGILL, &Act, nullptr) == 0);
+  REQUIRE(sigaction(SIGSEGV, &Act, nullptr) == 0);
+
+  const auto PageSize = sysconf(_SC_PAGESIZE);
+  REQUIRE(PageSize > 0);
+
+  void* Ptr = mmap(nullptr, PageSize * 2, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  REQUIRE(Ptr != MAP_FAILED);
+
+  auto Code = static_cast<uint8_t*>(Ptr) + PageSize - 2;
+  // movzx r8d, byte [rax]
+  Code[0] = 0x44;
+  Code[1] = 0x0f;
+  Code[2] = 0xb6;
+  Code[3] = 0x00;
+  Code[4] = 0xc3;
+
+  REQUIRE(mprotect(static_cast<uint8_t*>(Ptr) + PageSize, PageSize, PROT_NONE) == 0);
+
+  using FuncPtr = void (*)();
+  auto Func = reinterpret_cast<FuncPtr>(Code);
+
+  CaughtSignal = 0;
+  if (setjmp(LongJump) == 0) {
+    Func();
+    FAIL("Cross-page instruction unexpectedly executed");
+  }
+
+  CHECK(CaughtSignal == SIGSEGV);
+  REQUIRE(munmap(Ptr, PageSize * 2) == 0);
+}
diff --git a/unittests/FEXLinuxTests/tests/signal/invalid_group1_82.64.cpp b/unittests/FEXLinuxTests/tests/signal/invalid_group1_82.64.cpp
new file mode 100644
index 0000000..f9e7903
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/invalid_group1_82.64.cpp
@@ -0,0 +1,54 @@
+#include "invalid_util.h"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <signal.h>
+
+// In 32-bit mode 0x82 is an alias of the 0x80 group 1 encoding.
+// In 64-bit mode it is an invalid opcode and must raise SIGILL,
+// which this test verifies.
+
+#define TEST(name, ...)                                                     \
+  TEST_CASE("Signals: Invalid 0x82 " name) {                                \
+    struct sigaction act {};                                                \
+    act.sa_sigaction = CapturingHandler;                                    \
+    act.sa_flags = SA_SIGINFO;                                              \
+    sigaction(SIGILL, &act, nullptr);                                       \
+                                                                            \
+    from_handler.reset();                                                   \
+    capturing_handler_skip = sizeof((const unsigned char[]) {__VA_ARGS__}); \
+    __asm volatile(".byte " #__VA_ARGS__ ::: "memory");                     \
+                                                                            \
+    REQUIRE(from_handler.has_value());                                      \
+    CHECK(from_handler->signal == SIGILL);                                  \
+  }
+
+// <op> byte [rax], 0x12
+TEST("/0 add mem", 0x82, 0x00, 0x12);
+TEST("/1 or mem", 0x82, 0x08, 0x12);
+TEST("/2 adc mem", 0x82, 0x10, 0x12);
+TEST("/3 sbb mem", 0x82, 0x18, 0x12);
+TEST("/4 and mem", 0x82, 0x20, 0x12);
+TEST("/5 sub mem", 0x82, 0x28, 0x12);
+TEST("/6 xor mem", 0x82, 0x30, 0x12);
+TEST("/7 cmp mem", 0x82, 0x38, 0x12);
+
+// lock <op> byte [rax], 0x12
+TEST("/0 lock add mem", 0xf0, 0x82, 0x00, 0x12);
+TEST("/1 lock or mem", 0xf0, 0x82, 0x08, 0x12);
+TEST("/2 lock adc mem", 0xf0, 0x82, 0x10, 0x12);
+TEST("/3 lock sbb mem", 0xf0, 0x82, 0x18, 0x12);
+TEST("/4 lock and mem", 0xf0, 0x82, 0x20, 0x12);
+TEST("/5 lock sub mem", 0xf0, 0x82, 0x28, 0x12);
+TEST("/6 lock xor mem", 0xf0, 0x82, 0x30, 0x12);
+TEST("/7 lock cmp mem", 0xf0, 0x82, 0x38, 0x12);
+
+// <op> al, 0x12
+TEST("/0 add reg", 0x82, 0xc0, 0x12);
+TEST("/1 or reg", 0x82, 0xc8, 0x12);
+TEST("/2 adc reg", 0x82, 0xd0, 0x12);
+TEST("/3 sbb reg", 0x82, 0xd8, 0x12);
+TEST("/4 and reg", 0x82, 0xe0, 0x12);
+TEST("/5 sub reg", 0x82, 0xe8, 0x12);
+TEST("/6 xor reg", 0x82, 0xf0, 0x12);
+TEST("/7 cmp reg", 0x82, 0xf8, 0x12);
diff --git a/unittests/FEXLinuxTests/tests/signal/partial_decode_failure.cpp b/unittests/FEXLinuxTests/tests/signal/partial_decode_failure.cpp
new file mode 100644
index 0000000..3a032b2
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/partial_decode_failure.cpp
@@ -0,0 +1,155 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+#include <signal.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <cstdint>
+#include <optional>
+
+// FEX-Emu had a bug where partially decoded instruction faults weren't returning the correct data in the signal handler.
+// Simple test that pushes a 7-byte NOP and a RET instruction across a RWX+RW page boundary to ensure correct fault addresses.
+extern "C" {
+__attribute__((naked, nocf_check)) void Ret() {
+  __asm volatile(R"(
+    .global RetInstruction
+    RetInstruction:
+    ret;
+    )");
+}
+
+extern void* RetInstruction;
+}
+
+struct ReturnDataStruct {
+  int Signal {};
+  size_t FaultRIP {};
+  size_t FaultAddr {};
+};
+
+std::optional<ReturnDataStruct> SignalReturnData {};
+
+static void SignalHandler(int signal, siginfo_t* siginfo, void* context) {
+  ucontext_t* _context = (ucontext_t*)context;
+
+#ifdef REG_RIP
+#define FEX_IP_REG REG_RIP
+#else
+#define FEX_IP_REG REG_EIP
+#endif
+
+  SignalReturnData = ReturnDataStruct {
+    .Signal = signal,
+    .FaultRIP = static_cast<size_t>(_context->uc_mcontext.gregs[FEX_IP_REG]),
+    .FaultAddr = reinterpret_cast<size_t>(siginfo->si_addr),
+  };
+
+  _context->uc_mcontext.gregs[FEX_IP_REG] = reinterpret_cast<greg_t>(&RetInstruction);
+#undef FEX_IP_REG
+}
+
+TEST_CASE("Partial Fault requires correct data") {
+  struct sigaction Act {};
+  Act.sa_sigaction = SignalHandler;
+  Act.sa_flags = SA_SIGINFO;
+
+  REQUIRE(sigaction(SIGILL, &Act, nullptr) == 0);
+  REQUIRE(sigaction(SIGSEGV, &Act, nullptr) == 0);
+
+  const auto PageSize = sysconf(_SC_PAGESIZE);
+  REQUIRE(PageSize > 0);
+
+  void* Ptr = mmap(nullptr, PageSize * 2, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  REQUIRE(Ptr != MAP_FAILED);
+
+  REQUIRE(mprotect(static_cast<uint8_t*>(Ptr) + PageSize, PageSize, PROT_READ | PROT_WRITE) == 0);
+
+  constexpr std::array<uint8_t, 8> NOPData = {
+    0x0f, 0x18, 0x25, 0, 0, 0, 0, // nop dword [rip + Index]
+    0xc3,                         // ret
+  };
+
+  struct ResultsStruct {
+    bool ShouldFault {};
+    std::optional<ReturnDataStruct> Result {};
+  };
+
+  std::array<ResultsStruct, NOPData.size() + 1> TestResults {{
+    // Both instructions inside the executable page, won't fault.
+    {false, std::nullopt},
+
+    // Faults on the `ret` on the page boundary, which means FaultRIP == FaultAddr.
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    // Starts faulting in the middle of nop instruction decode.
+    // FaultAddr is always on the page boundary, but FaultRIP is where the instruction begins.
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 6,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 5,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 4,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 3,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 2,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize - 1,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+    // NOP Instruction is fully inside the RW page, so matches again.
+    {true,
+     ReturnDataStruct {
+       .Signal = SIGSEGV,
+       .FaultRIP = reinterpret_cast<size_t>(Ptr) + PageSize,
+       .FaultAddr = reinterpret_cast<size_t>(Ptr) + PageSize,
+     }},
+  }};
+
+  for (size_t i = 0; i < TestResults.size(); ++i) {
+    auto& TestResult = TestResults[i];
+    uint8_t* Code = static_cast<uint8_t*>(Ptr) + PageSize - NOPData.size() + i;
+    memcpy(Code, NOPData.data(), NOPData.size());
+
+    using FuncPtr = void (*)();
+    auto Func = reinterpret_cast<FuncPtr>(Code);
+
+    SignalReturnData.reset();
+    Func();
+
+    auto Result = SignalReturnData;
+
+    REQUIRE(TestResult.ShouldFault == Result.has_value());
+    if (TestResult.ShouldFault) {
+      CHECK(TestResult.Result->Signal == Result->Signal);
+      CHECK(TestResult.Result->FaultRIP == Result->FaultRIP);
+      CHECK(TestResult.Result->FaultAddr == Result->FaultAddr);
+    }
+  }
+}
diff --git a/unittests/FEXLinuxTests/tests/signal/siglongjmp_branch_invalid.64.cpp b/unittests/FEXLinuxTests/tests/signal/siglongjmp_branch_invalid.64.cpp
new file mode 100644
index 0000000..01af2da
--- /dev/null
+++ b/unittests/FEXLinuxTests/tests/signal/siglongjmp_branch_invalid.64.cpp
@@ -0,0 +1,54 @@
+// If guest code registers a signal handler that does not sigreturn,
+// then deadlocks internal to FEX are possible if the guest code jumps to an invalid address.
+// This test checks that FEX does not deadlock in this case.
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <csetjmp>
+#include <cstdint>
+
+#include <signal.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+static sigjmp_buf FaultReturn;
+
+static void Handler(int, siginfo_t*, void*) {
+  siglongjmp(FaultReturn, 1);
+}
+
+TEST_CASE("Signals: siglongjmp from signal handler after branch to invalid address") {
+  struct sigaction Act {};
+  Act.sa_sigaction = Handler;
+  Act.sa_flags = SA_SIGINFO | SA_NODEFER;
+  sigemptyset(&Act.sa_mask);
+
+  REQUIRE(sigaction(SIGSEGV, &Act, nullptr) == 0);
+  REQUIRE(sigaction(SIGBUS, &Act, nullptr) == 0);
+  REQUIRE(sigaction(SIGILL, &Act, nullptr) == 0);
+
+  const int64_t PageSize = sysconf(_SC_PAGESIZE);
+  REQUIRE(PageSize > 0);
+
+  // Branch to a range of addresses around 0.
+  int64_t Faults = 0;
+  const int64_t Range = 2 * PageSize;
+
+  for (int64_t Offset = -Range; Offset <= Range; ++Offset) {
+    if (sigsetjmp(FaultReturn, 1) == 0) {
+      reinterpret_cast<void (*)()>(static_cast<uintptr_t>(Offset))();
+      FAIL("branch to invalid address did not fault");
+    } else {
+      Faults++;
+    }
+  }
+
+  CHECK(Faults == 2 * Range + 1);
+
+  // Force code invalidation so that we take the lock
+  void* Code = mmap(nullptr, PageSize, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  REQUIRE(Code != MAP_FAILED);
+  REQUIRE(munmap(Code, PageSize) == 0);
+
+  SUCCEED();
+}
diff --git a/unittests/FEXLinuxTests/tests/signal/signal_sra_state.32.cpp b/unittests/FEXLinuxTests/tests/signal/signal_sra_state.32.cpp
