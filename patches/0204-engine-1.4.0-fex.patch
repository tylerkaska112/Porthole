+FEX_DEFAULT_VISIBILITY bool RecursiveRemoveDirectory(const fextl::string& Directory) {
+  return RecursiveRemoveDirectoryApple(Directory) && (::rmdir(Directory.c_str()) == 0 || errno == ENOENT);
