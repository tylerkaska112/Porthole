+%ifdef CONFIG
+{
+  "HostFeatures": ["AVX"],
+  "RegData": {
+    "RAX": "0x000000000472cfe5",
+    "RBX": "0x000000005d5b4dc3"
+  }
+}
+%endif
+
+mov rax, 0
+mov rbx, 0
+
+%assign i 0
+%rep 256
+
+; vpermilps all the immediate encodings
+
+; 256-bit
+vpermilps ymm0, [rel .random_data + ((i * 32) % 4096)], i
+vmovaps [rel .data_result + (i * 32)], ymm0
+
+; 128-bit
+vpermilps xmm1, [rel .random_data + ((i * 16) % 4096)], i
+vmovaps [rel .data_result2 + (i * 16)], xmm1
+
+; CRC32 (by 64) the results
+crc32 rax, qword [rel .data_result + (i * 32) + 0]
+crc32 rax, qword [rel .data_result + (i * 32) + 8]
+crc32 rax, qword [rel .data_result + (i * 32) + 16]
+crc32 rax, qword [rel .data_result + (i * 32) + 24]
+
+crc32 rbx, qword [rel .data_result2 + (i * 16) + 0]
+crc32 rbx, qword [rel .data_result2 + (i * 16) + 8]
+%assign i i+1
+%endrep
+
+hlt
