+  REQUIRE(set.size_in_bits() == size_bits);
+
+  // Basic allocation check.
+  auto slot = set.allocate(1);
+  REQUIRE(slot != set.invalid());
+  CHECK(slot == 0);
+
+  set.free(slot, 1);
+
+  CHECK(CheckMemoryIsZero(buf.ptr, size));
+
+  FreeProtectedBuffer(buf);
+}
