+
+crc32 rbx, qword [rel .data_result2 + (i * 16) + 0]
+crc32 rbx, qword [rel .data_result2 + (i * 16) + 8]
+%assign i i+1
+%endrep
+
+hlt
+
+align 4096
+.data_result:
+times 16 dq 0, 0, 0, 0
+
+align 4096
+.data_result2:
