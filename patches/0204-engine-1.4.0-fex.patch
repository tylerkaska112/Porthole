+  }
+}
+%endif
+
+mov rax, 0
+mov rbx, 0
+
+%assign i 0
+%rep 16
+
+; vblendpd all the immediate encodings
+
+; 256-bit
+vmovaps ymm1, [rel .random_data2 + ((i * 32) % 4096)]
+vblendpd ymm0, ymm1, [rel .random_data + ((i * 32) % 4096)], i
+vmovaps [rel .data_result + (i * 32)], ymm0
+
+; 128-bit
+vmovaps xmm3, [rel .random_data2 + ((i * 16) % 4096)]
+vblendpd xmm2, xmm3, [rel .random_data + ((i * 16) % 4096)], i
+vmovaps [rel .data_result2 + (i * 16)], xmm2
