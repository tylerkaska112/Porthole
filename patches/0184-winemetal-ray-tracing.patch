+/* Porthole (Cycles on Metal), slots 161-164: ray tracing. Local rendering only. */
+static MTLAccelerationStructureDescriptor *
+wmt_accel_descriptor(const struct WMTAccelInfo *info) {
+  MTLAccelerationStructureDescriptor *desc = nil;
+  if (info->kind == WMT_ACCEL_KIND_PRIMITIVE) {
+    MTLPrimitiveAccelerationStructureDescriptor *p = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+    NSMutableArray *geometries = [NSMutableArray arrayWithCapacity:info->count];
+    const struct WMTAccelTriangles *t = (const void *)(uintptr_t)info->geometries;
+    for (uint32_t i = 0; t && i < info->count; i++) {
+      MTLAccelerationStructureTriangleGeometryDescriptor *g = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+      g.vertexBuffer = (id<MTLBuffer>)t[i].vertex_buffer;
+      g.vertexBufferOffset = t[i].vertex_offset;
+      g.vertexStride = t[i].vertex_stride;
+      if (t[i].index_buffer) {
+        g.indexBuffer = (id<MTLBuffer>)t[i].index_buffer;
+        g.indexBufferOffset = t[i].index_offset;
+        g.indexType = t[i].index_type ? MTLIndexTypeUInt32 : MTLIndexTypeUInt16;
+      }
+      g.triangleCount = t[i].triangle_count;
+      g.opaque = (t[i].flags & 1u) != 0;
+      g.allowDuplicateIntersectionFunctionInvocation = (t[i].flags & 2u) != 0;
+      g.intersectionFunctionTableOffset = t[i].intersection_function_table_offset;
+      [geometries addObject:g];
+    }
+    p.geometryDescriptors = geometries;
+    desc = p;
+  } else {
+    MTLInstanceAccelerationStructureDescriptor *d = [MTLInstanceAccelerationStructureDescriptor descriptor];
+    d.instanceCount = info->count;
+    d.instanceDescriptorBuffer = (id<MTLBuffer>)info->instance_buffer;
+    d.instanceDescriptorBufferOffset = info->instance_buffer_offset;
+    if (info->instance_descriptor_type == 1) {
+      d.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeUserID;
+      d.instanceDescriptorStride = sizeof(MTLAccelerationStructureUserIDInstanceDescriptor);
+    } else {
+      d.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeDefault;
+      d.instanceDescriptorStride = sizeof(MTLAccelerationStructureInstanceDescriptor);
+    }
+    NSMutableArray *structures = [NSMutableArray arrayWithCapacity:info->instanced_count];
+    const obj_handle_t *handles = (const void *)(uintptr_t)info->instanced_structures;
+    for (uint32_t i = 0; handles && i < info->instanced_count; i++) [structures addObject:(id<MTLAccelerationStructure>)handles[i]];
+    d.instancedAccelerationStructures = structures;
+    desc = d;
+  }
+  desc.usage = (MTLAccelerationStructureUsage)info->usage;
+  return desc;
+}
+
+static NTSTATUS
+_MTLDevice_accelerationStructureSizes(void *obj) {
+  struct unixcall_accel_sizes *params = obj;
+  const struct WMTAccelInfo *info = (const void *)(uintptr_t)params->info;
+  struct WMTAccelSizes *out = (void *)(uintptr_t)params->out;
+  if (!info || !out) return STATUS_INVALID_PARAMETER;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  @autoreleasepool {
+    MTLAccelerationStructureSizes s = [(id<MTLDevice>)params->device accelerationStructureSizesWithDescriptor:wmt_accel_descriptor(info)];
+    out->structure_size = s.accelerationStructureSize;
+    out->build_scratch_size = s.buildScratchBufferSize;
+    out->refit_scratch_size = s.refitScratchBufferSize;
+  }
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLDevice_newAccelerationStructure(void *obj) {
+  struct unixcall_new_accel *params = obj;
+  params->ret = 0;
+  params->ret_resource_id = 0;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  id<MTLAccelerationStructure> as = [(id<MTLDevice>)params->device newAccelerationStructureWithSize:(NSUInteger)params->size];
+  params->ret = (obj_handle_t)as;                       /* +1, released by the caller */
+  if (as) params->ret_resource_id = as.gpuResourceID._impl;
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLCommandBuffer_accelerationStructureCommandEncoder(void *obj) {
+  struct unixcall_generic_obj_obj_ret *params = obj;
+  params->ret = 0;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  params->ret = (obj_handle_t)[(id<MTLCommandBuffer>)params->handle accelerationStructureCommandEncoder];
+  return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+_MTLAccelerationStructureCommandEncoder_build(void *obj) {
+  struct unixcall_accel_build *params = obj;
+  const struct WMTAccelInfo *info = (const void *)(uintptr_t)params->info;
+  if (!info) return STATUS_INVALID_PARAMETER;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  @autoreleasepool {
+    id<MTLAccelerationStructureCommandEncoder> enc = (id<MTLAccelerationStructureCommandEncoder>)params->encoder;
+    /* what the build reads must be resident for it: the structures an instance structure refers to, and the vertex and index buffers */
+    const obj_handle_t *uses = (const void *)(uintptr_t)info->use_resources;
+    for (uint32_t i = 0; uses && i < info->use_count; i++) [enc useResource:(id<MTLResource>)uses[i] usage:MTLResourceUsageRead];
+    if (info->kind == WMT_ACCEL_KIND_PRIMITIVE) {
+      const struct WMTAccelTriangles *t = (const void *)(uintptr_t)info->geometries;
+      for (uint32_t i = 0; t && i < info->count; i++) {
+        if (t[i].vertex_buffer) [enc useResource:(id<MTLResource>)t[i].vertex_buffer usage:MTLResourceUsageRead];
+        if (t[i].index_buffer) [enc useResource:(id<MTLResource>)t[i].index_buffer usage:MTLResourceUsageRead];
+      }
+    } else if (info->instance_buffer) {
+      [enc useResource:(id<MTLResource>)info->instance_buffer usage:MTLResourceUsageRead];
+    }
+    [enc buildAccelerationStructure:(id<MTLAccelerationStructure>)params->structure
+                         descriptor:wmt_accel_descriptor(info)
+                      scratchBuffer:(id<MTLBuffer>)params->scratch
+                scratchBufferOffset:(NSUInteger)params->scratch_offset];
+  }
+  return STATUS_SUCCESS;
+}
