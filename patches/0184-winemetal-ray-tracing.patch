+/* Porthole (Cycles on Metal): ray tracing, slots 161-164. The acceleration structure descriptors cross as flat records, never as Metal objects.
+ * kind 0 = a primitive structure (triangles), kind 1 = an instance structure (a top level). usage is MTLAccelerationStructureUsage (1 refit, 2 prefer fast build, 4 extended limits). */
+#define WMT_ACCEL_KIND_PRIMITIVE 0u
+#define WMT_ACCEL_KIND_INSTANCE 1u
+struct WMTAccelTriangles {
+  obj_handle_t vertex_buffer;
+  uint64_t vertex_offset;
+  uint64_t vertex_stride;
+  obj_handle_t index_buffer;       /* 0 = the vertices are the triangles in order */
+  uint64_t index_offset;
+  uint32_t index_type;             /* 0 = 16 bit, 1 = 32 bit */
+  uint32_t triangle_count;
+  uint32_t flags;                  /* bit 0: opaque; bit 1: allow duplicate intersection function invocation */
+  uint32_t intersection_function_table_offset;
+};
+struct WMTAccelInfo {
+  uint32_t kind;
+  uint32_t usage;
+  uint32_t count;                  /* primitive: WMTAccelTriangles records; instance: instances */
+  uint32_t instance_descriptor_type;  /* instance: 0 = MTLAccelerationStructureInstanceDescriptor, 1 = the user id one */
+  uint64_t geometries;             /* primitive: PE pointer to WMTAccelTriangles[count] */
+  obj_handle_t instance_buffer;    /* instance: the buffer holding the instance descriptors */
+  uint64_t instance_buffer_offset;
+  uint64_t instanced_structures;   /* instance: PE pointer to obj_handle_t[instanced_count], the structures the instances refer to by index */
+  uint32_t instanced_count;
+  uint32_t use_count;
+  uint64_t use_resources;          /* PE pointer to obj_handle_t[use_count]: structures the build reads, marked resident for it */
+};
+struct WMTAccelSizes {
+  uint64_t structure_size;
+  uint64_t build_scratch_size;
+  uint64_t refit_scratch_size;
+};
