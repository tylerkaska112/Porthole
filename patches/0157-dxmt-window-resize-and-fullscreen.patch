@@ -59,11 +103,42 @@
 bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow,
                          DXMTWindowState *pState,
                          [[maybe_unused]] bool modeSwitch) {
+  RECT rect = {};
+  if (!hWindow || !pState || !screenRect(&rect))
+    return true;
+  pState->style = 0;
+  if (coversRect(hWindow, rect)) {
+    WARN("[wsi-0157] enterFullscreenMode: the window already covers the screen, left as it is");
+    return true;
+  }
+  ::GetWindowRect(hWindow, &pState->rect);
+  LONG style = ::GetWindowLongW(hWindow, GWL_STYLE);
+  LONG exstyle = ::GetWindowLongW(hWindow, GWL_EXSTYLE);
+  pState->style = style ? style : 1;           /* non-zero marks "we changed this window" */
+  pState->exstyle = exstyle;
+  ::SetWindowLongW(hWindow, GWL_STYLE, style & ~WS_OVERLAPPEDWINDOW);
+  ::SetWindowLongW(hWindow, GWL_EXSTYLE, exstyle & ~WS_EX_OVERLAPPEDWINDOW);
+  WARN("[wsi-0157] enterFullscreenMode: window ", pState->rect.right - pState->rect.left, "x",
+       pState->rect.bottom - pState->rect.top, " -> ", rect.right - rect.left, "x", rect.bottom - rect.top);
+  ::SetWindowPos(hWindow, HWND_TOP, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+                 SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_NOACTIVATE);
   return true;
 }
 
 bool leaveFullscreenMode(HWND hWindow, DXMTWindowState *pState,
                          bool restoreCoordinates) {
+  /* Only a window enterFullscreenMode changed is put back. */
+  if (!hWindow || !pState || pState->style == 0)
+    return true;
+  ::SetWindowLongW(hWindow, GWL_STYLE, pState->style == 1 ? ::GetWindowLongW(hWindow, GWL_STYLE) : pState->style);
+  ::SetWindowLongW(hWindow, GWL_EXSTYLE, pState->exstyle);
+  UINT flags = SWP_FRAMECHANGED | SWP_NOACTIVATE | SWP_NOZORDER;
+  const RECT rect = pState->rect;
+  if (!restoreCoordinates)
+    flags |= SWP_NOSIZE | SWP_NOMOVE;
+  WARN("[wsi-0157] leaveFullscreenMode: window back to ", rect.right - rect.left, "x", rect.bottom - rect.top);
+  ::SetWindowPos(hWindow, nullptr, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top, flags);
+  pState->style = 0;
   return true;
 }
 
