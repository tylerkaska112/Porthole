 void updateFullscreenWindow(HMONITOR hMonitor, HWND hWindow,
                             bool forceTopmost) {
+  RECT rect = {};
+  if (!hWindow || !screenRect(&rect) || coversRect(hWindow, rect))
+    return;
+  WARN("[wsi-0157] updateFullscreenWindow: window moved to cover the screen");
+  ::MoveWindow(hWindow, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top, TRUE);
 }
 
