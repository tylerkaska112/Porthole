+/* Porthole 0075: start a program of the game's own, next to Valve's signed-in client, instead of asking Valve's client to launch the game.
+ * Some games cannot be started the way Valve lists them (Rust: its listed program starts Easy Anti-Cheat, which does not run here; its own
+ * program, RustClient.exe, plays on servers that do not require it). Everything before this point is unchanged and still gates it: the
+ * authenticated session, the entitlement to the app and the check that the app's install folder is the one the app expects. The program must be
+ * a .exe inside that verified folder; anything else is refused. It runs with the Steam discovery values published (the caller did that), so its
+ * Steam library finds this client, and with SteamAppId / SteamGameId set to the app, the way Valve's client sets them for a game it starts.
+ * The client's callbacks are served until the program ends. MADEIRA_DOCK_PROGRAM = the program's Windows path; MADEIRA_DOCK_PROGRAM_ARGS =
+ * optional arguments. Unset = the normal LaunchApp route. Valve's licence and DRM checks are not skipped or replaced: this only chooses which of
+ * the game's own programs starts. */
+static int run_own_program(const wchar_t *program, const wchar_t *install_dir, uint32_t appid,
+                           const struct sh_api *api, const struct sh_observer *o, int32_t pipe)
+{
+    static wchar_t full[32768], command[32768], folder[32768], args[4096];
+    size_t install_len = wcslen(install_dir);
+    DWORD length = GetFullPathNameW(program, 32768, full, NULL);
+    if (!length || length >= 32768) { o->event("launch-program-refused", 1); return 50; }
+    size_t full_len = wcslen(full);
+    if (full_len <= install_len + 5 || _wcsnicmp(full, install_dir, install_len) != 0 ||
+        (full[install_len] != L'\\' && full[install_len] != L'/') || _wcsicmp(full + full_len - 4, L".exe") != 0) {
+        o->event("launch-program-refused", 2);   /* not inside the verified install folder, or not an .exe */
+        return 50;
+    }
+    DWORD attributes = GetFileAttributesW(full);
+    if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY)) { o->event("launch-program-refused", 3); return 50; }
+    wcscpy(folder, full);
+    for (size_t i = full_len; i > 0; --i) if (folder[i - 1] == L'\\' || folder[i - 1] == L'/') { folder[i - 1] = 0; break; }
+    args[0] = 0;
+    length = GetEnvironmentVariableW(L"MADEIRA_DOCK_PROGRAM_ARGS", args, 4096);
+    if (length >= 4096) args[0] = 0;
+    if (swprintf(command, 32768, L"\"%ls\"%ls%ls", full, args[0] ? L" " : L"", args) < 0) { o->event("launch-program-refused", 4); return 50; }
+    wchar_t id[16];
+    swprintf(id, 16, L"%u", (unsigned)appid);
+    SetEnvironmentVariableW(L"SteamAppId", id);
+    SetEnvironmentVariableW(L"SteamGameId", id);
+    STARTUPINFOW startup = {0};
+    startup.cb = sizeof(startup);
+    PROCESS_INFORMATION process = {0};
+    if (!CreateProcessW(full, command, NULL, NULL, FALSE, 0, NULL, folder, &startup, &process)) {
+        o->event("launch-program-start-failed", (int32_t)GetLastError());
+        return 51;
+    }
+    CloseHandle(process.hThread);
+    o->event("launch-program-started", 1);
+    o->event("launch-client-error", 0);   /* what the app waits for to say "Steam started the game" */
+    int result = 0;
+    for (;;) {
+        for (unsigned batch = 0; batch < 64; ++batch) {
+            struct sh_callback cb = {0};
+            if (!api->get_callback(pipe, &cb)) break;
+            api->free_callback(pipe);
+        }
+        DWORD wait = WaitForSingleObject(process.hProcess, 50);
+        if (wait == WAIT_OBJECT_0) break;
+        if (wait != WAIT_TIMEOUT) { result = 52; break; }
+        if (InterlockedCompareExchange(&interrupted, 0, 0)) { result = 52; break; }
+    }
+    CloseHandle(process.hProcess);
+    o->event("launch-game-ended", 1);
+    return result;
+}
