+/* Porthole 0014: which of the game's launch options to ask Valve's client for. The options are the numbered entries under the app's
+ * config/launch, and not every app starts at 0 (Factorio's are 1, 2, 3 and 5, so asking for option 0 fails with "entry for launch option 0 not found").
+ * The app that starts this host names the right one in MADEIRA_DOCK_LAUNCH_OPTION; unset, empty or not a plain number below 1000 means 0, as before. */
+static uint32_t launch_option_from_environment(void)
+{
+    wchar_t value[8] = {0};
+    DWORD length = GetEnvironmentVariableW(L"MADEIRA_DOCK_LAUNCH_OPTION", value, 8);
+    if (length == 0 || length >= 8) return 0;
+    uint32_t option = 0;
+    for (DWORD i = 0; i < length; i++) {
+        if (value[i] < L'0' || value[i] > L'9') return 0;
+        option = option * 10 + (uint32_t)(value[i] - L'0');
+    }
+    return option < 1000 ? option : 0;
+}
