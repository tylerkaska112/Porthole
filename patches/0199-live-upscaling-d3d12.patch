+/* Porthole 0199: upscaling that the in-game menu can change while the game runs. The app writes C:\ProgramData\Porthole\upscale.ctl (MADEIRA_UPSCALE_CTL) with the lines mode=0|1|2
+ * (0 off, 1 to the screen, 2 a fixed factor), factor=1.5 and fit=<screen width>x<screen height>; the Present looks at it twice a second at most. Without the file madeira.cfg's
+ * `metalfx-upscale` decides, once, as before. A status file next to it ("<file>.status") tells the menu what happened. */
+static SRWLOCK g_up_lock = SRWLOCK_INIT;
+static char g_up_path[300];
+static int g_up_init, g_up_have;       /* the variable was set / the file has been read */
+static int g_up_mode;                  /* 0 off, 1 to the screen, 2 fixed */
+static double g_up_factor = 2.0;
+static unsigned g_up_fw, g_up_fh;
+static FILETIME g_up_ft;
+static ULONGLONG g_up_next;
+static LONG g_up_version;
 
+/* Reads the control file when it changed; true when a control file exists at all. */
+static int mad_up_poll(int force) {
+    WIN32_FILE_ATTRIBUTE_DATA info; HANDLE f; char buf[1024]; DWORD got = 0; char *line, *save = NULL;
+    int ok;
+    AcquireSRWLockExclusive(&g_up_lock);
+    if (!g_up_init) {
+        DWORD n = GetEnvironmentVariableA("MADEIRA_UPSCALE_CTL", g_up_path, sizeof g_up_path);
+        if (n == 0 || n >= sizeof g_up_path) g_up_path[0] = 0;
+        g_up_init = 1; force = 1;
+    }
+    if (!g_up_path[0]) { ReleaseSRWLockExclusive(&g_up_lock); return 0; }
+    if (!force && GetTickCount64() < g_up_next) { ok = g_up_have; ReleaseSRWLockExclusive(&g_up_lock); return ok; }
+    g_up_next = GetTickCount64() + 500;
+    if (!GetFileAttributesExA(g_up_path, GetFileExInfoStandard, &info)) { ok = g_up_have; ReleaseSRWLockExclusive(&g_up_lock); return ok; }
+    if (g_up_have && !memcmp(&info.ftLastWriteTime, &g_up_ft, sizeof g_up_ft)) { ReleaseSRWLockExclusive(&g_up_lock); return 1; }
+    f = CreateFileA(g_up_path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) { ok = g_up_have; ReleaseSRWLockExclusive(&g_up_lock); return ok; }
+    ok = ReadFile(f, buf, sizeof buf - 1, &got, NULL);
+    CloseHandle(f);
+    if (!ok) { ok = g_up_have; ReleaseSRWLockExclusive(&g_up_lock); return ok; }
+    buf[got] = 0;
+    {
+        int m = g_up_mode; double fa = g_up_factor; unsigned fw = g_up_fw, fh = g_up_fh;
+        for (line = buf; line && *line; line = save) {
+            char *eq, *nl = line + strcspn(line, "\r\n");
+            save = *nl ? nl + 1 : NULL;
+            *nl = 0;
+            eq = strchr(line, '=');
+            if (!eq) continue;
+            *eq = 0;
+            if (!strcmp(line, "mode")) { m = atoi(eq + 1); if (m < 0) m = 0; if (m > 2) m = 2; }
+            else if (!strcmp(line, "factor")) { fa = strtod(eq + 1, NULL); if (fa < 1.0) fa = 1.0; if (fa > 2.0) fa = 2.0; }
+            else if (!strcmp(line, "fit")) { unsigned a = 0, b = 0; if (sscanf(eq + 1, "%ux%u", &a, &b) == 2 && a && b) { fw = a; fh = b; } }
+        }
+        if (!g_up_have || m != g_up_mode || fa != g_up_factor || fw != g_up_fw || fh != g_up_fh) InterlockedIncrement(&g_up_version);
+        g_up_mode = m; g_up_factor = fa; g_up_fw = fw; g_up_fh = fh;
+    }
+    g_up_ft = info.ftLastWriteTime;
+    g_up_have = 1;
+    ReleaseSRWLockExclusive(&g_up_lock);
+    return 1;
+}
+
+/* The wish as the text the scaler setup reads ("" = none, "fit:WxH", or a factor): the control file when there is one, else madeira.cfg. */
+static void mad_up_spec(char *v, size_t cap) {
+    v[0] = 0;
+    if (mad_up_poll(0)) {
+        AcquireSRWLockShared(&g_up_lock);
+        if (g_up_mode == 1 && g_up_fw && g_up_fh) snprintf(v, cap, "fit:%ux%u", g_up_fw, g_up_fh);
+        else if (g_up_mode == 2) snprintf(v, cap, "%.3f", g_up_factor);
+        ReleaseSRWLockShared(&g_up_lock);
+        return;
+    }
+    if (!mad_cfg_str_pe("metalfx-upscale", v, cap)) v[0] = 0;
+}
+
+static void mad_up_status(const char *text) {
+    char path[330]; HANDLE f; DWORD put;
+    if (!g_up_path[0]) return;
+    snprintf(path, sizeof path, "%s.status", g_up_path);
+    f = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    WriteFile(f, text, (DWORD)strlen(text), &put, NULL);
+    CloseHandle(f);
+}
