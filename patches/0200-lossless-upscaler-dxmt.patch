+// Porthole 0200: Lossless Scaling's own upscalers (LS1 and LS1 performance), run through the ordinary D3D11 interface.
+//
+// Like the frame generation next to it (d3d11_lsfg.hpp) this uses compiled compute shaders from the owner's own Lossless.dll, which the app writes to a file in the game's prefix
+// while the game runs (only when Steam says the account owns the program). Which shader is which, what each reads and writes and how many thread groups it takes was
+// worked out from the shaders themselves and from how Lossless.dll's own code runs them (reflection data, instruction streams and the program's calls), and checked by running the
+// chain on test pictures offline:
+//   LS1:   shaders 147+3k, 148+3k, 149+3k (k = 0..4, the sharpness level), then 146.
+//          pass 1  input (the game's picture)          -> A  (w x h,   R8G8B8A8_UNORM)
+//          pass 2  A                                   -> B  (w x h,   R8G8B8A8_UNORM)
+//          pass 3  B                                   -> C  (2w x 2h, R8_SNORM: the luminance the network predicts)
+//          pass 4  C and the input (shader 146)        -> output (any size >= the input, bilinear from C and from the input)
+//   LS1_P: shader 141+k writes C directly from the input, then 146 (one network pass instead of three).
+// 16x16 thread groups for all of them. One 48-byte constant buffer for every pass: { in_w, in_h, src_w, src_h, origin_x, origin_y, gamma, 0, out_w, out_h, 0, 0 } (the origin is
+// where the input starts in its texture, `gamma` = 1 treats the input as linear scRGB). One linear clamp sampler.
+#pragma once
+
+#include "d3d11_lsfg.hpp"
+
+namespace dxmt::lsfg {
+
+class Ls1Upscaler {
+public:
+  /// `nOut` pictures can be enlarged per call to run(): the game's own frame and the frames frame generation made.
+  Ls1Upscaler(ID3D11Device *dev, ID3D11DeviceContext4 *imm, UINT w, UINT h, DXGI_FORMAT format, UINT outW, UINT outH, bool performance, int level, size_t nOut)
+      : dev_(dev), imm_(imm), w_(w), h_(h), fmt_(format), ow_(outW), oh_(outH), perf_(performance), level_(std::clamp(level, 0, 4)), nOut_(std::max<size_t>(1, nOut)) {
+    ok_ = build();
+    if (!ok_) {
+      if (error_.empty()) error_ = "a picture, a sampler or a shader could not be created (" + stage_ + ")";
+      Logger::info("[ls-up] could not be set up: " + error_);
+    }
+  }
+  bool ok() const { return ok_; }
+  const std::string &error() const { return error_; }
+  UINT width() const { return w_; }
+  UINT height() const { return h_; }
+  UINT outWidth() const { return ow_; }
+  UINT outHeight() const { return oh_; }
+  size_t capacity() const { return nOut_; }
+  bool performance() const { return perf_; }
+  int level() const { return level_; }
+  DXGI_FORMAT outFormat() const { return outFmt_; }
+
+  /// Enlarges the game's frame (`backbuffer`) and then each of `extra` (generated frames, which are textures with a shader view). `out` gets one texture per picture, in that order.
+  /// Everything is recorded on a deferred context and replayed on the game's own.
+  bool run(ID3D11Resource *backbuffer, const std::vector<ID3D11Texture2D *> &extra, std::vector<ID3D11Texture2D *> &out) {
+    out.clear();
+    if (!ok_ || 1 + extra.size() > nOut_) return false;
+    ID3D11DeviceContext *c = def_.get();
+    prev_ = false;
+    c->CopyResource(in_.tex.get(), backbuffer);
+    setup(c);
+    pictures(c, in_.srv.get(), 0);
+    for (size_t i = 0; i < extra.size(); i++) {
+      ID3D11ShaderResourceView *v = srvFor(extra[i]);
+      if (!v) { clear(c); Ptr<ID3D11CommandList> drop; c->FinishCommandList(FALSE, drop.put()); return false; }
+      pictures(c, v, i + 1);
+    }
+    clear(c);
+    Ptr<ID3D11CommandList> cl;
+    if (FAILED(c->FinishCommandList(FALSE, cl.put()))) {
+      Logger::info("[ls-up] FinishCommandList failed");
+      ok_ = false;
+      error_ = "the engine could not finish the command list";
+      return false;
+    }
+    imm_->ExecuteCommandList(cl.get(), TRUE);
+    for (size_t i = 0; i < 1 + extra.size(); i++) out.push_back(out_[i].tex.get());
+    return true;
+  }
+
+private:
+  bool img(Img &i, UINT w, UINT h, DXGI_FORMAT f, UINT bind) {
+    w = std::max(1u, w); h = std::max(1u, h);
+    D3D11_TEXTURE2D_DESC d{};
+    d.Width = w; d.Height = h; d.MipLevels = 1; d.ArraySize = 1; d.Format = f; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_DEFAULT; d.BindFlags = bind;
+    if (FAILED(dev_->CreateTexture2D(&d, nullptr, i.tex.put()))) return false;
+    if (bind & D3D11_BIND_SHADER_RESOURCE)
+      if (FAILED(dev_->CreateShaderResourceView(i.tex.get(), nullptr, i.srv.put()))) return false;
+    if (bind & D3D11_BIND_UNORDERED_ACCESS)
+      if (FAILED(dev_->CreateUnorderedAccessView(i.tex.get(), nullptr, i.uav.put()))) return false;
+    i.w = w; i.h = h;
+    return true;
+  }
+
+  ID3D11ComputeShader *shader(uint32_t id) {
+    auto &cache = shaderCache()[dev_];
+    auto it = cache.find(id);
+    if (it != cache.end()) return it->second.get();
+    auto *blob = ShaderStore::get().find(id);
+    if (!blob) { error_ = std::format("shader {} is not in the shader file", id); return nullptr; }
+    Ptr<ID3D11ComputeShader> s;
+    if (FAILED(dev_->CreateComputeShader(blob->data(), blob->size(), nullptr, s.put()))) {
+      error_ = std::format("the engine refused shader {}", id);
+      return nullptr;
+    }
+    return (cache[id] = s).get();
+  }
+
+  bool build() {
+    auto t0 = std::chrono::steady_clock::now();
+    stage_ = "shader file";
+    if (!ShaderStore::get().load()) { error_ = ShaderStore::get().error_; return false; }
+    bool srgb = fmt_ == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || fmt_ == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+    if (fmt_ != DXGI_FORMAT_R8G8B8A8_UNORM && fmt_ != DXGI_FORMAT_B8G8R8A8_UNORM && fmt_ != DXGI_FORMAT_R10G10B10A2_UNORM && fmt_ != DXGI_FORMAT_R16G16B16A16_FLOAT && !srgb) {
+      error_ = std::format("the game's back buffer format ({}) is not supported", (int)fmt_);
+      return false;
+    }
+    // An sRGB back buffer is read through its sRGB view (linear light) and enlarged into 16-bit floats, which the presenter encodes again (as the frame generation does).
+    outFmt_ = srgb ? DXGI_FORMAT_R16G16B16A16_FLOAT : fmt_;
+    gamma_ = fmt_ == DXGI_FORMAT_R16G16B16A16_FLOAT ? 1u : 0u;
+    stage_ = "deferred context";
+    Ptr<ID3D11DeviceContext> d;
+    if (FAILED(dev_->CreateDeferredContext(0, d.put()))) return false;
+    def_ = d;
+    stage_ = "sampler";
+    D3D11_SAMPLER_DESC sd{};
+    sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    sd.MaxLOD = D3D11_FLOAT32_MAX;
+    sd.MaxAnisotropy = 1;
+    if (FAILED(dev_->CreateSamplerState(&sd, smp_.put()))) return false;
+    stage_ = "constant buffer";
+    uint32_t cb[12] = {w_, h_, w_, h_, 0, 0, gamma_, 0, ow_, oh_, 0, 0};
+    D3D11_BUFFER_DESC bd{};
+    bd.ByteWidth = sizeof cb; bd.Usage = D3D11_USAGE_IMMUTABLE; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    D3D11_SUBRESOURCE_DATA sdata{cb, 0, 0};
+    if (FAILED(dev_->CreateBuffer(&bd, &sdata, cb_.put()))) return false;
+    stage_ = "input picture";
+    if (!img(in_, w_, h_, fmt_, D3D11_BIND_SHADER_RESOURCE)) return false;
+    stage_ = "network pictures";
+    const UINT both = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+    if (!perf_) {
+      if (!img(a_, w_, h_, DXGI_FORMAT_R8G8B8A8_UNORM, both) || !img(b_, w_, h_, DXGI_FORMAT_R8G8B8A8_UNORM, both)) return false;
+    }
+    if (!img(c_, 2 * w_, 2 * h_, DXGI_FORMAT_R8_SNORM, both)) return false;
+    stage_ = std::format("output pictures (format {} as an unordered-access view)", (int)outFmt_);
+    out_.assign(nOut_, Img());
+    for (auto &o : out_) if (!img(o, ow_, oh_, outFmt_, both)) return false;
+    stage_ = "shaders";
+    ids_.clear();
+    if (perf_) ids_ = {141u + (uint32_t)level_};
+    else ids_ = {147u + 3u * (uint32_t)level_, 148u + 3u * (uint32_t)level_, 149u + 3u * (uint32_t)level_};
+    ids_.push_back(146);
+    for (uint32_t id : ids_) if (!shader(id)) return false;
+    Logger::info(std::format("[ls-up] ready in {:.0f} ms: {}x{} -> {}x{} format {} ({}, sharpness {}), up to {} pictures a frame", std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(),
+                             w_, h_, ow_, oh_, (int)fmt_, perf_ ? "LS1 performance" : "LS1", level_ + 1, nOut_));
+    return true;
+  }
+
+  ID3D11ShaderResourceView *srvFor(ID3D11Texture2D *t) {
+    for (auto &e : views_)
+      if (e.first.get() == t) return e.second.get();
+    if (views_.size() >= 8) views_.clear();   // frame generation was built again: the old pictures go
+    Ptr<ID3D11ShaderResourceView> v;
+    if (FAILED(dev_->CreateShaderResourceView(t, nullptr, v.put()))) return nullptr;
+    t->AddRef();
+    Ptr<ID3D11Texture2D> keep;
+    *keep.put() = t;   // holds the picture so that its address cannot be reused by another while the view is cached
+    views_.emplace_back(std::move(keep), std::move(v));
+    return views_.back().second.get();
+  }
+
+  void setup(ID3D11DeviceContext *c) {
+    ID3D11SamplerState *ss[1] = {smp_.get()};
+    ID3D11Buffer *cb = cb_.get();
+    c->CSSetSamplers(0, 1, ss);
+    c->CSSetConstantBuffers(0, 1, &cb);
+  }
+
+  void clear(ID3D11DeviceContext *c) {
+    ID3D11ShaderResourceView *s[2] = {};
+    ID3D11UnorderedAccessView *u[1] = {};
+    UINT counts[1] = {~0u};
+    c->CSSetShaderResources(0, 2, s);
+    c->CSSetUnorderedAccessViews(0, 1, u, counts);
+  }
+
+  void pass(ID3D11DeviceContext *c, uint32_t id, ID3D11ShaderResourceView *s0, ID3D11ShaderResourceView *s1, const Img &dst, UINT gx, UINT gy) {
+    ID3D11ShaderResourceView *s[2] = {s0, s1};
+    ID3D11UnorderedAccessView *u[1] = {dst.uav.get()};
+    UINT counts[1] = {~0u};
+    // the previous pass's views are cleared first: a texture cannot be read and written at once
+    if (prev_) {
+      ID3D11ShaderResourceView *n[2] = {};
+      ID3D11UnorderedAccessView *nu[1] = {};
+      c->CSSetShaderResources(0, 2, n);
+      c->CSSetUnorderedAccessViews(0, 1, nu, counts);
+    }
+    prev_ = true;
+    c->CSSetShader(shader(id), nullptr, 0);
+    c->CSSetShaderResources(0, s1 ? 2 : 1, s);
+    c->CSSetUnorderedAccessViews(0, 1, u, counts);
+    c->Dispatch(gx, gy, 1);
+  }
+
+  static UINT g16(UINT v) { return (v + 15) >> 4; }
+
+  void pictures(ID3D11DeviceContext *c, ID3D11ShaderResourceView *src, size_t outIndex) {
+    UINT gx = g16(w_), gy = g16(h_);
+    if (perf_) {
+      pass(c, ids_[0], src, nullptr, c_, gx, gy);
+    } else {
+      pass(c, ids_[0], src, nullptr, a_, gx, gy);
+      pass(c, ids_[1], a_.srv.get(), nullptr, b_, gx, gy);
+      pass(c, ids_[2], b_.srv.get(), nullptr, c_, gx, gy);
+    }
+    pass(c, 146, c_.srv.get(), src, out_[outIndex], g16(ow_), g16(oh_));
+  }
+
+  ID3D11Device *dev_;
+  ID3D11DeviceContext4 *imm_;
+  UINT w_, h_;
+  DXGI_FORMAT fmt_, outFmt_ = DXGI_FORMAT_UNKNOWN;
+  UINT ow_, oh_;
+  bool perf_;
+  int level_;
+  size_t nOut_;
+  uint32_t gamma_ = 0;
+  bool ok_ = false, prev_ = false;
+  std::string error_, stage_;
+  Ptr<ID3D11DeviceContext> def_;
+  Ptr<ID3D11SamplerState> smp_;
+  Ptr<ID3D11Buffer> cb_;
+  Img in_, a_, b_, c_;
+  Imgs out_;
+  std::vector<uint32_t> ids_;
+  std::vector<std::pair<Ptr<ID3D11Texture2D>, Ptr<ID3D11ShaderResourceView>>> views_;
+};
+
+} // namespace dxmt::lsfg
