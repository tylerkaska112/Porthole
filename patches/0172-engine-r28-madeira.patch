+    mach_msg_type_number_t cnt = ARM_THREAD_STATE64_COUNT;
+    uint64_t bb = 0, pc;
+    static const int map[16] = { 8, 0, 1, 27, 23, -1, 25, 26, 2, 3, 4, 5, 19, 20, 21, 22 };
