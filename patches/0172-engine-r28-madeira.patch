+    if (offset == GWL_STYLE || offset == GWL_EXSTYLE) ios_wlog( offset == GWL_STYLE ? "SetStyle" : "SetExStyle", hwnd, (int)newval, 0, 0, 0, 0 );
+    return set_window_long( hwnd, offset, sizeof(LONG_PTR), newval, ansi );
