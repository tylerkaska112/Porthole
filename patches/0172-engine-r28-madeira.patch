+int get_window_pixel_format( HWND hwnd )
+{
+    WND *win = get_win_ptr( hwnd );
+    int ret;
+
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS)
+    {
+        WARN( "getting format on win %p not supported\n", hwnd );
+        return -1;
+    }
+
+    ret = win->pixel_format;
+    release_win_ptr( win );
+
+    return ret;
+}
