+WORD WINAPI NtUserSetWindowWord( HWND hwnd, INT offset, WORD newval )
+{
+    if (offset < 0 && offset != GWLP_USERDATA)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_INDEX );
+        return 0;
