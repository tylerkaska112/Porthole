+/* Porthole 0196: "upscale to the screen". DXMT_METALFX_FIT = "<width>x<height>" (the screen's pixels, set by the app) picks the MetalFX factor itself: the picture the
+ * game draws is enlarged to fit the screen, aspect kept, at most 2x (what the spatial scaler is good at). Returns 0 when the game already draws about as large as the
+ * screen (a factor under 1.1 buys nothing) or nothing is asked for. */
+static float MetalFXFitFactor(UINT width, UINT height) {
+  auto fit = env::getEnvVar("DXMT_METALFX_FIT");
+  unsigned sw = 0, sh = 0;
+  if (fit.empty() || sscanf(fit.c_str(), "%ux%u", &sw, &sh) != 2 || !sw || !sh || !width || !height)
+    return 0;
+  float f = std::min((float)sw / (float)width, (float)sh / (float)height);
+  if (f > 2.0f) f = 2.0f;
+  return f >= 1.1f ? f : 0;
+}
