+static NTSTATUS
+_MTLIntersectionFunctionTable_setFunction(void *obj) {
+  struct unixcall_ift_set_function *params = obj;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  [(id<MTLIntersectionFunctionTable>)params->table setFunction:(id<MTLFunctionHandle>)params->function_handle atIndex:(NSUInteger)params->index];
+  return STATUS_SUCCESS;
