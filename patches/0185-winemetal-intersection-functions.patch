+/* Porthole (Cycles on Metal), slots 165-169: compute pipelines with linked functions and intersection function tables. Local rendering only. */
+static NTSTATUS
+_MTLDevice_newComputePipelineStateEx(void *obj) {
+  struct unixcall_newpsoex *params = obj;
+  const struct WMTComputePipelineInfoEx *info = (const void *)(uintptr_t)params->info;
+  params->ret = 0;
+  params->ret_error = 0;
+  if (!info || !info->compute_function) return STATUS_INVALID_PARAMETER;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  @autoreleasepool {
+    MTLComputePipelineDescriptor *desc = [[MTLComputePipelineDescriptor alloc] init];
+    desc.computeFunction = (id<MTLFunction>)info->compute_function;
+    for (uint32_t i = 0; i < 31; i++)
+      if (info->immutable_buffers & (1u << i)) desc.buffers[i].mutability = MTLMutabilityImmutable;
+    if (info->max_total_threads_per_threadgroup) desc.maxTotalThreadsPerThreadgroup = info->max_total_threads_per_threadgroup;
+    desc.threadGroupSizeIsMultipleOfThreadExecutionWidth = (info->flags & 1u) != 0;
+    const obj_handle_t *linked = (const void *)(uintptr_t)info->linked_functions;
+    if (linked && info->linked_count) {
+      NSMutableArray *functions = [NSMutableArray arrayWithCapacity:info->linked_count];
+      for (uint32_t i = 0; i < info->linked_count; i++) [functions addObject:(id<MTLFunction>)linked[i]];
+      MTLLinkedFunctions *lf = [[MTLLinkedFunctions alloc] init];
+      lf.functions = functions;
+      desc.linkedFunctions = lf;
+      [lf release];
+    }
+    if (info->max_call_stack_depth) desc.maxCallStackDepth = info->max_call_stack_depth;
+    NSError *err = nil;
+    id<MTLComputePipelineState> pso = [(id<MTLDevice>)params->device newComputePipelineStateWithDescriptor:desc options:MTLPipelineOptionNone reflection:nil error:&err];
+    params->ret = (obj_handle_t)pso;                      /* +1, released by the caller */
+    if (err) params->ret_error = (obj_handle_t)[err retain];
+    [desc release];
+  }
+  return STATUS_SUCCESS;
+}
