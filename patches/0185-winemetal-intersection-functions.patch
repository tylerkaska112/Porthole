+static NTSTATUS
+_MTLComputePipelineState_newIntersectionFunctionTable(void *obj) {
+  struct unixcall_new_ift *params = obj;
+  params->ret = 0;
+  params->ret_resource_id = 0;
+  if (wmtr_enabled()) return STATUS_NOT_IMPLEMENTED;
+  @autoreleasepool {
+    MTLIntersectionFunctionTableDescriptor *desc = [[MTLIntersectionFunctionTableDescriptor alloc] init];
+    desc.functionCount = (NSUInteger)params->function_count;
+    id<MTLIntersectionFunctionTable> table = [(id<MTLComputePipelineState>)params->pipeline newIntersectionFunctionTableWithDescriptor:desc];
+    params->ret = (obj_handle_t)table;                    /* +1, released by the caller */
+    if (table) params->ret_resource_id = table.gpuResourceID._impl;
+    [desc release];
+  }
+  return STATUS_SUCCESS;
+}
