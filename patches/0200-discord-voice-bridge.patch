+/* Sums the voice into `out` (after the game's mix) and reads the microphone. Real-time thread. */
+static void ios_pv_render(AudioUnitRenderActionFlags *flags, const AudioTimeStamp *ts, float *out, UInt32 nframes, UInt32 ch)
+{
+    uint64_t r, w, avail, n, i;
+    UInt32 c;
+
+    r = atomic_load_explicit(&g_pv_play_r, memory_order_relaxed);
+    w = atomic_load_explicit(&g_pv_play_w, memory_order_acquire);
+    avail = w - r;
+    n = avail < nframes ? avail : nframes;
+    for (i = 0; i < n; i++) {
+        float v = g_pv_play[(r + i) & (PV_RING - 1)];
+        for (c = 0; c < ch; c++) out[i * ch + c] += v;
+    }
+    atomic_store_explicit(&g_pv_play_r, r + n, memory_order_release);
+    if (n < nframes) atomic_fetch_add_explicit(&g_pv_play_short, nframes - n, memory_order_relaxed);
+
+    if (g_pv_mic_on && g_dev.au && nframes <= 4096) {
+        AudioBufferList abl;
+        AudioUnitRenderActionFlags f = 0;
+        OSStatus err;
+        (void)flags;
+        abl.mNumberBuffers = 1;
+        abl.mBuffers[0].mNumberChannels = 1;
+        abl.mBuffers[0].mDataByteSize = nframes * sizeof(float);
+        abl.mBuffers[0].mData = g_pv_scratch;
+        err = AudioUnitRender(g_dev.au, &f, ts, 1, nframes, &abl);
+        if (err) {
+            atomic_fetch_add_explicit(&g_pv_render_errs, 1, memory_order_relaxed);
+        } else {
+            uint64_t cw = atomic_load_explicit(&g_pv_cap_w, memory_order_relaxed);
+            uint64_t cr = atomic_load_explicit(&g_pv_cap_r, memory_order_acquire);
+            uint64_t room = PV_RING - (cw - cr);
+            uint64_t m = room < nframes ? room : nframes;
+            for (i = 0; i < m; i++) g_pv_cap[(cw + i) & (PV_RING - 1)] = g_pv_scratch[i];
+            if (m < nframes) atomic_fetch_add_explicit(&g_pv_cap_drops, nframes - m, memory_order_relaxed);
+            atomic_store_explicit(&g_pv_cap_w, cw + m, memory_order_release);
+        }
+    }
+}
 
