+/* Porthole voice bridge: see g_pv_*. Called by the app (Discord voice). With `want_mic` the microphone is read on the endpoint's own unit; the app's AVAudioSession must
+ * already be a record-capable category and the permission granted. Creates the endpoint when no game has (48 kHz stereo) and starts it. Returns
+ * bit0: the endpoint runs, bit1: the microphone is on. The endpoint rate is porthole_voice_rate(). */
+int porthole_voice_start(int want_mic)
+{
+    int flags = 0;
+    OSStatus err;
+
+    pthread_mutex_lock(&g_dev_lock);
+    g_pv_mic_wanted = want_mic ? 1 : 0;
+    g_pv_hold = 1;
+    if (!g_dev.au) {
+        struct ios_stream fmt;
+        memset(&fmt, 0, sizeof(fmt));
+        fmt.sample_rate = IOS_AUDIO_SAMPLE_RATE;
+        fmt.channels = IOS_AUDIO_CHANNELS;
+        int failed_before = g_dev.failed;
+        if (ios_dev_create_locked(&fmt) && !failed_before) g_dev.failed = 0;
+    } else if (want_mic != g_pv_mic_on) {
+        /* the unit exists (a game plays): input is switched on or off with the unit stopped and uninitialised */
+        int was_running = g_dev.running;
+        if (was_running) { AudioOutputUnitStop(g_dev.au); g_dev.running = 0; }
+        AudioUnitUninitialize(g_dev.au);
+        g_pv_mic_on = want_mic ? ios_pv_setup_input(g_dev.au, g_dev.rate, 1) : (ios_pv_setup_input(g_dev.au, g_dev.rate, 0), 0);
+        if ((err = AudioUnitInitialize(g_dev.au))) fprintf(stderr, "[ios_audio] pv AudioUnitInitialize after input change: %d\n", (int)err);
+        if (was_running) {
+            if (!(err = AudioOutputUnitStart(g_dev.au))) g_dev.running = 1;
+            else fprintf(stderr, "[ios_audio] pv restart after input change: %d\n", (int)err);
+        }
+    }
+    atomic_store_explicit(&g_pv_play_r, atomic_load_explicit(&g_pv_play_w, memory_order_acquire), memory_order_release);
+    atomic_store_explicit(&g_pv_cap_r, atomic_load_explicit(&g_pv_cap_w, memory_order_acquire), memory_order_release);
+    if (g_dev.au && !g_dev.running && !g_bg_halt && !atomic_load_explicit(&g_dev_suspended, memory_order_acquire)) {
+        if (!(err = AudioOutputUnitStart(g_dev.au))) g_dev.running = 1;
+        else fprintf(stderr, "[ios_audio] pv AudioOutputUnitStart: %d\n", (int)err);
+    }
+    if (g_dev.au) atomic_store_explicit(&g_pv_active, 1, memory_order_release);
+    if (g_dev.au && g_dev.running) flags |= 1;
+    if (g_pv_mic_on) flags |= 2;
+    fprintf(stderr, "[ios_audio] pv start: mic wanted=%d on=%d, endpoint %s (%u Hz, %u ch)\n", want_mic, g_pv_mic_on,
+            (flags & 1) ? "running" : "not running", g_dev.rate, g_dev.channels);
+    pthread_mutex_unlock(&g_dev_lock);
+    return flags;
+}
+
+void porthole_voice_stop(void)
+{
+    int any = 0, i;
+
+    pthread_mutex_lock(&g_dev_lock);
+    atomic_store_explicit(&g_pv_active, 0, memory_order_release);
+    g_pv_hold = 0;
+    g_pv_mic_wanted = 0;
+    if (g_dev.au && g_pv_mic_on) {   /* the microphone indicator goes out with the input */
+        int was_running = g_dev.running;
+        OSStatus err;
+        if (was_running) { AudioOutputUnitStop(g_dev.au); g_dev.running = 0; }
+        AudioUnitUninitialize(g_dev.au);
+        ios_pv_setup_input(g_dev.au, g_dev.rate, 0);
+        g_pv_mic_on = 0;
+        if ((err = AudioUnitInitialize(g_dev.au))) fprintf(stderr, "[ios_audio] pv AudioUnitInitialize after stop: %d\n", (int)err);
+        if (was_running && !(err = AudioOutputUnitStart(g_dev.au))) g_dev.running = 1;
+    }
+    for (i = 0; i < IOS_MAX_STREAMS; i++) {
+        struct ios_stream *m = atomic_load_explicit(&g_mix[i], memory_order_relaxed);
+        if (m && m->started) { any = 1; break; }
+    }
+    if (!any && !g_bg_keepalive && g_dev.au && g_dev.running) { AudioOutputUnitStop(g_dev.au); g_dev.running = 0; }
+    fprintf(stderr, "[ios_audio] pv stop: capture dropped %llu frames, playback short %llu frames, capture render errors %llu\n",
+            (unsigned long long)atomic_load_explicit(&g_pv_cap_drops, memory_order_relaxed),
+            (unsigned long long)atomic_load_explicit(&g_pv_play_short, memory_order_relaxed),
+            (unsigned long long)atomic_load_explicit(&g_pv_render_errs, memory_order_relaxed));
+    pthread_mutex_unlock(&g_dev_lock);
+}
+
+unsigned porthole_voice_rate(void) { return g_dev.rate ? g_dev.rate : IOS_AUDIO_SAMPLE_RATE; }
+int porthole_voice_mic_on(void) { return g_pv_mic_on; }
+
+/* App -> speaker: mono float samples at porthole_voice_rate(). Returns how many were taken. */
+size_t porthole_voice_write(const float *src, size_t frames)
+{
+    uint64_t w = atomic_load_explicit(&g_pv_play_w, memory_order_relaxed);
+    uint64_t r = atomic_load_explicit(&g_pv_play_r, memory_order_acquire);
+    uint64_t room = PV_RING - (w - r);
+    size_t n = frames < room ? frames : (size_t)room, i;
+    for (i = 0; i < n; i++) g_pv_play[(w + i) & (PV_RING - 1)] = src[i];
+    atomic_store_explicit(&g_pv_play_w, w + n, memory_order_release);
+    return n;
+}
+
+/* Frames written and not yet played. */
+size_t porthole_voice_playback_fill(void)
+{
+    return (size_t)(atomic_load_explicit(&g_pv_play_w, memory_order_acquire) - atomic_load_explicit(&g_pv_play_r, memory_order_acquire));
+}
+
+/* Microphone -> app: mono float samples at porthole_voice_rate(). Returns how many were copied. */
+size_t porthole_voice_read(float *dst, size_t max_frames)
+{
+    uint64_t r = atomic_load_explicit(&g_pv_cap_r, memory_order_relaxed);
+    uint64_t w = atomic_load_explicit(&g_pv_cap_w, memory_order_acquire);
+    uint64_t avail = w - r;
+    size_t n = avail < max_frames ? (size_t)avail : max_frames, i;
+    for (i = 0; i < n; i++) dst[i] = g_pv_cap[(r + i) & (PV_RING - 1)];
+    atomic_store_explicit(&g_pv_cap_r, r + n, memory_order_release);
+    return n;
+}
+
+void porthole_voice_stats(uint64_t *cap_drops, uint64_t *play_short, uint64_t *render_errs)
+{
+    if (cap_drops) *cap_drops = atomic_load_explicit(&g_pv_cap_drops, memory_order_relaxed);
+    if (play_short) *play_short = atomic_load_explicit(&g_pv_play_short, memory_order_relaxed);
+    if (render_errs) *render_errs = atomic_load_explicit(&g_pv_render_errs, memory_order_relaxed);
+}
+
 /* Is the endpoint really rendering? An interruption, or a category change
  * while it ran, can stop the RemoteIO unit without telling us, and then iOS
  * would suspend Madeira (and the game would be silent). Called by the app
