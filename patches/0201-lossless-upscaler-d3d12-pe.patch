+/* Porthole 0201: before the game's picture is presented. When Lossless Scaling's upscaler is chosen and works, the picture is copied to the bridge, enlarged there by the passes, and
+ * `uf` describes the enlarged picture (returns 1); otherwise returns 0 and the MetalFX scaler (or the plain copy) does it. The first frames wait for the passes on the CPU for a moment
+ * (the shaders are compiled then); later the present's own command buffer waits for them on the GPU. */
+static int mad_up_before(struct mad_swapchain *s, struct mad_resource *src, struct upscale_bridge_frame *uf) {
+    struct mad_device *dv;
+    obj_handle_t cb, enc;
+    int ok;
+    if (g_up_method < 1 || !s->fx_w || !s->fx_h || g_up_ls_state < 0 || g_ups.state < 0) return 0;
+    if (!src || !src->texture) return 0;
+    if (g_ups.state == 0) {
+        HMODULE m = LoadLibraryA("d3d11.dll");
+        if (m) {
+            g_ups.begin = (int (*)(struct upscale_bridge_frame *))(void *)GetProcAddress(m, "DXMTUpscaleBegin");
+            g_ups.run = (int (*)(struct upscale_bridge_frame *))(void *)GetProcAddress(m, "DXMTUpscaleRun");
+            g_ups.abort_ = (void (*)(struct upscale_bridge_frame *))(void *)GetProcAddress(m, "DXMTUpscaleAbort");
+            g_ups.failed = (int (*)(char *, UINT))(void *)GetProcAddress(m, "DXMTUpscaleFailed");
+        }
+        if (!g_ups.begin || !g_ups.run || !g_ups.abort_ || !g_ups.failed) {
+            d3d12_log("[ls-up] Direct3D 12: Lossless Scaling's upscaler is not available: d3d11.dll has no bridge (%s); MetalFX is used\n", m ? "functions missing" : "d3d11.dll did not load");
+            g_ups.state = -1;
+            g_up_ls_state = -1;
+            snprintf(g_up_ls_msg, sizeof g_up_ls_msg, "this build has no Direct3D 12 bridge for it");
+            mad_up_write_status();
+            return 0;
+        }
+        g_ups.state = 1;
+        d3d12_log("[ls-up] Direct3D 12: bridge found in d3d11.dll\n");
+    }
+    dv = s->queue->device;
+    if (!dv->mtl_queue) return 0;
+    memset(uf, 0, sizeof *uf);
+    uf->size = sizeof *uf; uf->width = src->width; uf->height = src->height; uf->dxgi_format = (UINT)s->desc.Format;
+    uf->out_width = s->fx_w; uf->out_height = s->fx_h; uf->method = (UINT)g_up_method; uf->level = (UINT)g_up_level;
+    uf->flags = g_ups.warm < 8 ? 1u : 0u;
+    ok = g_ups.begin(uf);
+    if (!ok) {
+        char why[200] = "";
+        if (g_ups.failed(why, sizeof why)) {
+            d3d12_log("[ls-up] Direct3D 12: Lossless Scaling's upscaler cannot be used (%s); MetalFX is used\n", why);
+            g_up_ls_state = -1;
+            snprintf(g_up_ls_msg, sizeof g_up_ls_msg, "%s", why[0] ? why : "it could not start");
+            mad_up_write_status();
+        }
+        return 0;
+    }
+    cb = MTLCommandQueue_commandBuffer(dv->mtl_queue);
+    enc = cb ? MTLCommandBuffer_blitCommandEncoder(cb) : 0;
+    if (!enc) { g_ups.abort_(uf); return 0; }
+    g_enc_seq++;
+    if (g_f6_used && dv->enc_fence) { obj_handle_t df = dv->enc_fence; f6_encode(enc, F6_BLIT, &df, 1, 0); }
+    mad_blit_texture(enc, src->texture, (obj_handle_t)uf->input_texture, src->width, src->height);
+    MTLCommandEncoder_endEncoding(enc);
+    MTLCommandBuffer_encodeSignalEvent(cb, (obj_handle_t)uf->input_event, uf->input_value);
+    MTLCommandBuffer_commit(cb);
+    if (!g_ups.run(uf)) return 0;
+    if (g_ups.warm < 8) {
+        if (!MTLSharedEvent_waitUntilSignaledValue((obj_handle_t)uf->out_event, uf->out_value, 40)) {
+            static LONG said;
+            if (InterlockedIncrement(&said) <= 3) d3d12_log("[ls-up] Direct3D 12: the passes were not done after 40 ms; this frame is enlarged by MetalFX\n");
+            MTLSharedEvent_signalValue((obj_handle_t)uf->done_event, uf->done_value);
+            return 0;
+        }
+        g_ups.warm++;
+    }
+    if (g_up_ls_state == 0) {
+        g_up_ls_state = 1;
+        d3d12_log("[ls-up] Direct3D 12: Lossless Scaling's upscaler is working (%ux%u -> %ux%u, %s, sharpness %d)\n", (unsigned)src->width, (unsigned)src->height, (unsigned)s->fx_w, (unsigned)s->fx_h,
+                  g_up_method == 2 ? "LS1 performance" : "LS1", g_up_level + 1);
+        mad_up_write_status();
+    }
+    return 1;
+}
